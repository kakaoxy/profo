# 环境变量配置示例
# 复制此文件为 .env.local 并填入实际值

# ==================== API 配置 ====================
# 浏览器可访问的后端地址（仅开发环境需要，跨端口访问）
# 生产环境通过 Nginx 代理，不需要此变量
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# 服务端内部 API 地址
# 生产环境直连后端内网端口，无需经过 Nginx/SSL
# 开发环境默认使用 NEXT_PUBLIC_API_URL
# SERVER_API_URL=http://127.0.0.1:8000

# 生产域名（可选，构建时注入 next.config.ts）
# Next.js 自动允许同源 Host，只要 nginx 反代正确传递 Host 头
# （proxy_set_header Host $host），Server Actions 自动工作，此变量非必需。
# 仅当 nginx 不传递 Host（如 CDN/二级反代）时才需配置。
# Docker 部署通过 build arg 传入：
#   deploy-local.sh 前: export PRODUCTION_DOMAIN=你的域名
#   或 docker-compose build args: PRODUCTION_DOMAIN=${PRODUCTION_DOMAIN:-}
# PRODUCTION_DOMAIN=profo.example.com

# ==================== E2E 测试 ====================
# Playwright E2E 用例登录凭据（严禁硬编码到测试文件）
E2E_ADMIN_USER=admin
E2E_ADMIN_PASSWORD=your-password-here
# 可选：自定义服务地址（默认 http://127.0.0.1:8000 / :3000）
# E2E_API_BASE=http://127.0.0.1:8000
# E2E_FRONT_BASE=http://127.0.0.1:3000
# 可选：造数用小区 UUID（默认自动取库中第一个小区）
# E2E_COMMUNITY_ID=
