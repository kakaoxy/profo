# JWT配置（⚠️ 安全警告）
# 生产环境必须设置强密钥，建议：
# - 长度至少32个字符
# - 包含大小写字母、数字和特殊字符
# - 使用随机生成的密钥，避免使用常见短语
# 开发环境可以使用较短的密钥，但生产环境必须满足上述要求
# 示例：JWT_SECRET_KEY=Profo-Dev-Key-2024!@#$%^&*()_+-=[]{}|;:,.<>?
JWT_SECRET_KEY=Profo-Dev-Key-2024!@#$%^&*()_+-=[]{}|;:,.<>?
jwt_secret_key=Profo-Dev-Key-2024!@#$%^&*()_+-=[]{}|;:,.<>?

# JWT密钥轮换配置（可选）
# 用于平滑轮换JWT密钥，设置后系统会同时接受新旧密钥
# JWT_SECRET_KEY_OLD=your-old-secret-key-here
# JWT_KEY_ROTATION_ENABLED=false

# 数据库配置
# 本地开发：先启动 db 容器 (docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db)
# 再用 127.0.0.1:5432 直连；Docker compose 运行时由 docker-compose.yml 覆盖为 db:5432
DATABASE_URL=postgresql+psycopg://profo:ProfoPgDev2026pass@127.0.0.1:5432/profo

# Redis 配置（限流与缓存后端，多 worker 部署必需）
# 本地开发：先启动 redis 容器 (docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d redis)
REDIS_URL=redis://127.0.0.1:6379/0

# 存储后端配置（local=本地文件系统，oss=阿里云OSS）
# 当 STORAGE_BACKEND=oss 时需配置 OSS_ACCESS_KEY_ID/OSS_ACCESS_KEY_SECRET/OSS_BUCKET_NAME/OSS_ENDPOINT/OSS_PUBLIC_BASE_URL
STORAGE_BACKEND=local

# 微信配置
WECHAT_APPID=your-wechat-appid
WECHAT_SECRET=your-wechat-secret

# API配置
API_PREFIX=/api
# CORS 配置（仅开发环境需要，生产环境同服务器部署可设为空 []）
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# 可信代理 IP/CIDR 列表（用于限流 key 解析真实客户端 IP）
# 仅这些来源的 X-Forwarded-For 头会被采信，防止伪造 XFF 绕过限流
# 开发环境默认 127.0.0.1/::1 即可
# Docker bridge 网络部署时，nginx/容器经网关访问 backend，需补充网段，例如：
#   TRUSTED_PROXIES=["127.0.0.1","::1","172.16.0.0/12"]
# 否则所有请求会共享代理 IP 对应的限流桶
# 注意：list 类型环境变量需用 JSON 数组格式（与 CORS_ORIGINS 一致）
# TRUSTED_PROXIES=["127.0.0.1","::1"]


# 文件上传配置
MAX_UPLOAD_SIZE=524288000
ALLOWED_EXTENSIONS=[".csv", ".xls", ".xlsx", ".pdf", ".png", ".jpg", ".jpeg", ".webp", ".doc", ".docx", ".md", ".mp4", ".mov", ".webm"]

# 分页配置
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=1000

# JWT过期时间
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 调试模式
DEBUG=false