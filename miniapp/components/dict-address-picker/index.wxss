/* 楼盘字典四级地址选择器（C 端）：样式自包含，令牌来自 app.wxss 的 CSS 变量 */
.dict-picker {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ===== 摘要行 ===== */
.dp-summary {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--ink);
  min-height: 40rpx;
}

.dp-summary__crumb {
  font-weight: 500;
}

.dp-summary__sep {
  color: var(--dove);
}

.dp-summary__hint {
  color: var(--dove);
}

.dp-summary__badge {
  margin-left: 8rpx;
  padding: 2rpx 14rpx;
  border-radius: 9999rpx;
  border: 2rpx dashed var(--rust);
  color: var(--rust);
  font-size: 20rpx;
  line-height: 1.6;
}

/* ===== 小区搜索 ===== */
.dp-field {
  position: relative;
}

.dp-search {
  position: relative;
}

.dp-search__input {
  width: 100%;
  height: 104rpx;
  padding: 0 88rpx 0 32rpx;
  border: 2rpx solid var(--dove);
  border-radius: 32rpx;
  background: var(--pure-white);
  font-size: 30rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.dp-search__ph {
  color: var(--dove);
}

.dp-search__clear {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--fog);
  color: var(--graphite);
  font-size: 32rpx;
}

.dp-dropdown {
  position: absolute;
  left: 0;
  right: 0;
  top: 112rpx;
  z-index: 30;
  background: var(--pure-white);
  border-radius: 32rpx;
  box-shadow: var(--shadow-sm);
  max-height: 480rpx;
  overflow-y: auto;
}

.dp-dropdown__list {
  padding: 8rpx;
}

.dp-dropdown__item {
  padding: 24rpx;
  border-radius: 24rpx;
}

.dp-dropdown__item:active {
  background: var(--fog);
}

.dp-dropdown__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.dp-dropdown__meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--graphite);
}

.dp-dropdown__state {
  padding: 40rpx;
  text-align: center;
  color: var(--graphite);
  font-size: 26rpx;
}

.dp-dropdown__use {
  margin: 8rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--apricot-wash);
  color: var(--rust);
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
  line-height: 1.5;
}

/* ===== 三栏级联 ===== */
.dp-cascade {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dp-col {
  display: flex;
  flex-direction: column;
  border: 2rpx solid var(--dove);
  border-radius: 28rpx;
  background: var(--pure-white);
  overflow: hidden;
}

.dp-col__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  border-bottom: 2rpx solid var(--fog);
}

.dp-col__title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}

.dp-col__opt {
  margin-left: 8rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--dove);
}

.dp-col__count {
  font-size: 20rpx;
  color: var(--dove);
}

.dp-col__search {
  margin: 12rpx 16rpx;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: var(--fog);
  font-size: 24rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.dp-col__body {
  max-height: 300rpx;
  padding: 12rpx 16rpx;
  box-sizing: border-box;
}

.dp-col__state {
  padding: 24rpx 8rpx;
  font-size: 24rpx;
  color: var(--dove);
  text-align: center;
}

.dp-col__foot {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx 20rpx;
}

.dp-col__new {
  flex: 1;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  border: 2rpx dashed var(--dove);
  font-size: 24rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.dp-col__add {
  flex-shrink: 0;
  height: 64rpx;
  line-height: 60rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--ink);
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 500;
}

.dp-col__add:active {
  background: var(--fog);
}

/* 列表项（楼栋/楼层） */
.dp-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink);
}

.dp-item:active {
  background: var(--fog);
}

.dp-item--on {
  background: var(--ink);
  color: var(--pure-white);
}

.dp-item--lock {
  color: var(--dove);
  border: 2rpx dashed var(--dove);
}

.dp-item__tag {
  font-size: 20rpx;
  color: var(--rust);
}

.dp-item__count {
  font-size: 20rpx;
  color: var(--dove);
}

/* 户室网格 */
.dp-room-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.dp-room {
  min-width: 96rpx;
  padding: 14rpx 12rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--dove);
  text-align: center;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--ink);
  box-sizing: border-box;
}

.dp-room--lock {
  border-style: dashed;
  color: var(--dove);
}

.dp-room--on {
  background: var(--ink);
  border-color: var(--ink);
  color: var(--pure-white);
}

/* 审核提示 */
.dp-tip {
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  background: var(--apricot-wash);
  color: var(--rust);
  font-size: 24rpx;
  line-height: 1.5;
}
