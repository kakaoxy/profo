/* 购房模拟器 · 数据展示（账单行 / KPI / 成交卡） */
/* ===== 账单行 ===== */
.card-rows {
  padding: 20rpx 36rpx;
}
.brow {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #eeeff1;
  font-size: 27rpx;
}
.brow:last-child {
  border-bottom: 0;
}
.brow .k {
  color: var(--ash);
  flex: 1;
}
.brow .v {
  font-weight: 500;
  color: var(--ink);
  white-space: nowrap;
}
.brow.total {
  border-top: 2rpx solid #ece7de;
  border-bottom: 0;
  padding-top: 26rpx;
}
.brow.total .v {
  font-size: 32rpx;
}

/* ===== KPI ===== */
.kpi {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}
.kc {
  flex: 1;
  background: var(--pure-white);
  border-radius: 40rpx;
  box-shadow: var(--shadow-sm);
  padding: 26rpx 30rpx;
}
.kl {
  font-size: 24rpx;
  color: var(--graphite);
}
.kv {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 500;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.015em;
  line-height: 1.1;
}
.ku {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--graphite);
}

/* ===== 成交卡 ===== */
.deal-card {
  text-align: center;
}
.deal-label {
  font-size: 24rpx;
  color: var(--graphite);
}
.deal-price {
  font-size: 56rpx;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.02em;
  margin-top: 10rpx;
}
.deal-chips {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}
