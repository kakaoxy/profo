/* 购房模拟器 · 数据展示（账单行） */
/* ===== 账单行 ===== */
.card-rows {
  padding: 20rpx 36rpx;
}
.brow {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #eeeff1;
  font-size: 27rpx;
}
.brow:last-child {
  border-bottom: 0;
}
.brow .k {
  color: var(--ash);
  flex: 1;
}
.brow .v {
  font-weight: 500;
  color: var(--ink);
  white-space: nowrap;
}
.brow.total {
  border-top: 2rpx solid #ece7de;
  border-bottom: 0;
  padding-top: 26rpx;
}
.brow.total .v {
  font-size: 32rpx;
}

