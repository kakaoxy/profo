/* 购房模拟器 · 购房模块 v1 样式（对齐 docs/2026-09-17-购房模块-高保真设计稿.html）
   状态带 / 双层时间条 / 坑块 / 等待屏 / 学费单 / 总账清单 / 胶囊 / 房源卡 / 付款确认弹窗。
   换算：设计稿以 375px 宽为基准，此处 rpx = px × 2。

   ⚠️ 单文件 >500 行说明：本表按「设计稿的签名组件」分区顺序排列（状态带 → 时间条 → 分节 →
   选项 → 胶囊 → 坑 → 等待屏 → 学费单 → 总账 → 房源卡 → 付款弹窗），
   新增一个购房组件时要在相邻分区里对照改，拆文件反而让「同屏多组件」的间距口径散落。 */

/* ===== 购房状态带（一行定位 + 12 段节点线 + 钱条 + 期条） ===== */
.guard {
  flex: none;
  background: var(--pure-white);
  border-bottom: 2rpx solid #ece7de;
  padding: 20rpx 32rpx 24rpx;
  z-index: 6;
}
.g-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
}
.g-badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  height: 48rpx;
  padding: 0 20rpx;
  background: var(--fog);
  border-radius: 9999rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--ash);
  white-space: nowrap;
}
.g-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--rust);
}
.g-cur {
  color: var(--ink);
  font-weight: 500;
  overflow: hidden;
  white-space: nowrap;
}
.g-sp {
  flex: 1;
}
.g-day {
  color: var(--graphite);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
  white-space: nowrap;
}

/* 12 段节点线：已完成 ink / 当前 rust / 未到 hairline */
.g-line {
  display: flex;
  gap: 4rpx;
  margin-top: 18rpx;
}
.g-seg {
  flex: 1;
  height: 8rpx;
  border-radius: 9999rpx;
  background: #ece7de;
}
.g-seg.done {
  background: var(--ink);
}
.g-seg.cur {
  background: var(--rust);
  box-shadow: 0 0 0 4rpx var(--apricot-wash);
}
.g-names {
  display: flex;
  gap: 4rpx;
  margin-top: 8rpx;
}
.g-names text {
  flex: 1;
  text-align: center;
  font-size: 17rpx;
  color: var(--dove);
  overflow: hidden;
  white-space: nowrap;
}
.g-names text.on {
  color: var(--ink);
  font-weight: 500;
}

/* 钱条 / 期条（.gm 系列骨架复用装修期双条，这里补常规区间暖色带与多花提示） */
.g-meters {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 22rpx;
}
.gm-range {
  background: var(--apricot-wash);
  opacity: 0.85;
}
.gm-v {
  max-width: 62%;
  text-align: right;
}
.g-loss {
  font-size: 22rpx;
  color: #b7410e;
  line-height: 1.4;
}

/* ===== 第 N 天 + 双层时间条 ===== */
.daybar {
  margin-bottom: 4rpx;
}
.daybar .sw-day {
  font-size: 24rpx;
  color: var(--graphite);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
}
.tstrip {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.ts-cell {
  flex: 1;
  min-width: 0;
  background: var(--pure-white);
  border-radius: 32rpx;
  box-shadow: var(--shadow-sm);
  padding: 18rpx 22rpx;
}
.ts-cell.real {
  background: var(--apricot-wash);
}
.ts-k {
  font-size: 21rpx;
  color: var(--graphite);
}
.ts-v {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--ink);
  margin-top: 6rpx;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
  letter-spacing: -0.015em;
}
.ts-u {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--graphite);
  margin-left: 4rpx;
}
.ts-n {
  font-size: 20rpx;
  color: var(--dove);
  margin-top: 6rpx;
  line-height: 1.35;
}
.ts-cell.real .ts-k,
.ts-cell.real .ts-n {
  color: var(--rust);
  opacity: 0.75;
}

/* ===== 分节标题 ===== */
.sect {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 44rpx;
}
.sect-t {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink);
}
.sect-x {
  font-size: 22rpx;
  color: var(--dove);
}

/* ===== 开场三卡 + 12 节点一览 ===== */
.g3 {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}
.g3-cell {
  flex: 1;
  min-width: 0;
  background: var(--pure-white);
  border-radius: 36rpx;
  box-shadow: var(--shadow-sm);
  padding: 24rpx 22rpx;
}
.g3-k {
  font-size: 21rpx;
  color: var(--dove);
}
.g3-v {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  margin-top: 8rpx;
  line-height: 1.3;
  letter-spacing: -0.015em;
}
.g3-n {
  font-size: 21rpx;
  color: var(--graphite);
  margin-top: 8rpx;
  line-height: 1.45;
}
.trail {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 24rpx;
}
.trail text {
  font-size: 21rpx;
  color: var(--graphite);
  background: var(--pure-white);
  border-radius: 16rpx;
  padding: 8rpx 16rpx;
  box-shadow: var(--shadow-sm);
}
.trail text.hot {
  background: var(--ink);
  color: #ffffff;
}

/* ===== 12 段节点线（上划卡下方） ===== */
.rail {
  display: flex;
  gap: 4rpx;
  margin-top: 24rpx;
}
.rail-i {
  flex: 1;
  height: 8rpx;
  border-radius: 9999rpx;
  background: #ece7de;
}
.rail-i.done {
  background: var(--ink);
}
.rail-i.cur {
  background: var(--rust);
}

/* ===== 选项（名称 + 标签 + 关键数字 + 说明 + 脚注） ===== */
.op-hd {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 14rpx;
}
.op-t {
  flex: 0 1 auto;
  min-width: 0;
}
.op-tag {
  display: inline-flex;
  align-items: center;
  flex: none;
  height: 38rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  font-size: 21rpx;
  font-weight: 500;
  background: var(--fog);
  color: var(--ash);
}
.op-tag.hot {
  background: var(--apricot-wash);
  color: var(--rust);
}
.op-tag.cool {
  background: var(--sky-wash);
  color: var(--sky-ink);
}
.op-p {
  margin-left: auto;
  flex: none;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
  letter-spacing: -0.015em;
}
.op-p.danger {
  color: #b7410e;
}
.op-note {
  font-size: 22rpx;
  color: var(--dove);
  margin-top: 10rpx;
  line-height: 1.5;
}
.op-note.risk {
  color: #b7410e;
}

/* ===== 选中态（停留本屏的选项 / 房源卡 / 档位卡）=====
   设计稿的 .opt.on 只有一条 2px 墨边，在手机上远看几乎无差别——用户会以为「没选上」。
   这里统一三件套：粗墨边 + 阴影 + 「✓ 已选」胶囊（胶囊复用 op-tag 语言）。 */
.opt,
.hcard,
.grade {
  transition: border-color 0.16s, box-shadow 0.16s;
}
.opt.on,
.hcard.on {
  border: 4rpx solid var(--ink);
  box-shadow: var(--shadow-sm);
}
.op-tag.on-tag {
  background: var(--ink);
  color: #ffffff;
}

/* ===== 胶囊（现金档 / 贷款年限 / 自定义房源口径） ===== */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
}
.chip {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  border-radius: 9999rpx;
  border: 2rpx solid #ece7de;
  background: var(--pure-white);
  font-size: 28rpx;
  color: var(--ink);
}
.chip.on {
  background: var(--ink);
  border-color: var(--ink);
  color: #ffffff;
  font-weight: 500;
}
.chips-rows {
  margin-top: 24rpx;
}
.cr-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 104rpx;
  border-bottom: 2rpx solid #eeeff1;
}
.cr-row:last-child {
  border-bottom: 0;
}
.cr-k {
  flex: none;
  width: 140rpx;
  font-size: 25rpx;
  color: var(--graphite);
}
.cr-chips {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12rpx;
}
.chip-sm {
  min-height: 60rpx;
  padding: 0 22rpx;
  font-size: 25rpx;
}

/* ===== 坑 / 怎么避免（每屏一块） ===== */
.pit {
  margin-top: 24rpx;
  border-radius: 30rpx;
  padding: 22rpx 26rpx;
  background: var(--apricot-wash);
  color: var(--rust);
}
.pit-t {
  font-size: 26rpx;
  line-height: 1.6;
}
.pit-f {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid rgba(93, 42, 26, 0.16);
  font-size: 25rpx;
  line-height: 1.55;
  color: var(--ash);
}
.pit-b {
  flex: none;
  color: var(--ink);
  font-weight: 500;
}
.pit.sky {
  background: var(--sky-wash);
  color: var(--sky-ink);
}
.pit.sky .pit-f {
  border-top-color: rgba(42, 92, 160, 0.18);
}

/* ===== 等待屏（审批 / 过户 / 交房） ===== */
.wait {
  margin-top: 28rpx;
  background: var(--pure-white);
  border-radius: 40rpx;
  box-shadow: var(--shadow-sm);
  padding: 28rpx 30rpx;
}
.wait-t {
  font-size: 25rpx;
  font-weight: 500;
  color: var(--ink);
}
.wait-who {
  color: var(--rust);
}
.wait-rail {
  display: flex;
  margin-top: 26rpx;
}
.wait-n {
  flex: 1;
  position: relative;
  text-align: center;
}
.wn-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ece7de;
  margin: 0 auto 12rpx;
  position: relative;
  z-index: 2;
}
.wait-n text {
  display: block;
  font-size: 20rpx;
  color: var(--dove);
  line-height: 1.3;
}
.wait-n::before,
.wait-n::after {
  content: "";
  position: absolute;
  top: 7rpx;
  height: 4rpx;
  background: #ece7de;
}
.wait-n::before {
  left: 0;
  right: 50%;
}
.wait-n::after {
  left: 50%;
  right: 0;
}
.wait-n:first-child::before,
.wait-n:last-child::after {
  display: none;
}
.wait-n.done .wn-dot,
.wait-n.done::before,
.wait-n.done::after {
  background: var(--ink);
}
.wait-n.on .wn-dot {
  background: var(--rust);
  box-shadow: 0 0 0 6rpx var(--apricot-wash);
}
.wait-n.on::before {
  background: var(--ink);
}
.wait-n.on text {
  color: var(--ink);
  font-weight: 500;
}
.wait-x {
  display: flex;
  gap: 12rpx;
  font-size: 23rpx;
  color: var(--ash);
  line-height: 1.6;
  margin-top: 18rpx;
}
.wait-b {
  flex: none;
  color: var(--ink);
  font-weight: 500;
}

/* ===== 学费单（合同没写清的账目化） ===== */
.tuition {
  margin-top: 24rpx;
  background: var(--apricot-wash);
  border: 4rpx solid #b7410e;
  border-radius: 40rpx;
  padding: 28rpx 32rpx;
}
.tu-t {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #b7410e;
}
.tu-src {
  margin-left: auto;
  font-size: 21rpx;
  font-weight: 500;
  color: var(--rust);
  background: rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
  padding: 4rpx 14rpx;
}
.tu-item {
  margin-top: 18rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 2rpx dashed #b7410e;
  border-radius: 28rpx;
  padding: 20rpx 24rpx;
}
.tu-line {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  font-size: 25rpx;
  color: var(--ink);
}
.tu-amt {
  font-weight: 500;
  white-space: nowrap;
  color: #b7410e;
}
.tu-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--rust);
  line-height: 1.55;
}
.tu-sum {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid rgba(183, 65, 14, 0.28);
  font-size: 25rpx;
  color: #b7410e;
  font-weight: 600;
}

/* ===== 总账 · 多花清单 ===== */
.lrn {
  margin-top: 24rpx;
  background: var(--pure-white);
  border-radius: 40rpx;
  box-shadow: var(--shadow-sm);
  padding: 28rpx 32rpx;
}
.lrn-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}
.lrn-t {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink);
}
.lrn-s {
  font-size: 22rpx;
  color: var(--dove);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
}
.lrn-row {
  display: flex;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #eeeff1;
}
.lrn-row:last-of-type {
  border-bottom: 0;
}
.lrn-l {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--ash);
  line-height: 1.6;
}
.lrn-b {
  color: var(--ink);
  font-weight: 500;
}
.lrn-r {
  flex: none;
  width: 172rpx;
  text-align: right;
  font-size: 25rpx;
  font-weight: 600;
  color: #b7410e;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
}
.lrn-rest {
  padding-top: 16rpx;
  font-size: 23rpx;
  color: var(--graphite);
  line-height: 1.6;
}

/* ===== 账单行（补充：键下小字 + 值配色） ===== */
.brow-k {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.brow-sub {
  font-size: 22rpx;
  color: var(--dove);
  line-height: 1.4;
}
.brow .v.ok {
  color: #176b4d;
}
.brow .v.bad {
  color: #b7410e;
}

/* ===== 房源卡（emoji + 名称/标签 + 两行信息 + 价格/可砍） ===== */
.hlist {
  margin-top: 20rpx;
}
.hcard {
  display: flex;
  gap: 22rpx;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  background: var(--pure-white);
  border: 2rpx solid #ece7de;
  border-radius: 40rpx;
  padding: 24rpx 28rpx;
  margin-top: 20rpx;
}
.hcard:active {
  border-color: var(--dove);
}
.hc-emo {
  flex: none;
  width: 80rpx;
  height: 80rpx;
  border-radius: 26rpx;
  background: var(--fog);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
}
.hc-b {
  flex: 1;
  min-width: 0;
}
.hc-n {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 12rpx;
  font-size: 27rpx;
  font-weight: 500;
  color: var(--ink);
}
.hc-m {
  display: block;
  font-size: 23rpx;
  color: var(--graphite);
  margin-top: 6rpx;
  line-height: 1.5;
}
.hc-p {
  flex: none;
  text-align: right;
}
.hc-v {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
  letter-spacing: -0.015em;
}
.hc-x {
  display: block;
  font-size: 21rpx;
  color: var(--dove);
  margin-top: 6rpx;
}

/* ===== 付款确认弹窗（现金三段 + 下一节点） ===== */
.m-amt {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
  margin-top: 28rpx;
  background: var(--fog);
  border-radius: 32rpx;
  padding: 22rpx 26rpx;
}
.ma-cell {
  flex: 1;
  min-width: 0;
}
.ma-k {
  display: block;
  font-size: 21rpx;
  color: var(--graphite);
}
.ma-v {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  margin-top: 6rpx;
  letter-spacing: -0.015em;
  white-space: nowrap;
}
.ma-v.pay {
  color: var(--rust);
}
.ma-arrow {
  font-size: 24rpx;
  color: var(--dove);
  line-height: 1.9;
}
.m-next {
  margin-top: 24rpx;
  background: var(--apricot-wash);
  border-radius: 32rpx;
  padding: 22rpx 26rpx;
}
.m-next-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}
.m-next-k {
  flex: none;
  font-size: 21rpx;
  color: var(--rust);
  opacity: 0.8;
}
.m-next-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
}
.m-next-d {
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--rust);
  white-space: nowrap;
}
.m-next-w {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--rust);
  opacity: 0.85;
  line-height: 1.5;
}

/* ===== 主按钮上的等待承诺 ===== */
.btn-w {
  font-size: 22rpx;
  font-weight: 400;
  opacity: 0.72;
  margin-left: 14rpx;
}