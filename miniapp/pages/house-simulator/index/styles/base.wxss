/* 购房模拟器 · 基础骨架（页面容器 / HUD / 流程条 / 卖家情绪 / 舞台区） */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--fog);
  overflow: hidden;
}
.num {
  font-variant-numeric: tabular-nums;
  /* 设计稿「移植须知」：微信不认 font-variant-numeric（数字会跳动），
     这里用 tnum 兜底（保持系统无衬线字体，仅锁定数字等宽） */
  font-feature-settings: "tnum" 1;
}

/* ===== HUD 顶部状态条 ===== */
.hud {
  flex: none;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  background: var(--pure-white);
  border-bottom: 2rpx solid #ece7de;
  z-index: 5;
}
.stage-badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  height: 52rpx;
  padding: 0 24rpx;
  background: var(--fog);
  border-radius: 9999rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--ash);
  white-space: nowrap;
}
.stage-badge .sd {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--rust);
}
.sp {
  flex: 1;
}
.hud-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--graphite);
  white-space: nowrap;
}
.hud-item .num {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink);
}
.moodface {
  font-size: 28rpx;
}

/* ===== 12 节点流程条 ===== */
.steps {
  flex: none;
  background: var(--pure-white);
  border-bottom: 2rpx solid #ece7de;
  padding: 16rpx 0 16rpx;
  z-index: 5;
}
.steps-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  font-size: 22rpx;
  color: var(--graphite);
}
.steps-pos {
  color: var(--ink);
  font-weight: 500;
}
.steps-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 0;
  padding: 16rpx 8rpx 0;
}
.stp {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 0 14rpx;
}
.stp-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #ece7de;
  font-style: normal;
  font-size: 12rpx;
  line-height: 18rpx;
  text-align: center;
  color: #ffffff;
}
.stp-label {
  font-size: 20rpx;
  font-weight: 450;
  color: var(--dove);
  white-space: nowrap;
}
.stp.done .stp-dot {
  background: #176b4d;
}
.stp.done .stp-label {
  color: var(--graphite);
}
.stp.cur .stp-dot {
  background: var(--rust);
  box-shadow: 0 0 0 6rpx var(--apricot-wash);
}
.stp.cur .stp-label {
  color: var(--ink);
  font-weight: 600;
}

/* ===== 舞台内容区 ===== */
.stage {
  flex: 1;
  min-height: 0;
  height: 0;
}
.sc {
  padding: 40rpx 36rpx 72rpx;
  animation: arrive 0.42s cubic-bezier(0.22, 1, 0.36, 1);
}
@keyframes arrive {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
.stage ::-webkit-scrollbar {
  width: 0;
  height: 0;
}
.safe-bottom {
  height: 48rpx;
}
