/* 购房模拟器 · 表单（现金 / 自定义房源）+ 按钮 / 贷款年限 / 首付档位 */
/* ===== 表单（现金 / 自定义房源） ===== */
.form-card {
  padding: 32rpx;
}
.f-label {
  font-size: 25rpx;
  color: var(--graphite);
  margin-bottom: 10rpx;
}
.f-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--dove);
  border-radius: 28rpx;
  background: var(--pure-white);
  color: var(--ink);
  font-size: 30rpx;
}
.field {
  margin-bottom: 28rpx;
}
.field:last-child {
  margin-bottom: 0;
}

/* ===== 按钮 ===== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
  height: 96rpx;
  border-radius: 9999rpx;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: -0.009em;
  line-height: 1;
}
.btn:active {
  transform: scale(0.985);
}
.btn-ink {
  background: var(--ink);
  color: #ffffff;
}
.btn-out {
  background: var(--pure-white);
  color: var(--ink);
  border: 2rpx solid var(--dove);
}
.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}
.btn-row .btn {
  flex: 1;
}
.btn-years {
  height: 76rpx;
  font-size: 28rpx;
  flex: 1;
}

/* ===== 贷款年限 ===== */
.years-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
}
.y-label {
  font-size: 25rpx;
  color: var(--graphite);
  flex: none;
}
.years-row {
  flex: 1;
  margin-top: 0;
}

/* ===== 文本链接 ===== */
.ds-card {
  padding: 32rpx;
}
.ds-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.ds-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink);
}
.ds-min {
  font-size: 23rpx;
  color: var(--graphite);
}
.ds-row {
  display: flex;
  gap: 16rpx;
}
.ds-item {
  flex: 1;
  min-width: 0;
  padding: 20rpx 8rpx;
  border-radius: 24rpx;
  border: 2rpx solid #ece7de;
  background: var(--pure-white);
  text-align: center;
}
.ds-item:active {
  border-color: var(--dove);
}
/* 选中档位 = 墨底白字（与现金胶囊同一套「选中」语言：远看一眼就能认出） */
.ds-item--on {
  background: var(--ink);
  border-color: var(--ink);
}
.ds-item--on .ds-t {
  color: #ffffff;
}
.ds-item--on .ds-amt {
  color: var(--apricot-wash);
}
.ds-t {
  font-size: 25rpx;
  font-weight: 500;
  color: var(--ink);
  white-space: nowrap;
}
.ds-amt {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--graphite);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
  white-space: nowrap;
}

