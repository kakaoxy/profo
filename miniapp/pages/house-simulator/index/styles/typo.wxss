/* 购房模拟器 · 排版（页眉 / 标题 / 正文 / 卡片 / 横幅） */
/* ===== 页眉 ===== */
.eyebrow {
  display: inline-flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--rust);
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.hd {
  font-weight: 500;
  font-size: 50rpx;
  line-height: 1.22;
  letter-spacing: -0.015em;
  color: var(--ink);
  margin: 12rpx 0 0;
  white-space: pre-line;
}
.hd-big {
  font-size: 58rpx;
}
.hd-hero {
  display: block;
  font-size: 76rpx;
  line-height: 1.2;
  margin-bottom: 8rpx;
}
.sub {
  margin: 12rpx 0 0;
  font-size: 28rpx;
  color: var(--ash);
  line-height: 1.65;
}

/* ===== 卡片 ===== */
.card {
  background: var(--pure-white);
  border-radius: 48rpx;
  box-shadow: var(--shadow-sm);
  padding: 36rpx;
  margin-top: 28rpx;
}
.card-warm {
  background: var(--apricot-wash);
}
.card-sky {
  background: var(--sky-wash);
}
.b-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink);
  line-height: 1.5;
}
.b-title-lg {
  font-size: 56rpx;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.015em;
  line-height: 1.15;
}
.b-desc {
  font-size: 25rpx;
  color: var(--ash);
  margin-top: 10rpx;
  line-height: 1.7;
  white-space: pre-line;
}
