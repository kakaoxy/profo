/* 购房模拟器 · 房源卡 / 徽章 / 问答进度 */
/* ===== 房源卡 ===== */
.hlist {
  margin-top: 24rpx;
}
.hcard {
  background: var(--pure-white);
  border-radius: 40rpx;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  margin-bottom: 24rpx;
}
.hcard:active {
  opacity: 0.92;
}
.hthumb {
  position: relative;
  height: 236rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.thumb-a {
  background: linear-gradient(135deg, #fdf3ec 0%, var(--apricot-wash) 100%);
}
.thumb-b {
  background: linear-gradient(135deg, #f6f8fd 0%, var(--sky-wash) 100%);
}
.thumb-c {
  background: var(--fog);
}
.h-emoji {
  font-size: 88rpx;
}
.hcorner {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
}
.hbody {
  padding: 24rpx 32rpx 28rpx;
}
.hrow {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.hname {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
}
.hmeta {
  font-size: 24rpx;
  color: var(--graphite);
  margin-top: 8rpx;
}
.hfoot {
  margin-top: 18rpx;
  justify-content: space-between;
}
.hprice {
  font-size: 40rpx;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
  color: var(--ink);
}
.hcut {
  font-size: 24rpx;
  color: var(--rust);
  font-weight: 500;
}

/* ===== 徽章 ===== */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  white-space: nowrap;
}
.badge-warm {
  background: var(--apricot-wash);
  color: var(--rust);
}
.badge-sky {
  background: var(--sky-wash);
  color: #2a5ca0;
}
.badge-fog {
  background: var(--fog);
  color: var(--ash);
}
.badge-hair {
  background: transparent;
  border: 2rpx solid var(--dove);
  color: var(--graphite);
}

/* ===== 问答进度 ===== */
.qdots {
  display: flex;
  gap: 12rpx;
  align-items: center;
  margin-bottom: 8rpx;
}
.qd {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ece7de;
}
.qd.on {
  background: var(--rust);
}
