/* 购房模拟器 · 徽章（房源标签 / 交易凭证 / 选项标签共用）
   房源卡与 .hcard 系列样式见 flow.wxss（购房模块 v1 视觉）。 */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  white-space: nowrap;
}
.badge-warm {
  background: var(--apricot-wash);
  color: var(--rust);
}
.badge-sky {
  background: var(--sky-wash);
  color: #2a5ca0;
}
.badge-fog {
  background: var(--fog);
  color: var(--ash);
}
.badge-hair {
  background: transparent;
  border: 2rpx solid var(--dove);
  color: var(--graphite);
}