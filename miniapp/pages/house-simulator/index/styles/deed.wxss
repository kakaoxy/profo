/* 购房模拟器 · 电子证照 */
/* ===== 电子证照 ===== */
.deed {
  background: var(--pure-white);
  border: 2rpx solid #ece7de;
  border-radius: 28rpx;
  padding: 32rpx 36rpx;
  box-shadow: var(--shadow-sm);
  margin-top: 28rpx;
}
.deed-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 2rpx solid #eeeff1;
  padding-bottom: 24rpx;
}
.logo-c {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: var(--apricot-wash);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--rust);
  flex: none;
}
.deed-title-wrap {
  flex: 1;
  min-width: 0;
}
.deed-title {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--ink);
}
.deed-sub {
  font-size: 23rpx;
  color: var(--graphite);
  margin-top: 4rpx;
}
.qrcode {
  width: 74rpx;
  height: 74rpx;
  border-radius: 20rpx;
  opacity: 0.85;
  flex: none;
  background: repeating-conic-gradient(var(--ink) 0% 25%, transparent 0% 50%) 0 0 / 18rpx 18rpx;
}
.deed-foot {
  padding-top: 24rpx;
  font-size: 24rpx;
  color: var(--graphite);
  display: flex;
  justify-content: space-between;
}
