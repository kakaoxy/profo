/* 购房模拟器 · 底部弹层（普通弹层 / 风险强制确认 / 税费分项明细 / 勾选确认） */
/* ===== 底部弹层 ===== */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(23, 25, 28, 0.42);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 20;
  padding: 32rpx;
  animation: fadein 0.2s ease;
}
@keyframes fadein {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.sheet {
  width: 100%;
  box-sizing: border-box;
  /* 内容超高（如 8 项协议核对清单）时弹层内部可滚动，保证底部操作可达 */
  max-height: 90vh;
  overflow-y: auto;
  background: var(--pure-white);
  border-radius: 48rpx;
  padding: 40rpx 40rpx 36rpx;
  animation: rise 0.28s cubic-bezier(0.22, 1, 0.36, 1);
}
@keyframes rise {
  from {
    transform: translateY(80rpx);
    opacity: 0;
  }
  to {
    transform: none;
    opacity: 1;
  }
}
.sheet-tag {
  display: inline-flex;
  gap: 12rpx;
  align-items: center;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--rust);
}
.sheet-title {
  margin: 16rpx 0 10rpx;
  font-size: 34rpx;
  font-weight: 500;
  color: var(--ink);
}
.sheet-desc {
  font-size: 27rpx;
  color: var(--ash);
  line-height: 1.7;
  margin-bottom: 14rpx;
}
.sheet-desc:last-of-type {
  margin-bottom: 0;
}
/* ===== 付款确认 · 违约风险警示（醒目字号 / 警示色，替代原「违约风险」弹层） ===== */
.pay-warn {
  margin-top: 18rpx;
  background: var(--apricot-wash);
  border: 3rpx solid var(--rust);
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
}
.pay-warn-flag {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--rust);
}
.pay-warn-text {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--rust);
  line-height: 1.6;
}
/* ===== 弹层底部操作区（与顶部内容留白、两个按钮并排等宽） ===== */
.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}
.sheet-actions .btn {
  flex: 1;
}
.btn-disabled {
  background: var(--fog);
  color: var(--dove);
}
