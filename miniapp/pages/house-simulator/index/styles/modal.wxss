/* 购房模拟器 · 底部弹层（普通弹层 / 风险强制确认 / 税费分项明细 / 勾选确认） */
/* ===== 底部弹层 ===== */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(23, 25, 28, 0.42);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 20;
  padding: 32rpx;
  animation: fadein 0.2s ease;
}
@keyframes fadein {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.sheet {
  width: 100%;
  box-sizing: border-box;
  /* 内容超高（如 8 项协议核对清单）时弹层内部可滚动，保证底部操作可达 */
  max-height: 90vh;
  overflow-y: auto;
  background: var(--pure-white);
  border-radius: 48rpx;
  padding: 40rpx 40rpx 36rpx;
  animation: rise 0.28s cubic-bezier(0.22, 1, 0.36, 1);
}
@keyframes rise {
  from {
    transform: translateY(80rpx);
    opacity: 0;
  }
  to {
    transform: none;
    opacity: 1;
  }
}
.sheet-tag {
  display: inline-flex;
  gap: 12rpx;
  align-items: center;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--rust);
}
.sheet-title {
  margin: 16rpx 0 10rpx;
  font-size: 34rpx;
  font-weight: 500;
  color: var(--ink);
}
.sheet-desc {
  font-size: 27rpx;
  color: var(--ash);
  line-height: 1.7;
  margin-bottom: 14rpx;
}
.sheet-desc:last-of-type {
  margin-bottom: 0;
}
.strong {
  color: var(--ink);
  font-weight: 500;
}
.net-line {
  padding: 4rpx 0 4rpx 24rpx;
  color: var(--rust);
  font-weight: 500;
}
.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}
.sheet-actions .btn {
  flex: 1;
}

/* ===== 风险弹层（红色警示 · 强制确认） ===== */
.risk-sheet {
  border: 4rpx solid var(--rust);
}
.tag-red {
  color: var(--rust);
  font-weight: 600;
}
.risk-num {
  color: var(--rust);
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.risk-alert {
  margin-top: 16rpx;
  font-size: 25rpx;
  font-weight: 500;
  color: var(--rust);
  background: var(--apricot-wash);
  border: 2rpx solid #e8b79b;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  line-height: 1.6;
}

/* ===== 付款确认 · 违约风险警示（醒目字号 / 警示色，替代原「违约风险」弹层） ===== */
.pay-warn {
  margin-top: 18rpx;
  background: var(--apricot-wash);
  border: 3rpx solid var(--rust);
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
}
.pay-warn-flag {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--rust);
}
.pay-warn-text {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--rust);
  line-height: 1.6;
}

/* ===== 付款确认 · 现金去向（定金 / 首付入监管 / 过户税费） ===== */
.cash-flow {
  margin-top: 18rpx;
  background: var(--fog);
  border-radius: 20rpx;
  padding: 4rpx 24rpx;
}
.cf-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  font-size: 28rpx;
}
.cf-row:not(:last-child) {
  border-bottom: 2rpx dashed var(--dove);
}
.cf-k {
  color: var(--graphite);
  flex: none;
}
.cf-v {
  color: var(--ink);
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}
.cf-out .cf-v {
  color: var(--rust);
  font-weight: 600;
}
.cf-bal .cf-v {
  font-weight: 600;
}

/* ===== 税费风险确认 · 分项明细 ===== */
.tax-item {
  background: var(--fog);
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 12rpx;
}
.tax-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.tax-name {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--ink);
}
.tax-amt {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--rust);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.tax-std {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--graphite);
  line-height: 1.5;
}
.tax-total {
  margin-top: 10rpx;
  font-size: 29rpx;
  color: var(--ink);
}

/* ===== 税费风险确认 · 勾选与确认 ===== */
.risk-check {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  border: 2rpx solid var(--dove);
  border-radius: 20rpx;
}
.risk-check:active {
  border-color: var(--rust);
}
.risk-check.on {
  background: var(--apricot-wash);
  border-color: var(--rust);
}
.check-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--graphite);
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #ffffff;
}
.risk-check.on .check-box {
  background: var(--rust);
  border-color: var(--rust);
}
.check-text {
  flex: 1;
  font-size: 25rpx;
  color: var(--ink);
  line-height: 1.5;
}
.btn-disabled {
  background: var(--fog);
  color: var(--dove);
}

/* ===== 居间协议核对清单（签署前逐项勾选，全部核对后才可确认） ===== */
.agreement-sheet {
  padding-bottom: 36rpx;
}
.agr-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 14rpx;
  padding: 16rpx 20rpx;
  border: 2rpx solid var(--dove);
  border-radius: 20rpx;
}
.agr-item:active {
  border-color: var(--rust);
}
.agr-item.on {
  background: var(--apricot-wash);
  border-color: var(--rust);
}
.agr-item.on .check-box {
  background: var(--rust);
  border-color: var(--rust);
}
.agr-item .check-box {
  margin-top: 2rpx;
}
.agr-body {
  flex: 1;
  min-width: 0;
}
.agr-title {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--ink);
}
.agr-tip {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--graphite);
  line-height: 1.55;
}

/* ===== 模拟日历 · 时间快进 ===== */
.cal-sheet {
  padding-bottom: 40rpx;
}
.cal-title {
  margin: 16rpx 0 6rpx;
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}
.cal-arr {
  font-size: 30rpx;
  color: var(--ink);
  line-height: 1.4;
}
.cal-gap {
  margin-left: auto;
  font-size: 26rpx;
  color: var(--ink);
  flex: none;
}
.cal-gap-n {
  font-size: 56rpx;
  font-weight: 600;
  color: var(--rust);
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
}
.cal-phase {
  font-size: 26rpx;
  color: var(--graphite);
  margin-bottom: 20rpx;
}
.cal-card {
  background: var(--fog);
  border-radius: 24rpx;
  padding: 24rpx;
}
.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.cal-month {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
}
.cal-fast {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--rust);
  font-variant-numeric: tabular-nums;
}
.cal-day {
  font-size: 24rpx;
  font-weight: 600;
  color: #176b4d;
  font-variant-numeric: tabular-nums;
}
.cal-week {
  display: flex;
}
.cal-wk {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--dove);
  padding-bottom: 10rpx;
}
.cal-grid {
  display: flex;
  flex-wrap: wrap;
}
.cal-cell {
  width: calc(100% / 7);
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  box-sizing: border-box;
}
.cal-cell.past {
  color: #c9c2b4;
}
.cal-cell.cur {
  background: var(--rust);
  color: #ffffff;
  font-weight: 600;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(193, 70, 30, 0.22);
}
.cal-range {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--graphite);
  font-variant-numeric: tabular-nums;
}
.cal-arrow {
  color: var(--rust);
  font-weight: 600;
}
.cal-progress {
  height: 10rpx;
  border-radius: 9999rpx;
  background: #ece7de;
  margin-top: 14rpx;
  overflow: hidden;
}
.cal-progress-fill {
  height: 100%;
  border-radius: 9999rpx;
  background: var(--rust);
  transition: width 0.5s ease;
}
.cal-note {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--ash);
  line-height: 1.7;
  background: var(--pure-white);
  border: 2rpx solid #ece7de;
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
}
.cal-note-b {
  color: var(--ink);
  font-weight: 600;
}
.cal-risk {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--rust);
  line-height: 1.7;
  background: var(--apricot-wash);
  border: 2rpx solid #e8b79b;
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
}
.cal-risk-b {
  font-weight: 600;
}
