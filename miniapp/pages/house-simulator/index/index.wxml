<!--
  购房模拟器 · 页面模板（38 屏共用一套「按块类型分发」的渲染骨架）.
  - 顶部：购房 24 屏走「状态带」（12 段节点线 + 钱条 + 期条），装修 14 屏走装修流程条 + 钱/工双条；
  - 舞台：blocks 按 t 顺序渲染（时间条 / 选项 / 坑 / 等待屏 / 清单 / 学费单 …），块类型见 utils/scenes-common.ts；
  - 主按钮单独渲染在内容块之后（等待承诺写在按钮上），输入框改值时页面只 patch 这一块；
  - 底部弹层只剩「付款确认」（五个出款点）。

  ⚠️ 单文件 >500 行说明：这里是全部 38 屏共用的唯一模板，块类型之间是 wx:elif 平铺关系；
  拆成多个 template 会让「块顺序 + 主按钮收尾」的约定分散，故保持单文件。
-->
<view class="page">
  <!-- 购房状态带：一行定位 + 12 段节点线 + 钱条 + 期条（已走 N 天 / 常规 1-3 个月） -->
  <view class="guard" wx:if="{{guard}}">
    <view class="g-top">
      <view class="g-badge"><view class="g-dot"></view>购房</view>
      <view class="g-cur">{{guard.cur}}</view>
      <view class="g-sp"></view>
      <view class="g-day">{{guard.day}}</view>
    </view>
    <view class="g-line">
      <view class="g-seg {{s.cls}}" wx:for="{{guard.segs}}" wx:for-item="s" wx:key="index"></view>
    </view>
    <view class="g-names">
      <text class="{{n.on ? 'on' : ''}}" wx:for="{{guard.names}}" wx:for-item="n" wx:key="index">{{n.t}}</text>
    </view>
    <view class="g-meters">
      <view class="gm">
        <text class="gm-k">钱</text>
        <view class="gm-bar">
          <view class="gm-base" style="width: {{guard.money.base}}%"></view>
          <view class="gm-over" style="width: {{guard.money.over}}%"></view>
        </view>
        <view class="gm-v">{{guard.money.text}}<text class="gm-sub">{{guard.money.sub}}</text></view>
      </view>
      <view class="gm">
        <text class="gm-k">期</text>
        <view class="gm-bar">
          <view class="gm-base" style="width: {{guard.time.base}}%"></view>
          <view class="gm-range" style="margin-left: {{guard.time.warmMargin}}%; width: {{guard.time.warmWidth}}%"></view>
        </view>
        <view class="gm-v">{{guard.time.text}}<text class="gm-sub">{{guard.time.sub}}</text></view>
      </view>
      <view class="g-loss" wx:if="{{guard.loss}}">{{guard.loss}}</view>
    </view>
  </view>

  <!-- 装修阶段：阶段徽章 + 12 项流程条 + 钱/工双条 -->
  <block wx:else>
    <view class="hud">
      <view class="stage-badge"><view class="sd"></view><text>{{renovLabel}}</text></view>
      <view class="sp"></view>
      <view class="hud-item">步 <text class="num">{{stepPos}}</text></view>
      <view class="hud-item">日历 <text class="num">{{dayText}}</text></view>
      <view class="hud-item">压力 <text class="moodface">{{stressEmoji}}</text></view>
    </view>
    <view class="steps">
      <view class="steps-row">
        <view class="stp {{item.cls}}" wx:for="{{steps}}" wx:key="index">
          <view class="stp-dot">{{item.mark}}</view>
          <text class="stp-label">{{item.label}}</text>
        </view>
      </view>
    </view>
    <!-- 装修期双条：钱（结账 / 合同）+ 工（实际 / 计划），深色 = 计划内，橙 = 超出的部分 -->
    <view class="meters" wx:if="{{meters}}">
      <view class="gm">
        <text class="gm-k">钱</text>
        <view class="gm-bar">
          <view class="gm-base" style="width: {{meters.money.base}}%"></view>
          <view class="gm-over" style="width: {{meters.money.over}}%"></view>
        </view>
        <view class="gm-v">{{meters.money.text}}<text class="gm-sub">{{meters.money.sub}}</text></view>
      </view>
      <view class="gm">
        <text class="gm-k">工</text>
        <view class="gm-bar">
          <view class="gm-base" style="width: {{meters.time.base}}%"></view>
          <view class="gm-over" style="width: {{meters.time.over}}%"></view>
        </view>
        <view class="gm-v">{{meters.time.text}}<text class="gm-sub">{{meters.time.sub}}</text></view>
      </view>
      <view class="g-loss" wx:if="{{meters.loss}}">{{meters.loss}}</view>
    </view>
  </block>

  <!-- 舞台内容（场景块有序渲染；换屏经动态锚点回顶，上划手势在到底后翻卡） -->
  <scroll-view
    class="stage"
    scroll-y
    scroll-into-view="{{intoView}}"
    bindscroll="onStageScroll"
    bindtouchstart="onStageTouchStart"
    bindtouchend="onStageTouchEnd"
  >
    <view class="sc">
      <view id="{{anchor}}"></view>
      <block wx:for="{{blocks}}" wx:key="index">
        <!-- 页眉 -->
        <view wx:if="{{item.t === 'eyebrow'}}" class="eyebrow">{{item.text}}</view>

        <view wx:elif="{{item.t === 'title'}}" class="hd {{item.big ? 'hd-big' : ''}}">
          <text wx:if="{{item.hero}}" class="hd-hero">{{item.hero}}</text>
          {{item.text}}
        </view>

        <view wx:elif="{{item.t === 'sub'}}" class="sub">{{item.text}}</view>

        <!-- 第 N 天 + 双层时间条（左 = 经历周期，右 = 常规周期 + 等谁 + 为什么） -->
        <view wx:elif="{{item.t === 'timebar'}}" class="daybar">
          <view class="sw-day">{{item.day}}</view>
          <view wx:if="{{item.strips.length}}" class="tstrip">
            <view class="ts-cell {{s.real ? 'real' : ''}}" wx:for="{{item.strips}}" wx:for-item="s" wx:key="index">
              <view class="ts-k">{{s.k}}</view>
              <view class="ts-v">{{s.v}}<text wx:if="{{s.unit}}" class="ts-u">{{s.unit}}</text></view>
              <view class="ts-n">{{s.n}}</view>
            </view>
          </view>
        </view>

        <!-- 分节标题（税费口径 / 还款年限 / 首付还能往上加） -->
        <view wx:elif="{{item.t === 'sect'}}" class="sect">
          <text class="sect-t">{{item.title}}</text>
          <text class="sect-x">{{item.x}}</text>
        </view>

        <!-- 进度条（核验 N 项 / 已定 N / 6 / 已核 N / 4） -->
        <view wx:elif="{{item.t === 'prog'}}" class="prog">
          <text>{{item.label}}</text>
          <view class="prog-bar"><view class="prog-bar-i" style="width: {{item.pct}}%"></view></view>
          <text class="prog-v">{{item.done}}/{{item.total}}</text>
        </view>

        <!-- 对话气泡 -->
        <view wx:elif="{{item.t === 'chat'}}" class="chat">
          <view class="bubble {{b.me ? 'me' : ''}}" wx:for="{{item.items}}" wx:for-item="b" wx:key="index">
            <view class="ava {{b.me ? 'ava-sky' : 'ava-warm'}}">{{b.whoChar}}</view>
            <view class="ball-wrap">
              <view class="who">{{b.who}}</view>
              <view class="ball">{{b.text}}</view>
            </view>
          </view>
        </view>

        <!-- 暖/蓝横幅卡 -->
        <view wx:elif="{{item.t === 'banner'}}" class="card {{item.cls === 'warm' ? 'card-warm' : 'card-sky'}}">
          <view wx:if="{{item.title}}" class="b-title {{item.large ? 'b-title-lg' : ''}}">{{item.title}}</view>
          <view wx:if="{{item.desc}}" class="b-desc">{{item.desc}}</view>
        </view>

        <!-- 账单行卡 -->
        <view wx:elif="{{item.t === 'rows'}}" class="card card-rows">
          <view class="brow {{r.total ? 'total' : ''}}" wx:for="{{item.items}}" wx:for-item="r" wx:key="index">
            <view class="brow-k">
              <text>{{r.k}}</text>
              <text wx:if="{{r.sub}}" class="brow-sub">{{r.sub}}</text>
            </view>
            <text class="v num {{r.vCls}}">{{r.v}}</text>
          </view>
        </view>

        <!-- 开场三卡（流程 / 时间 / 坑） -->
        <view wx:elif="{{item.t === 'g3'}}" class="g3">
          <view class="g3-cell" wx:for="{{item.items}}" wx:for-item="c" wx:key="index">
            <view class="g3-k">{{c.k}}</view>
            <view class="g3-v">{{c.v}}</view>
            <view class="g3-n">{{c.n}}</view>
          </view>
        </view>

        <!-- 12 节点一览（签约与交房标黑：两个深坑） -->
        <view wx:elif="{{item.t === 'trail'}}" class="trail">
          <text class="{{c.hot ? 'hot' : ''}}" wx:for="{{item.items}}" wx:for-item="c" wx:key="index">{{c.text}}</text>
        </view>

        <!-- 12 段节点线（上划卡下方，不给节点名） -->
        <view wx:elif="{{item.t === 'rail'}}" class="rail">
          <view class="rail-i {{c}}" wx:for="{{item.segs}}" wx:for-item="c" wx:key="index"></view>
        </view>

        <!-- 房源卡列表（含自定义房源卡） -->
        <view wx:elif="{{item.t === 'houses'}}" class="hlist">
          <view class="hcard {{hh.on ? 'on' : ''}}" data-act="house:{{hh.id}}" bindtap="onAction" wx:for="{{item.items}}" wx:for-item="hh" wx:key="index">
            <view class="hc-emo">{{hh.emoji}}</view>
            <view class="hc-b">
              <view class="hc-n">
                <text>{{hh.name}}</text>
                <view wx:if="{{hh.on}}" class="op-tag on-tag">✓ 已选</view>
                <view class="op-tag {{hh.tagCls}}">{{hh.tag}}</view>
              </view>
              <view class="hc-m" wx:for="{{hh.metas}}" wx:for-item="mt" wx:key="index">{{mt}}</view>
            </view>
            <view class="hc-p">
              <text class="hc-v">{{hh.price}}</text>
              <text wx:if="{{hh.cut}}" class="hc-x">{{hh.cut}}</text>
            </view>
          </view>
        </view>

        <!-- 选项大按钮（名称 + 标签 + 关键数字 + 说明 + 脚注） -->
        <view wx:elif="{{item.t === 'opts'}}" class="opts">
          <view wx:for="{{item.items}}" wx:for-item="o" wx:key="index">
            <view wx:if="{{!o.disabled}}" class="opt {{o.on ? 'on' : ''}}" data-act="{{o.action}}" bindtap="onAction">
              <view class="op-hd">
                <text class="op-t">{{o.title}}</text>
                <view wx:if="{{o.on}}" class="op-tag on-tag">✓ 已选</view>
                <view wx:if="{{o.tag}}" class="op-tag {{o.tagCls}}">{{o.tag}}</view>
                <text wx:if="{{o.price}}" class="op-p {{o.priceCls}}">{{o.price}}</text>
              </view>
              <view wx:if="{{o.desc}}" class="opt-d">{{o.desc}}</view>
              <view wx:if="{{o.note}}" class="op-note {{o.risk ? 'risk' : ''}}">{{o.note}}</view>
            </view>
            <view wx:else class="opt opt-disabled">
              <view class="op-hd">
                <text class="op-t">{{o.title}}</text>
                <view wx:if="{{o.tag}}" class="op-tag {{o.tagCls}}">{{o.tag}}</view>
              </view>
              <view wx:if="{{o.desc}}" class="opt-d">{{o.desc}}</view>
            </view>
          </view>
        </view>

        <!-- 胶囊（现金档 / 贷款年限） -->
        <view wx:elif="{{item.t === 'chips'}}" class="chips">
          <view class="chip {{c.on ? 'on' : ''}}" data-act="{{c.action}}" bindtap="onAction" wx:for="{{item.items}}" wx:for-item="c" wx:key="index">{{c.label}}</view>
        </view>

        <!-- 多行胶囊（自定义房源：环线 / 持有年限 / 是否唯一 / 取得方式） -->
        <view wx:elif="{{item.t === 'chipsRows'}}" class="chips-rows">
          <view class="cr-row" wx:for="{{item.rows}}" wx:for-item="row" wx:key="index">
            <text class="cr-k">{{row.k}}</text>
            <view class="cr-chips">
              <view class="chip chip-sm {{c.on ? 'on' : ''}}" data-act="{{c.action}}" bindtap="onAction" wx:for="{{row.items}}" wx:for-item="c" wx:key="index">{{c.label}}</view>
            </view>
          </view>
        </view>

        <!-- 坑 / 怎么避免（每屏一块，本稿的核心减量单元） -->
        <view wx:elif="{{item.t === 'pit'}}" class="pit {{item.sky ? 'sky' : ''}}">
          <view class="pit-t">{{item.title}}</view>
          <view wx:if="{{item.fix}}" class="pit-f">
            <text wx:if="{{item.fixLabel}}" class="pit-b">{{item.fixLabel}}</text>{{item.fix}}
          </view>
        </view>

        <!-- 等待屏（审批 / 过户 / 交房）：这一段在等谁、为什么等这么久 -->
        <view wx:elif="{{item.t === 'wait'}}" class="wait">
          <view class="wait-t">{{item.title}}<text class="wait-who">{{item.who}}</text></view>
          <view class="wait-rail">
            <view class="wait-n {{s.cls}}" wx:for="{{item.steps}}" wx:for-item="s" wx:key="index">
              <view class="wn-dot"></view>
              <text>{{s.label}}</text>
            </view>
          </view>
          <view class="wait-x" wx:for="{{item.rows}}" wx:for-item="r" wx:key="index">
            <text class="wait-b">{{r.k}}</text>{{r.v}}
          </view>
        </view>

        <!-- 学费单（签约清单没写清的账目化） -->
        <view wx:elif="{{item.t === 'tuition'}}" class="tuition">
          <view class="tu-t">
            <text>{{item.title}}</text>
            <text class="tu-src">{{item.src}}</text>
          </view>
          <view class="tu-item" wx:for="{{item.items}}" wx:for-item="t" wx:key="index">
            <view class="tu-line"><text>{{t.name}}</text><text class="tu-amt">{{t.amount}}</text></view>
            <view class="tu-hint">{{t.text}}</view>
          </view>
          <view class="tu-sum">{{item.total}}</view>
        </view>

        <!-- 总账 · 多花的 N 笔（默认摊 3 笔，其余折叠成一行） -->
        <view wx:elif="{{item.t === 'lrn'}}" class="lrn">
          <view class="lrn-head">
            <text class="lrn-t">{{item.count}}</text>
            <text class="lrn-s">{{item.sum}}</text>
          </view>
          <view class="lrn-row" wx:for="{{item.rows}}" wx:for-item="r" wx:key="index">
            <view class="lrn-l"><text class="lrn-b">{{r.b}}</text>{{r.t}}</view>
            <text class="lrn-r">{{r.r}}</text>
          </view>
          <view wx:if="{{item.rest}}" class="lrn-rest">{{item.rest}}</view>
        </view>

        <!-- 装修 · 档位卡（预算档位 / 设计师档位；选中态停留展示底牌） -->
        <view wx:elif="{{item.t === 'grades'}}" class="grades">
          <view class="grade {{g.on ? 'on' : ''}}" data-act="{{g.action}}" bindtap="onAction" wx:for="{{item.items}}" wx:for-item="g" wx:key="index">
            <view class="gr-hd">
              <text class="gr-n">{{g.name}}</text>
              <view wx:if="{{g.on}}" class="op-tag on-tag">✓ 已选</view>
              <view class="op-tag {{g.tagCls}}">{{g.tag}}</view>
              <text class="gr-p num">{{g.price}}</text>
            </view>
            <view class="gr-d">{{g.desc}}</view>
            <view wx:if="{{g.tail}}" class="gr-note">{{g.tail}}</view>
          </view>
        </view>

        <!-- 上划卡（装修 3 秒一屏 / 购房过户·领证屏） -->
        <view wx:elif="{{item.t === 'swipe'}}" class="swipe">
          <view wx:if="{{item.day}}" class="sw-day">{{item.day}}</view>
          <view class="sw-hd">{{item.name}}</view>
          <view class="sw-one">{{item.one}}</view>
          <view wx:if="{{item.cells.length}}" class="sw-kv">
            <view class="sw-cell" wx:for="{{item.cells}}" wx:for-item="c" wx:key="index">
              <view class="sw-k">{{c.k}}</view>
              <view class="sw-v">{{c.v}}</view>
              <view wx:if="{{c.note}}" class="sw-note">{{c.note}}</view>
            </view>
          </view>
          <view wx:if="{{item.pit}}" class="pit">
            <view class="pit-t">{{item.pit}}</view>
            <view wx:if="{{item.fix}}" class="pit-f"><text class="pit-b">怎么避免：</text>{{item.fix}}</view>
          </view>
          <view wx:if="{{item.tip}}" class="sw-key {{item.tipCls}}"><text class="sw-key-b">{{item.tipLabel}}</text>{{item.tip}}</view>
          <view wx:if="{{item.hint}}" class="sw-hint"><text>上划继续</text><text class="sw-hint-arrow">↑</text></view>
        </view>

        <!-- 装修 · 价条 / 购房 · 关键数字卡（总账对比条也用它） -->
        <view wx:elif="{{item.t === 'pricebar'}}" class="pricebar {{item.bad ? 'bad' : ''}} {{item.ok ? 'ok' : ''}}">
          <view class="pb-k">{{item.label}}</view>
          <view class="pb-v">{{item.value}}</view>
          <view wx:if="{{item.bar}}" class="t-bar">
            <view class="t-base" style="width: {{item.bar.base}}%"></view>
            <view wx:if="{{item.bar.over}}" class="t-over" style="width: {{item.bar.over}}%"></view>
          </view>
          <view wx:if="{{item.note}}" class="pb-n">{{item.note}}</view>
        </view>

        <!-- 装修 · 合同清单分组 / 购房 · 签约深坑清单（12 项分四组） -->
        <view wx:elif="{{item.t === 'clSec'}}" class="cl-sec">
          <view class="cl-sec-h">
            <text class="cl-sec-t">{{item.title}}</text>
            <text class="cl-sec-x">{{item.count}}</text>
          </view>
          <view class="cl-row" wx:for="{{item.rows}}" wx:for-item="r" wx:key="index">
            <view class="cl-top">
              <text class="cl-n">{{r.name}}</text>
              <view class="pill {{r.pillCls}}">{{r.pill}}</view>
            </view>
            <view class="cl-why">{{r.why}}</view>
            <view wx:if="{{r.write}}" class="cl-write"><text class="cl-write-b">写清：</text>{{r.write}}</view>
            <view wx:elif="{{r.noNote}}" class="cl-write">{{r.noNote}}</view>
            <view class="cl-acts">
              <view class="cl-btn {{r.doOn ? 'on' : ''}}" data-act="{{r.doAction}}" bindtap="onAction">{{r.doLabel}}</view>
              <view class="cl-btn {{r.noOn ? 'on-no' : ''}}" data-act="{{r.noAction}}" bindtap="onAction">{{r.noLabel}}</view>
            </view>
          </view>
        </view>

        <!-- 装修 · 增项单 / 半包自购踩坑 -->
        <view wx:elif="{{item.t === 'burst'}}" class="burst">
          <view class="burst-t">
            <text>{{item.title}}</text>
            <text class="burst-src">{{item.src}}</text>
          </view>
          <view class="adj" wx:for="{{item.items}}" wx:for-item="b" wx:key="index">
            <view class="adj-hd">
              <text>{{b.no}} · {{b.stage}} 阶段</text>
              <text class="adj-no">第 {{b.day}} 天</text>
            </view>
            <view class="adj-line" wx:for="{{b.lines}}" wx:for-item="ln" wx:key="index">
              <text>{{ln.k}}</text>
              <text class="adj-line-v">{{ln.v}}</text>
            </view>
            <view class="adj-sum"><text>小计</text><text>{{b.sum}}</text></view>
          </view>
          <view wx:if="{{item.restText}}" class="adj-more"><text>{{item.restText}}</text><text>{{item.restSum}}</text></view>
          <view class="adj-hint">{{item.hint}}</view>
          <view class="adj-hint burst-total">本次 {{item.total}}</view>
        </view>

        <!-- 柱图（总账：柱高 = 该节点常规周期，红 = 这一步爆了雷） -->
        <block wx:elif="{{item.t === 'gantt'}}">
          <view class="gantt">
            <view class="gantt-i {{b.hot ? 'hot' : ''}}" style="height: {{b.h}}rpx" wx:for="{{item.items}}" wx:for-item="b" wx:key="index"></view>
          </view>
          <view class="gantt-x">
            <text wx:for="{{item.labels}}" wx:for-item="lb" wx:key="index">{{lb}}</text>
          </view>
        </block>

        <!-- 提示条 -->
        <view wx:elif="{{item.t === 'note'}}" class="ok-note">
          <text wx:if="{{item.bold}}" class="ok-b">{{item.bold}}</text>{{item.text}}
        </view>

        <!-- 自定义现金表单 -->
        <view wx:elif="{{item.t === 'form-cash'}}" class="card form-card">
          <view class="f-label">或自定义金额（万元，直接填写即可）</view>
          <input
            class="f-input"
            type="digit"
            value="{{formCash}}"
            placeholder="比如 150"
            bindinput="onCashInput"
          />
        </view>

        <!-- 自定义房源表单 -->
        <view wx:elif="{{item.t === 'form-custom'}}" class="card form-card">
          <view class="field">
            <view class="f-label">挂牌价（万元，示例：450）</view>
            <input class="f-input" type="digit" value="{{custPrice}}" placeholder="450" data-field="custPrice" bindinput="onCustInput" />
          </view>
          <view class="field">
            <view class="f-label">建筑面积（㎡，用于契税分档：≤140㎡ 税低）</view>
            <input class="f-input" type="digit" value="{{custArea}}" placeholder="90" data-field="custArea" bindinput="onCustInput" />
          </view>
          <view wx:if="{{custBaseVisible}}" class="field">
            <view class="f-label">取得原值（万元，继承 / 赠与口径的差额计税用）</view>
            <input class="f-input" type="digit" value="{{custBase}}" placeholder="被继承人取得价，如 120" data-field="custBase" bindinput="onCustInput" />
          </view>
        </view>

        <!-- 装修 · 贷款年限切换 -->
        <view wx:elif="{{item.t === 'form-years'}}" class="years-bar">
          <text class="y-label">还款年限</text>
          <view class="btn-row years-row">
            <view
              class="btn {{y.active ? 'btn-ink' : 'btn-out'}} btn-years"
              data-act="{{y.action}}"
              bindtap="onAction"
              wx:for="{{item.items}}"
              wx:for-item="y"
              wx:key="index"
            >{{y.label}}</view>
          </view>
        </view>

        <!-- 首付档位（最低 / 30% / 50% / 全款） -->
        <view wx:elif="{{item.t === 'downSteps'}}" class="card ds-card">
          <view class="ds-head"><text class="ds-title">首付档位</text><text class="ds-min">最低 {{item.min}}</text></view>
          <view class="ds-row">
            <view
              class="ds-item {{s.active ? 'ds-item--on' : ''}}"
              data-act="{{s.action}}"
              bindtap="onAction"
              wx:for="{{item.items}}"
              wx:for-item="s"
              wx:key="index"
            >
              <view class="ds-t">{{s.label}}</view>
              <view class="ds-amt">{{s.amount}}</view>
            </view>
          </view>
        </view>

        <!-- 辅助按钮行（回退 / 次级动作） -->
        <view wx:elif="{{item.t === 'cta'}}" class="btn-row">
          <view class="btn {{c.cls}}" data-act="{{c.action}}" bindtap="onAction" wx:for="{{item.items}}" wx:for-item="c" wx:key="index">{{c.title}}<text wx:if="{{c.wait}}" class="btn-w">{{c.wait}}</text></view>
        </view>

        <!-- 交易凭证 · 风险确认记录 -->
        <view wx:elif="{{item.t === 'riskLog'}}" class="card risk-card">
          <view class="risk-card-title">📋 交易凭证 · 风险确认记录</view>
          <view class="risk-entry" wx:for="{{item.items}}" wx:for-item="rk" wx:key="index">
            <view class="rk-head">
              <view class="badge badge-warm">{{rk.tag}}</view>
              <text class="rk-ts">{{rk.ts}}</text>
            </view>
            <view class="rk-detail">{{rk.detail}}</view>
          </view>
        </view>
      </block>

      <!-- 主按钮（等待承诺写在按钮上：按下之前就知道要等多久） -->
      <view class="btn-row" wx:if="{{primary}}">
        <view
          class="btn {{primary.disabled ? 'btn-disabled' : (primary.cls || 'btn-ink')}}"
          data-act="{{primary.disabled ? '' : primary.action}}"
          bindtap="onAction"
        >{{primary.title}}<text wx:if="{{primary.wait}}" class="btn-w">{{primary.wait}}</text></view>
      </view>

      <view class="safe-bottom"></view>
    </view>
  </scroll-view>

  <!-- 底部弹层：付款确认（五个出款点；现金三段 + 违约警示 + 下一节点与常规周期） -->
  <view wx:if="{{modal.type === 'pay'}}" class="overlay" bindtap="onModalMask">
    <view class="sheet" catchtap="noop">
      <view class="sheet-tag">💳 付款确认</view>
      <view class="sheet-title">{{modal.pay.title}}</view>
      <view class="m-amt">
        <view class="ma-cell">
          <text class="ma-k">{{modal.pay.nowLabel}}</text>
          <text class="ma-v num">{{modal.pay.now}} 万</text>
        </view>
        <text class="ma-arrow">→</text>
        <view class="ma-cell">
          <text class="ma-k">{{modal.pay.payLabel}}</text>
          <text class="ma-v num pay">{{modal.pay.pay}} 万</text>
        </view>
        <text class="ma-arrow">→</text>
        <view class="ma-cell">
          <text class="ma-k">{{modal.pay.afterLabel}}</text>
          <text class="ma-v num">{{modal.pay.after}} 万</text>
        </view>
      </view>
      <view class="sheet-desc">{{modal.pay.note}}</view>
      <view wx:if="{{modal.pay.warn}}" class="pay-warn">
        <text class="pay-warn-flag">🚨 违约风险</text>
        <text class="pay-warn-text">{{modal.pay.warn}}</text>
      </view>
      <view class="m-next">
        <view class="m-next-row">
          <text class="m-next-k">下一节点</text>
          <text class="m-next-name">{{modal.pay.nextName}}</text>
          <text class="m-next-d">{{modal.pay.nextReal}}</text>
        </view>
        <view class="m-next-w">{{modal.pay.nextWait}}</view>
      </view>
      <view class="sheet-actions">
        <view class="btn btn-out" data-act="payCancel" bindtap="onAction">再想想</view>
        <view class="btn btn-ink" data-act="payOk" bindtap="onAction">确认支付 {{modal.pay.pay}} 万</view>
      </view>
    </view>
  </view>
</view>