<!-- 状态流转规则 · 纯静态规则页（对齐设计稿「05 状态流转规则」屏） -->
<view class="rules-page">
  <!-- 卡1：统一 5 态 -->
  <view class="rule-card">
    <view class="ic-title">统一 5 态</view>
    <view class="rule-intro">四条分享获客链路的客户线索，统一映射为 5 个状态，与 admin 获客中心（UnifiedLeadStatus）口径一致，员工端与管理端对同一客户认知一致。</view>
    <view class="stg-list">
      <text class="stg stg-new">新线索</text>
      <text class="stg stg-contact">已联系</text>
      <text class="stg stg-high">意向高</text>
      <text class="stg stg-won">已转化</text>
      <text class="stg stg-out">已淘汰</text>
    </view>
  </view>

  <!-- 卡2：各模块原生状态映射 -->
  <view class="rule-card">
    <view class="ic-title">各模块原生状态映射</view>
    <view class="map-rows">
      <view class="map-row">
        <view class="map-mod">
          <view class="lc-mod"><view class="mdot mdot-rust"></view><text>估价</text></view>
        </view>
        <view class="map-arrows">
          <view class="map-pair">待评估 <text class="arr">→</text> <text class="pair-target">新线索</text></view>
          <view class="map-pair">待看房 <text class="arr">→</text> <text class="pair-target">已联系</text></view>
          <view class="map-pair">已看房 <text class="arr">→</text> <text class="pair-target">意向高</text></view>
          <view class="map-pair">已签约 <text class="arr">→</text> <text class="pair-target">已转化</text></view>
          <view class="map-pair">已放弃 / 他司成交 <text class="arr">→</text> <text class="pair-target">已淘汰</text></view>
        </view>
      </view>
      <view class="map-row">
        <view class="map-mod">
          <view class="lc-mod"><view class="mdot mdot-blue"></view><text>预约</text></view>
        </view>
        <view class="map-arrows">
          <view class="map-pair">原生即统一 5 态 <text class="arr">→</text> <text class="pair-target">无需映射</text></view>
          <view class="map-pair">展示标签：已预约 / 已联系 / 已带看 / 已关闭</view>
        </view>
      </view>
      <view class="map-row">
        <view class="map-mod">
          <view class="lc-mod"><view class="mdot mdot-graphite"></view><text>房源单</text></view>
        </view>
        <view class="map-arrows">
          <view class="map-pair">复用估价状态机 <text class="arr">→</text> <text class="pair-target">同估价</text></view>
          <view class="map-pair">来源标识：source_property_id 非空</view>
        </view>
      </view>
      <view class="map-row">
        <view class="map-mod">
          <view class="lc-mod"><view class="mdot mdot-teal"></view><text>招募</text></view>
        </view>
        <view class="map-arrows">
          <view class="map-pair">原生即统一 5 态 <text class="arr">→</text> <text class="pair-target">无需映射</text></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 卡3：自动流转与归属规则 -->
  <view class="rule-card">
    <view class="ic-title">自动流转与归属规则</view>
    <view class="auto-rules">
      <view class="auto-rule">
        <text class="no">1</text>
        <text class="auto-rule-text"><text class="rt-strong">查看即联系</text>：点击「查看完整号码」后，「新线索」自动流转为「已联系」，与招募 mine 页既有行为一致，且不可逆。</text>
      </view>
      <view class="auto-rule">
        <text class="no">2</text>
        <text class="auto-rule-text"><text class="rt-strong">归属规则</text>：客户归属以<text class="rt-strong">首次留资</text>时的分享归属员工（referrer）为准，后续流转不改变归属。</text>
      </view>
      <view class="auto-rule">
        <text class="no">3</text>
        <text class="auto-rule-text"><text class="rt-strong">内部过滤</text>：内部员工自己提交 / 录入的线索不进入「我的客户」列表（与 admin 获客中心 internal_creator 过滤一致）。</text>
      </view>
      <view class="auto-rule">
        <text class="no">4</text>
        <text class="auto-rule-text"><text class="rt-strong">订阅提醒</text>：新留资与状态被后台变更时，通过微信订阅消息通知归属员工。</text>
      </view>
    </view>
  </view>
</view>
