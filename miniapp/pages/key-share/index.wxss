/* 钥匙分享 · 经纪人访客页（设计稿 D1/D2，严格对齐 DESIGN.md Steep 体系）
   卡片：24px→48rpx 圆角 / 20-24px→40-48rpx 内边距 / 签名三层阴影（描边环+主投影+微投影）
   分隔靠 surface tint 与圆角，不加重描边；次要动作用文字链，每屏至多一个实心按钮 */
.page {
  --card-shadow: rgba(4, 23, 43, 0.05) 0 0 0 2rpx, rgba(0, 0, 0, 0.1) 0 40rpx 50rpx -10rpx,
    rgba(0, 0, 0, 0.1) 0 16rpx 20rpx -12rpx;
  min-height: 100vh;
  background: var(--fog);
  padding-bottom: 48rpx;
  letter-spacing: -0.009em;
}

/* ===== 状态盒（loading / 占位 / 网络错误 / 回收态 互斥渲染） ===== */
.state-box {
  min-height: 80vh;
  padding: 0 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.state-text {
  font-size: 28rpx;
  font-weight: 430;
  color: var(--ink);
}

.state-title {
  margin-top: 32rpx;
  font-size: 34rpx;
  font-weight: 500;
  color: var(--ink);
}

.state-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 430;
  color: var(--graphite);
  text-align: center;
  line-height: 1.5;
}

/* 实心主操作（DESIGN.md Filled Dark CTA：Ink 底白字 pill，每态唯一） */
.btn-dark {
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  padding: 0 64rpx;
  border-radius: 9999rpx;
  background: var(--ink);
  color: var(--pure-white);
  font-size: 28rpx;
  font-weight: 450;
  line-height: 1;
}
.btn-dark::after {
  border: none;
}
.state-btn {
  margin-top: 44rpx;
}

/* D2 锁形圆卡（SVG 锁以 emoji 代替，简单为主） */
.lock-badge {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--pure-white);
  box-shadow: var(--card-shadow);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
}

/* ===== 过期提示条（Warm Tint 提醒面，过期后不可查看） ===== */
.expired-banner {
  margin: 24rpx 40rpx 0;
  padding: 24rpx 40rpx;
  border-radius: 24rpx;
  background: var(--apricot-wash);
  color: var(--rust);
  font-size: 24rpx;
  font-weight: 450;
  line-height: 1.5;
}

/* ===== 白卡（DESIGN.md Product Dashboard Card：白面 / 48rpx 圆角 / 签名阴影，无重描边） ===== */
.sharer-card {
  margin: 24rpx 40rpx 0;
  padding: 40rpx;
  background: var(--pure-white);
  border-radius: 48rpx;
  box-shadow: var(--card-shadow);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

/* 圆形首字头像（Apricot Wash 底，占位首字，对齐 Avatar Badge） */
.sharer-avatar {
  width: 80rpx;
  height: 80rpx;
  flex: none;
  border-radius: 50%;
  background: var(--apricot-wash);
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sharer-main {
  flex: 1;
  min-width: 0;
}

.sharer-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
  line-height: 1.4;
}

.sharer-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 430;
  color: var(--graphite);
}

/* ===== chip（9999px tags） ===== */
.chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
  padding: 8rpx 18rpx;
  border-radius: 9999rpx;
  white-space: nowrap;
  flex: none;
}
.chip--active {
  background: var(--apricot-wash);
  color: var(--rust);
}
.chip--mute {
  background: var(--fog);
  color: var(--graphite);
}
.cdot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.75;
}

/* ===== 带看注意事项（AI Response Card 模式：白卡卡头标题 + Apricot 内层块承载内容） ===== */
.notice-card {
  margin: 24rpx 40rpx 0;
  padding: 40rpx;
  background: var(--pure-white);
  border-radius: 48rpx;
  box-shadow: var(--card-shadow);
}
.notice-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 24rpx;
}
.notice-item {
  padding: 24rpx 32rpx;
  border-radius: 32rpx;
  background: var(--apricot-wash);
}
.notice-item + .notice-item {
  margin-top: 16rpx;
}
.notice-addr {
  font-size: 24rpx;
  font-weight: 450;
  color: var(--rust);
  opacity: 0.75;
}
.notice-text {
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 430;
  line-height: 1.5;
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-all;
}

/* ===== 房源密码列表卡 ===== */
.key-card {
  margin: 24rpx 40rpx 0;
  padding: 16rpx 40rpx;
  background: var(--pure-white);
  border-radius: 48rpx;
  box-shadow: var(--card-shadow);
}

.key-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--fog);
}
.key-row:last-child {
  border-bottom: none;
}

.key-info {
  flex: 1;
  min-width: 0;
}

.key-addr {
  font-size: 28rpx;
  font-weight: 480;
  color: var(--ink);
  line-height: 1.45;
}

.key-project {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 430;
  color: var(--graphite);
}

.key-pw {
  flex: none;
  max-width: 60%;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

/* 掩码行：****** + 查看入口 */
.pw-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pw-mask {
  font-size: 28rpx;
  font-weight: 480;
  letter-spacing: 6rpx;
  color: var(--ink);
}

/* Rust 强调文字链（已看过 = 文字链；未看 = Fog 底 pill 按钮） */
.mlink {
  font-size: 26rpx;
  font-weight: 450;
  color: var(--rust);
  padding: 4rpx 8rpx;
}

.view-btn {
  padding: 12rpx 28rpx;
  border-radius: 9999rpx;
  background: var(--apricot-wash);
  color: var(--rust);
  font-size: 24rpx;
  font-weight: 450;
  line-height: 1;
}

/* 明文：等宽大字（对齐 keys 模块 pw-reveal） */
.pw-reveal {
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-size: 44rpx;
  font-weight: 500;
  letter-spacing: 10rpx;
  color: var(--ink);
  line-height: 1.2;
}

.reveal-mark {
  font-size: 22rpx;
  font-weight: 450;
  color: var(--rust);
}

.pw-note {
  font-size: 22rpx;
  font-weight: 430;
  color: var(--graphite);
}

.list-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  font-weight: 430;
  color: var(--graphite);
}

/* ===== 页脚常驻说明（辅助卡：白面 / 48rpx 圆角，Graphite 辅助文字） ===== */
.mnote {
  margin: 24rpx 40rpx 0;
  padding: 28rpx 40rpx;
  border-radius: 48rpx;
  background: var(--pure-white);
  box-shadow: var(--card-shadow);
  color: var(--graphite);
  font-size: 24rpx;
  font-weight: 430;
  line-height: 1.5;
}

/* 次要动作 = 文字链（DESIGN.md：不用 ghost 按钮承载次要操作） */
.more-btn {
  margin: 24rpx 40rpx 0;
  padding: 24rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 450;
}
