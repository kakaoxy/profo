<view class="page">
  <!-- 加载态 -->
  <view wx:if="{{loading}}" class="state-box">
    <view class="state-text">加载中…</view>
  </view>

  <!-- 游客 / 空态 -->
  <view wx:elif="{{empty}}" class="empty">
    <view class="e-ill">
      <view class="e-glow"></view>
      <view class="e-card">
        <view class="e-row">
          <view class="e-dot"></view>
          <view class="e-bar" style="width: 176rpx"></view>
        </view>
        <view class="e-row">
          <view class="e-dot e-dot--2"></view>
          <view class="e-bar e-bar--2" style="width: 124rpx"></view>
        </view>
        <view class="e-row">
          <view class="e-dot e-dot--3"></view>
          <view class="e-bar e-bar--3" style="width: 208rpx"></view>
        </view>
      </view>
      <view class="e-badge">+</view>
    </view>
    <view class="e-t">分享估价页给客户</view>
    <view class="e-s">
      <view>客户提交估价后自动生成线索</view>
      <view>展示联系方式，方便您跟进联系</view>
    </view>
    <button class="e-btn" bindtap="onGoShare">去分享估价页</button>
  </view>

  <!-- 有数据：统计卡 + 筛选 + 列表 -->
  <block wx:else>
    <!-- 统计卡（累计获客/待评估/待看房/已签约，已签约品牌蓝强调） -->
    <view class="stats">
      <view class="stat">
        <text class="stat-num">{{stats.total}}</text>
        <text class="stat-label">累计获客</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{stats.pendingAssessment}}</text>
        <text class="stat-label">待评估</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{stats.pendingVisit}}</text>
        <text class="stat-label">待看房</text>
      </view>
      <view class="stat stat--hl">
        <text class="stat-num">{{stats.signed}}</text>
        <text class="stat-label">已签约</text>
      </view>
    </view>

    <!-- 状态筛选 chips（横向滑动） -->
    <scroll-view class="chips" scroll-x enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{chips}}"
        wx:key="value"
        class="chip-item {{activeStatus === item.value ? 'chip-item--on' : ''}}"
        data-value="{{item.value}}"
        bindtap="onChipTap"
      >{{item.label}}</view>
    </scroll-view>

    <!-- 获客列表 -->
    <view class="leads">
      <view wx:for="{{items}}" wx:key="id" class="lead">
        <view class="l-top">
          <text class="l-name">{{item.communityName}}</text>
          <text class="l-tag" style="color:{{item.statusColor}};background:{{item.statusBackground}}">{{item.statusText}}</text>
        </view>
        <view class="l-main">
          <text class="l-layout">{{item.desc}}</text>
          <text class="l-src {{item.sourceClass}}">{{item.sourceText}}</text>
        </view>
        <view class="l-foot">
          <view class="l-left">
            <text class="l-phone {{item.phoneFull ? 'l-phone--full' : ''}} {{item.hasPhone ? '' : 'l-phone--empty'}}">{{item.phoneFull || item.phone}}</text>
            <text class="l-time">{{item.timeText}}</text>
          </view>
          <view
            wx:if="{{item.hasPhone}}"
            class="l-contact {{item.phoneFull ? 'l-contact--plain' : ''}}"
            data-id="{{item.id}}"
            bindtap="onContactTap"
          >{{item.phoneFull ? "拨打" : "联系客户"}}</view>
        </view>
      </view>

      <view wx:if="{{!loading && items.length === 0}}" class="leads-empty">当前筛选暂无获客线索</view>
      <view wx:elif="{{loadingMore}}" class="more">加载中…</view>
      <view wx:elif="{{!noMore && items.length > 0}}" class="more">上拉加载更多</view>
      <view wx:elif="{{items.length > 0}}" class="more">没有更多了</view>
    </view>
  </block>

  <view class="safe-bottom"></view>
</view>
