/* 「我的评估」列表页 · 对齐 projects/list 暖色编辑风格 */

page {
  background-color: hsl(40, 16%, 98%);
}

.page {
  --warm-bg: hsl(40, 16%, 98%);
  --warm-fg: hsl(37.5, 15.69%, 20%);
  --warm-muted-fg: hsl(36, 19.84%, 49.41%);
  --warm-muted: hsl(44, 26.32%, 88.82%);
  --warm-accent: hsl(40, 24.09%, 73.14%);
  --warm-border: hsl(43.33, 23.08%, 84.71%);

  min-height: 100vh;
  background-color: var(--warm-bg);
  color: var(--warm-fg);
  padding-bottom: 32rpx;
}

/* ===== 计数行 ===== */
.count-row {
  padding: 32rpx 40rpx 8rpx;
  font-size: 24rpx;
  letter-spacing: -0.13rpx;
  color: var(--warm-muted-fg);
}

/* ===== 评估卡片 ===== */
.list-card {
  margin: 24rpx 40rpx 0;
  padding: 40rpx;
  background-color: var(--warm-bg);
  border: 2rpx solid var(--warm-border);
  border-radius: 48rpx;
}
.list-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}
.list-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: -0.3rpx;
  line-height: 1.3;
  color: var(--warm-fg);
}
.badge {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 9999rpx;
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: -0.13rpx;
}
.list-desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  letter-spacing: -0.2rpx;
  color: var(--warm-muted-fg);
}
.list-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--warm-border);
}
.list-date {
  font-size: 24rpx;
  letter-spacing: -0.13rpx;
  color: var(--warm-muted-fg);
}
.chevron {
  font-size: 32rpx;
  color: var(--warm-muted-fg);
}

/* ===== 通用状态（加载/空/错误/未登录） ===== */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
}
.state__title {
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: -0.3rpx;
  color: var(--warm-fg);
  margin-bottom: 16rpx;
}
.state__text {
  font-size: 28rpx;
  letter-spacing: -0.2rpx;
  color: var(--warm-muted-fg);
  margin-bottom: 24rpx;
}
.state__btn {
  font-size: 28rpx;
  letter-spacing: -0.2rpx;
  color: var(--warm-bg);
  background-color: var(--warm-fg);
  border-radius: 9999rpx;
  padding: 16rpx 48rpx;
  font-weight: 500;
}

/* ===== 底部加载更多 ===== */
.footer {
  padding: 32rpx 40rpx;
  text-align: center;
}
.footer__text {
  font-size: 28rpx;
  letter-spacing: -0.2rpx;
  color: var(--warm-muted-fg);
}
.footer__end {
  display: inline-flex;
  align-items: center;
  gap: 20rpx;
  font-size: 24rpx;
  letter-spacing: -0.13rpx;
  color: var(--warm-muted-fg);
}
.footer__end::before,
.footer__end::after {
  content: "";
  width: 64rpx;
  height: 2rpx;
  background: var(--warm-border);
}