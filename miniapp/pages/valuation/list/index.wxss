/* 「我的评估」列表页 · Steep 设计体系（与 evaluate 同源：Fog 画布 + lcard/stag/fresh 令牌） */

page {
  background-color: #f7f7f8;
}

.page {
  --ink: #17191c;
  --ink2: #4c4c4c;
  --ink3: #a3a6af;
  --line: #e6e8ec;
  --fog: #f7f7f8;
  --amber: #5d2a1a;
  --amberw: rgba(93, 42, 26, 0.07);
  --green: #2f5f96;
  --greenw: #d3e3fc;
  --rust: #5d2a1a;
  --apricot: #fbe1d1;

  min-height: 100vh;
  background-color: var(--fog);
  color: var(--ink);
  padding-bottom: 32rpx;
  box-sizing: border-box;
}

/* ===== 统计条 ===== */
.evalmeta {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 28rpx 40rpx 8rpx;
}
.evalmeta__big {
  font-size: 30rpx;
  font-weight: 700;
}
.evalmeta__num {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

/* ===== 授权价提醒授权入口（nbanner 语义：Apricot 洗底 + 圆角） ===== */
.notify-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 12rpx 32rpx 0;
  padding: 24rpx 32rpx;
  background-color: var(--apricot);
  border-radius: 32rpx;
}
.notify-banner__text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--rust);
}
.notify-banner__action {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--rust);
}

/* ===== 线索卡片（与 evaluate 同源的 lcard 骨架） ===== */
.lcard {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 26rpx 30rpx;
  margin: 0 32rpx 22rpx;
  box-shadow: 0 4rpx 20rpx rgba(23, 25, 28, 0.04);
}
.lcard__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.lcard__nm {
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-right: 16rpx;
}
.stag {
  flex-shrink: 0;
  font-size: 21rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 14rpx;
}
.stag--amber {
  color: var(--amber);
  background: var(--amberw);
}
.stag--green {
  color: var(--green);
  background: var(--greenw);
}
/* 已签约实底档 */
.stag--ink {
  color: #ffffff;
  background: var(--ink);
}
.stag--gray {
  color: var(--ink2);
  background: #eef0f3;
}
.stag--rust {
  color: var(--rust);
  background: var(--apricot);
}
.lcard__mid {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 22rpx;
}
.thumb {
  width: 92rpx;
  height: 92rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  background: #eceef2;
}
.attrs {
  flex: 1;
  min-width: 0;
}
.attrs__l1 {
  font-size: 25rpx;
  color: var(--ink2);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.attrs__l2 {
  font-size: 22rpx;
  color: var(--ink3);
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.pricest {
  text-align: right;
  flex-shrink: 0;
}
.pricest__lb {
  font-size: 20rpx;
  color: var(--ink3);
}
.pricest__vl {
  font-size: 34rpx;
  font-weight: 800;
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}
.pricest__unit {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ink2);
  margin-left: 2rpx;
}
.pricest__vl--ok {
  color: var(--green);
}
.lcard__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
  min-height: 54rpx;
  box-sizing: content-box;
}
.lcard__meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.time {
  font-size: 21rpx;
  color: var(--ink3);
}

/* ===== 时效标签（与 evaluate 同源：三态 + 圆点；终态不渲染） ===== */
.fresh {
  height: 54rpx;
  padding: 0 26rpx;
  border-radius: 9999rpx;
  font-size: 23rpx;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  white-space: nowrap;
}
.fresh__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.fresh--ok {
  background: var(--greenw);
  color: var(--green);
}
.fresh--ok .fresh__dot {
  background: var(--green);
}
.fresh--soon {
  background: var(--apricot);
  color: var(--rust);
}
.fresh--soon .fresh__dot {
  background: var(--rust);
}
.fresh--over {
  background: var(--rust);
  color: #ffffff;
}
.fresh--over .fresh__dot {
  background: #ffffff;
}

/* ===== 通用状态（加载/空/错误/未登录） ===== */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
}
.state__title {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: -0.3rpx;
  color: var(--ink);
  margin-bottom: 16rpx;
}
.state__text {
  font-size: 26rpx;
  letter-spacing: -0.2rpx;
  color: var(--ink3);
  margin-bottom: 24rpx;
}
.state__btn {
  font-size: 26rpx;
  letter-spacing: -0.2rpx;
  color: #ffffff;
  background-color: var(--ink);
  border-radius: 9999rpx;
  padding: 18rpx 52rpx;
  font-weight: 600;
}

/* ===== 底部加载更多 ===== */
.footer {
  padding: 32rpx 40rpx;
  text-align: center;
}
.footer__text {
  font-size: 23rpx;
  letter-spacing: -0.2rpx;
  color: var(--ink3);
}
.footer__end {
  display: inline-flex;
  align-items: center;
  gap: 20rpx;
  font-size: 23rpx;
  letter-spacing: -0.13rpx;
  color: var(--ink3);
}
.footer__end::before,
.footer__end::after {
  content: "";
  width: 64rpx;
  height: 2rpx;
  background: var(--line);
}
