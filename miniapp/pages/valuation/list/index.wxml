<view class="page">
  <!-- 统计条（对齐 evaluate 的 evalmeta） -->
  <view class="evalmeta" wx:if="{{!needLogin && !internalOnly && !error && items.length > 0}}">
    <view class="evalmeta__big">共 <text class="evalmeta__num">{{total}}</text> 条评估</view>
  </view>

  <!-- 授权价提醒授权入口（结构保留，令牌换 nbanner 语义：Apricot 洗底 + 圆角） -->
  <view
    class="notify-banner"
    wx:if="{{!needLogin && !internalOnly && !error && notifyBanner}}"
    bindtap="onSubscribeTap"
  >
    <text class="notify-banner__text">开启提醒，授权价出来或调整后第一时间通知您</text>
    <text class="notify-banner__action">开启 ›</text>
  </view>

  <!-- 未登录态 -->
  <view class="state" wx:if="{{needLogin}}">
    <view class="state__title">登录已失效</view>
    <view class="state__text">请先登录后查看我的评估</view>
    <view class="state__btn" bindtap="onGoLogin">去登录</view>
  </view>

  <!-- 内部员工限定态 -->
  <view class="state" wx:if="{{!needLogin && internalOnly}}">
    <view class="state__text">内部员工暂无法在端内查看我的评估</view>
  </view>

  <!-- 错误态 -->
  <view class="state" wx:if="{{!needLogin && !internalOnly && error}}">
    <view class="state__text">加载失败，请重试</view>
    <view class="state__btn" bindtap="onRetry">重试</view>
  </view>

  <!-- 首次加载态 -->
  <view class="state" wx:if="{{!needLogin && !internalOnly && !error && loading && items.length === 0}}">
    <view class="state__text">加载中...</view>
  </view>

  <!-- 列表区（lcard 骨架：top 状态标签 / mid 缩略图+参数+价格栈 / foot 时间+时效标签） -->
  <block wx:if="{{!needLogin && !internalOnly && !error}}">
    <view
      class="lcard"
      wx:for="{{items}}"
      wx:key="id"
      bindtap="onItemTap"
      data-id="{{item.id}}"
    >
      <view class="lcard__top">
        <view class="lcard__nm">{{item.name}}</view>
        <view class="stag stag--{{item.tagClass}}">{{item.tagText}}</view>
      </view>
      <view class="lcard__mid">
        <image class="thumb" wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" lazy-load />
        <view class="thumb thumb--empty" wx:else></view>
        <view class="attrs">
          <view class="attrs__l1">{{item.l1}}</view>
          <view class="attrs__l2" wx:if="{{item.l2}}">{{item.l2}}</view>
        </view>
        <view class="pricest">
          <view class="pricest__lb">{{item.priceLabel}}</view>
          <view class="pricest__vl {{item.priceOk ? 'pricest__vl--ok' : ''}}">
            {{item.priceValue}}<text class="pricest__unit" wx:if="{{item.priceUnit}}">{{item.priceUnit}}</text>
          </view>
        </view>
      </view>
      <view class="lcard__foot">
        <view class="lcard__meta">
          <view class="time">{{item.timeText}}</view>
        </view>
        <view class="fresh fresh--{{item.freshClass}}" wx:if="{{item.freshClass}}">
          <view class="fresh__dot"></view>{{item.freshText}}
        </view>
      </view>
    </view>

    <!-- 空态：已登录且无记录 -->
    <view class="state" wx:if="{{!loading && items.length === 0 && total === 0}}">
      <view class="state__text">暂无评估记录</view>
      <view class="state__btn" bindtap="onGoValuation">去估价</view>
    </view>

    <!-- 底部加载更多 -->
    <view class="footer" wx:if="{{items.length > 0}}">
      <view class="footer__text" wx:if="{{loadingMore}}">加载中...</view>
      <view class="footer__end" wx:elif="{{noMore}}">没有更多了</view>
    </view>
  </block>

  <!-- 底部留白，避让原生 TabBar -->
  <view style="height: 240rpx;"></view>
</view>
