.page {
  --brand: #2563eb;
  --brand-weak: #eef4ff;
  --shadow-sm: 0 4rpx 20rpx -6rpx rgba(0, 0, 0, 0.08);
  min-height: 100vh;
  background: var(--fog);
  padding-bottom: 200rpx;
}

.form-head {
  padding: 16rpx 40rpx 32rpx;
}

/* 头部行：免费估价 chip + 计数 banner 同行排列 */
.head-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 8rpx 0 16rpx;
}

/* 强化 chip 独立性：加边框 + 不允许压缩 */
.chip--bordered {
  border: 2rpx solid var(--rust);
  flex-shrink: 0;
}

/* 累计估价报告计数 banner：作为同行轻量子项 */
.lead-count-banner {
  flex: 1;
  min-width: 0;
  padding: 10rpx 24rpx;
  background: var(--apricot-wash);
  border-radius: 9999rpx;
  color: var(--rust);
  font-size: 24rpx;
  line-height: 1.4;
  text-align: left;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.lead-count-banner__num {
  font-weight: 600;
  font-size: 28rpx;
  margin-right: 4rpx;
}

.form-title {
  font-size: 44rpx;
  font-weight: 600;
  margin: 20rpx 0 16rpx;
  line-height: 1.3;
}

.form-sub {
  font-size: 26rpx;
  color: var(--graphite);
  line-height: 1.6;
}

/* 手机号 banner */
.phone-banner {
  margin: 0 40rpx 32rpx;
  padding: 24rpx 28rpx;
  background: var(--apricot-wash);
  border-radius: 28rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.phone-banner__text {
  color: var(--ink);
  flex: 1;
}

.phone-banner__action {
  color: var(--rust);
  font-weight: 500;
  white-space: nowrap;
}

/* 员工专属区块（仅内部员工展示；样式对齐招募落地页底部区块） */
.share-tip {
  margin: 24rpx 40rpx 0;
  background: var(--pure-white);
  border-radius: 48rpx;
  padding: 32rpx 40rpx;
  box-shadow: var(--shadow-sm);
}
.share-tip-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 12rpx;
}
.share-tip-sub {
  font-size: 26rpx;
  color: var(--graphite);
  line-height: 1.6;
}
.staff-divider {
  height: 2rpx;
  background: var(--fog);
  margin: 24rpx 0 20rpx;
}
.clue-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 8rpx 0 4rpx;
}
.clue-ic {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: var(--brand-weak);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.clue-ic-line {
  width: 30rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--brand);
}
.clue-ic-line--short {
  width: 20rpx;
}
.clue-tt {
  flex: 1;
  min-width: 0;
}
.clue-tt-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}
.clue-tt-sub {
  font-size: 22rpx;
  color: var(--graphite);
  margin-top: 6rpx;
}
.clue-chev {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  border-right: 4rpx solid #c3c7cf;
  border-top: 4rpx solid #c3c7cf;
  transform: rotate(45deg);
}
.staff-btn-row {
  display: flex;
  gap: 20rpx;
  padding-top: 20rpx;
}
.staff-btn {
  flex: 1;
  height: 88rpx;
  border: none;
  border-radius: 9999rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  padding: 0;
  margin: 0;
}
.staff-btn::after {
  border: none;
}
.staff-btn--pri {
  background: var(--brand);
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(37, 99, 235, 0.25);
}

/* 底部安全区留白（避让原生 tabBar） */
.safe-bottom {
  height: 64rpx;
}

.form-page {
  padding: 0 40rpx;
}

.form-group {
  margin-bottom: 40rpx;
  position: relative;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-row .input {
  flex: 1;
}

/* 户型三段输入 */
.layout-row {
  display: flex;
  gap: 20rpx;
}

.layout-seg {
  position: relative;
  flex: 1;
}

.layout-input {
  width: 100%;
  height: 104rpx;
  padding: 0 64rpx 0 32rpx;
  border: 2rpx solid var(--dove);
  border-radius: 32rpx;
  background: var(--pure-white);
  font-size: 30rpx;
  text-align: center;
  color: var(--ink);
  box-sizing: border-box;
}

.layout-suffix {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 26rpx;
  color: var(--graphite);
}

/* 朝向直接选择 */
.orientation-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.orientation-option {
  min-width: 152rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  padding: 0 28rpx;
  border: 2rpx solid var(--dove);
  border-radius: 9999rpx;
  background: var(--pure-white);
  color: var(--ink);
  font-size: 30rpx;
  box-sizing: border-box;
}

.orientation-option:active {
  background: var(--fog);
}

.orientation-option--active {
  border-color: var(--rust);
  background: var(--apricot-wash);
  color: var(--rust);
  font-weight: 500;
}

/* 户型图上传 */
.photo-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.photo-head .form-label {
  margin-bottom: 0;
}

.photo-count {
  font-size: 24rpx;
  color: var(--graphite);
}

.photo-grid {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.photo-thumb-wrap {
  position: relative;
  width: 176rpx;
  height: 176rpx;
}

.photo-thumb {
  width: 100%;
  height: 100%;
  border-radius: 32rpx;
}

.photo-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(23, 25, 28, 0.6);
  color: #ffffff;
  font-size: 28rpx;
}

.photo-upload {
  width: 176rpx;
  height: 176rpx;
  border-radius: 32rpx;
  border: 2rpx dashed var(--dove);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: var(--graphite);
  font-size: 24rpx;
  background: var(--pure-white);
}

.photo-upload__icon {
  font-size: 36rpx;
}

/* 补充信息 textarea */
.textarea {
  /* 真机上原生 textarea 会忽略 height:auto 回退到超大默认高度，须显式指定高度 */
  height: 200rpx;
  padding: 24rpx 32rpx;
  line-height: 1.5;
}

/* 提交按钮：水平居中（btn-primary 自带内边距与圆角） */
.submit-wrap {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
}

.risk-note {
  margin: 32rpx 0;
  font-size: 24rpx;
  color: var(--graphite);
  line-height: 1.6;
}
