.page {
  min-height: 100vh;
  background: var(--fog);
  padding-bottom: 200rpx;
}

.form-head {
  padding: 16rpx 40rpx 32rpx;
}

.form-title {
  font-size: 44rpx;
  font-weight: 600;
  margin: 20rpx 0 16rpx;
  line-height: 1.3;
}

.form-sub {
  font-size: 26rpx;
  color: var(--graphite);
  line-height: 1.6;
}

/* 手机号 banner */
.phone-banner {
  margin: 0 40rpx 32rpx;
  padding: 24rpx 28rpx;
  background: var(--apricot-wash);
  border-radius: 28rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.phone-banner__text {
  color: var(--ink);
  flex: 1;
}

.phone-banner__action {
  color: var(--rust);
  font-weight: 500;
  white-space: nowrap;
}

.phone-form {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.phone-input {
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--dove);
  border-radius: 24rpx;
  background: var(--pure-white);
  font-size: 30rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.phone-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

.phone-btn {
  height: 72rpx;
  padding: 0 40rpx;
  border-radius: 9999rpx;
  font-size: 28rpx;
  line-height: 72rpx;
}

.phone-btn--cancel {
  background: transparent;
  color: var(--graphite);
}

.phone-btn--cancel::after {
  border: none;
}

.phone-btn--save {
  background: var(--ink);
  color: #ffffff;
}

.phone-btn--save::after {
  border: none;
}

.form-page {
  padding: 0 40rpx;
}

.form-group {
  margin-bottom: 40rpx;
  position: relative;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-row .input {
  flex: 1;
}

/* 户型三段输入 */
.layout-row {
  display: flex;
  gap: 20rpx;
}

.layout-seg {
  position: relative;
  flex: 1;
}

.layout-input {
  width: 100%;
  height: 104rpx;
  padding: 0 64rpx 0 32rpx;
  border: 2rpx solid var(--dove);
  border-radius: 32rpx;
  background: var(--pure-white);
  font-size: 30rpx;
  text-align: center;
  color: var(--ink);
  box-sizing: border-box;
}

.layout-suffix {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 26rpx;
  color: var(--graphite);
}

/* 朝向直接选择 */
.orientation-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.orientation-option {
  min-width: 152rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  padding: 0 28rpx;
  border: 2rpx solid var(--dove);
  border-radius: 9999rpx;
  background: var(--pure-white);
  color: var(--ink);
  font-size: 30rpx;
  box-sizing: border-box;
}

.orientation-option:active {
  background: var(--fog);
}

.orientation-option--active {
  border-color: var(--rust);
  background: var(--apricot-wash);
  color: var(--rust);
  font-weight: 500;
}

/* 户型图上传 */
.photo-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.photo-head .form-label {
  margin-bottom: 0;
}

.photo-count {
  font-size: 24rpx;
  color: var(--graphite);
}

.photo-grid {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.photo-thumb-wrap {
  position: relative;
  width: 176rpx;
  height: 176rpx;
}

.photo-thumb {
  width: 100%;
  height: 100%;
  border-radius: 32rpx;
}

.photo-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(23, 25, 28, 0.6);
  color: #ffffff;
  font-size: 28rpx;
}

.photo-upload {
  width: 176rpx;
  height: 176rpx;
  border-radius: 32rpx;
  border: 2rpx dashed var(--dove);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: var(--graphite);
  font-size: 24rpx;
  background: var(--pure-white);
}

.photo-upload__icon {
  font-size: 36rpx;
}

/* 补充信息 textarea */
.textarea {
  /* 真机上原生 textarea 会忽略 height:auto 回退到超大默认高度，须显式指定高度 */
  height: 200rpx;
  padding: 24rpx 32rpx;
  line-height: 1.5;
}

/* 提交按钮：水平居中（btn-primary 自带内边距与圆角） */
.submit-wrap {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
}

.risk-note {
  margin: 32rpx 0;
  font-size: 24rpx;
  color: var(--graphite);
  line-height: 1.6;
}
