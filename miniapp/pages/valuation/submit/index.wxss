.page {
  min-height: 100vh;
  background: var(--fog);
  padding-bottom: 200rpx;
}

.form-head {
  padding: 16rpx 40rpx 32rpx;
}

.form-title {
  font-size: 44rpx;
  font-weight: 600;
  margin: 20rpx 0 16rpx;
  line-height: 1.3;
}

.form-sub {
  font-size: 26rpx;
  color: var(--graphite);
  line-height: 1.6;
}

.phone-banner {
  margin: 0 40rpx 32rpx;
  padding: 24rpx 28rpx;
  background: var(--sky-wash);
  color: #2a5ca0;
  border-radius: 28rpx;
  font-size: 26rpx;
}

.form-page {
  padding: 0 40rpx;
}

.form-group {
  margin-bottom: 40rpx;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-row .input {
  flex: 1;
}

.photo-grid {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.photo-thumb {
  width: 176rpx;
  height: 176rpx;
  border-radius: 32rpx;
}

.photo-upload {
  width: 176rpx;
  height: 176rpx;
  border-radius: 32rpx;
  border: 2rpx dashed var(--dove);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: var(--graphite);
  font-size: 24rpx;
  background: var(--pure-white);
}

.photo-upload__icon {
  font-size: 36rpx;
}

.submit-btn {
  width: 100%;
  margin-top: 24rpx;
}

.risk-note {
  margin: 32rpx 0;
  font-size: 24rpx;
  color: var(--graphite);
  line-height: 1.6;
}
