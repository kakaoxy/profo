<view class="page">
  <!-- 头部 -->
  <view class="form-head">
    <view class="head-row">
      <text class="chip chip-apricot chip--bordered">免费估价</text>
      <!-- 累计估价报告计数 banner -->
      <view class="lead-count-banner" wx:if="{{leadCountVisible}}">
        <block wx:if="{{leadCountLoading}}">···人已获取估价报告</block>
        <block wx:else><text class="lead-count-banner__num">{{leadCountDisplay}}</text>人已获取估价报告</block>
      </view>
    </view>
    <view class="form-title">在线估价，先看你的房子有没有溢价空间</view>
    <view class="form-sub">线上提交房源信息，我们先做初步估价。合适的会联系你安排上门看房，结合周边真实成交数据，再商定写进合同的约定价格。不签约不收费。</view>
  </view>

  <!-- 手机号完善 banner（未绑定手机号时展示；未登录时点击引导登录） -->
  <view wx:if="{{!hasPhone}}" class="phone-banner">
    <block wx:if="{{!editingPhone}}">
      <text class="phone-banner__text">完善手机号，加速评估速度</text>
      <text class="phone-banner__action" bindtap="onPhoneTap">完善手机号 ›</text>
    </block>
    <block wx:else>
      <view class="phone-form">
        <input
          class="phone-input"
          type="number"
          maxlength="11"
          value="{{phoneInput}}"
          placeholder="请输入11位手机号"
          bindinput="onPhoneInput"
        />
        <view class="phone-actions">
          <button class="phone-btn phone-btn--cancel" bindtap="onPhoneCancel">取消</button>
          <button class="phone-btn phone-btn--save" disabled="{{submittingPhone}}" bindtap="onPhoneConfirm">{{submittingPhone ? '保存中…' : '保存'}}</button>
        </view>
      </view>
    </block>
  </view>

  <!-- 表单 -->
  <view class="form-page">
    <!-- 小区名称（复用 community-search 组件，输入即搜索） -->
    <view class="form-group">
      <text class="form-label">小区名称</text>
      <community-search
        placeholder="请输入小区名称搜索"
        bind:change="onCommunityChange"
        bind:select="onCommunitySelect"
        bind:clear="onCommunityClear"
        bind:usequery="onCommunityUseQuery"
      />
    </view>

    <!-- 房源户型（室 / 厅 / 卫） -->
    <view class="form-group">
      <text class="form-label">房源户型</text>
      <view class="layout-row">
        <view class="layout-seg">
          <input class="layout-input" type="number" placeholder="0" value="{{layoutRoom}}" data-field="room" bindinput="onLayoutInput"/>
          <text class="layout-suffix">室</text>
        </view>
        <view class="layout-seg">
          <input class="layout-input" type="number" placeholder="0" value="{{layoutHall}}" data-field="hall" bindinput="onLayoutInput"/>
          <text class="layout-suffix">厅</text>
        </view>
        <view class="layout-seg">
          <input class="layout-input" type="number" placeholder="0" value="{{layoutToilet}}" data-field="toilet" bindinput="onLayoutInput"/>
          <text class="layout-suffix">卫</text>
        </view>
      </view>
    </view>

    <!-- 面积 -->
    <view class="form-group">
      <text class="form-label">面积（㎡）</text>
      <input class="input" placeholder="请输入建筑面积" type="digit" value="{{form.area}}" bindinput="onInput" data-field="area"/>
    </view>

    <!-- 朝向（直接选择） -->
    <view class="form-group">
      <text class="form-label">朝向</text>
      <view class="orientation-row">
        <view
          wx:for="{{orientationOptions}}"
          wx:key="*this"
          class="orientation-option {{form.orientation === item ? 'orientation-option--active' : ''}}"
          data-value="{{item}}"
          bindtap="onOrientationTap"
        >{{item}}</view>
      </view>
    </view>

    <!-- 楼层 / 总高 -->
    <view class="form-group">
      <text class="form-label">楼层 / 总高</text>
      <view class="form-row">
        <input class="input" placeholder="当前楼层" type="digit" value="{{form.floor}}" bindinput="onInput" data-field="floor"/>
        <input class="input" placeholder="总高" type="digit" value="{{form.total_floor}}" bindinput="onInput" data-field="total_floor"/>
      </view>
    </view>

    <!-- 户型图上传 -->
    <view class="form-group">
      <view class="photo-head">
        <text class="form-label">户型图上传</text>
        <text class="photo-count">{{form.images.length}}/6</text>
      </view>
      <view class="photo-grid">
        <view class="photo-thumb-wrap" wx:for="{{displayImages}}" wx:key="*this">
          <image class="photo-thumb" src="{{item}}" mode="aspectFill"/>
          <view class="photo-remove" data-index="{{index}}" bindtap="onRemoveImage">×</view>
        </view>
        <view class="photo-upload" bindtap="onChooseImage">
          <text class="photo-upload__icon">📷</text>
          <text>添加图片</text>
        </view>
      </view>
    </view>

    <!-- 心理预期价 -->
    <view class="form-group">
      <text class="form-label">心理预期价（万）</text>
      <input class="input" placeholder="可选填" type="digit" value="{{form.expected_price}}" bindinput="onInput" data-field="expected_price"/>
    </view>

    <!-- 补充信息 -->
    <view class="form-group">
      <text class="form-label">补充信息</text>
      <textarea class="input textarea" placeholder="装修情况、看房时间等备注" value="{{form.remarks}}" bindinput="onInput" data-field="remarks"/>
    </view>

    <!-- 提交 -->
    <view class="submit-wrap">
      <button class="btn-primary submit-btn" disabled="{{submitting}}" bindtap="onSubmit">{{submitting ? '提交中...' : '提交估价'}}</button>
    </view>
    <view class="risk-note">信息仅用于估价与上门看房安排，不外泄、不电话骚扰</view>
  </view>
</view>
