/* 「评估详情」页 · Steep（DESIGN.md）：Fog 画布 + 白卡 + 24rpx 圆角，暖色仅用于价格
   【不拆分说明】本文件 > 500 行：跟进半屏面板样式（.sheet/.chips/.confirm-btn 等）与页面
   既有令牌同源同放（spec 要求与 authorize 逐像素同构），拆分会割裂样式同源约定，故保持单文件。 */
page {
  background-color: #f7f7f8;
}

.page {
  min-height: 100vh;
  background-color: #f7f7f8;
  padding: 16rpx 20rpx 64rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ===== 白卡基座 ===== */
.card {
  background-color: #ffffff;
  border-radius: 24px;
  padding: 40rpx;
  box-shadow: rgba(4, 23, 43, 0.05) 0px 0px 0px 1px,
    rgba(0, 0, 0, 0.1) 0px 20px 25px -5px,
    rgba(0, 0, 0, 0.1) 0px 8px 10px -6px;
}
.card__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 28rpx;
}
.card__title {
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: -0.13px;
  color: #17191c;
}
.card__note {
  font-size: 24rpx;
  letter-spacing: -0.1px;
  color: #777b86;
}
/* 区块头内联操作按钮（＋ 登记，与 authorize 的 blk-h__act 同构） */
.card__act {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 23rpx;
  font-weight: 600;
  color: #2f5f96;
  border: 2rpx solid rgba(47, 95, 150, 0.28);
  border-radius: 9999rpx;
  padding: 6rpx 22rpx;
  background: #ffffff;
}

/* ===== 价格 Hero（结论先行）===== */
.hero__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.hero__name {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: -0.16px;
  color: #17191c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hero__meta {
  margin-top: 12rpx;
  font-size: 26rpx;
  letter-spacing: -0.11px;
  color: #777b86;
}
.price-block {
  margin-top: 28rpx;
  background-color: #fbe1d1;
  border-radius: 16px;
  padding: 32rpx 36rpx;
}
.price-block__caption {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  letter-spacing: 0.06em;
  color: #777b86;
}
.price-block__caption::before {
  content: "";
  margin-right: 12rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 4rpx;
  background-color: #5d2a1a;
}
.price-row {
  margin-top: 20rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  color: #17191c;
}
.price-sym {
  font-size: 34rpx;
  color: #4c4c4c;
}
.price-num {
  font-size: 96rpx;
  font-weight: 500;
  letter-spacing: -1.2px;
  color: #17191c;
  line-height: 1;
}
.price-unit {
  font-size: 26rpx;
  color: #4c4c4c;
}
.pending-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.pending-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: #5d2a1a;
  animation: pulse 1.6s ease-in-out infinite;
}
.pending-text {
  font-size: 30rpx;
  letter-spacing: -0.14px;
  color: #17191c;
}
@keyframes pulse {
  0% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.7); opacity: 0.35; }
  100% { transform: scale(1); opacity: 1; }
}
.hero__foot {
  margin-top: 20rpx;
  font-size: 24rpx;
  letter-spacing: -0.1px;
  color: #777b86;
}

/* ===== 查看数据指引 ===== */
.data-guide {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(93, 42, 26, 0.15);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.data-guide:active {
  opacity: 0.6;
}
.data-guide__hint {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  letter-spacing: -0.1px;
  color: #5d2a1a;
}
.data-guide__btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: #5d2a1a;
  border-radius: 9999rpx;
  padding: 10rpx 24rpx;
}
.data-guide__btn-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #fbe1d1;
}
.data-guide__arrow {
  width: 10rpx;
  height: 10rpx;
  border-right: 3rpx solid #fbe1d1;
  border-top: 3rpx solid #fbe1d1;
  transform: rotate(45deg);
}

/* ===== 状态徽标 ===== */
.pill {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 500;
  padding: 8rpx 20rpx;
  border-radius: 9999rpx;
  letter-spacing: 0.01em;
}
.pill--warm {
  background-color: #fbe1d1;
  color: #5d2a1a;
}
.pill--muted {
  background-color: #f7f7f8;
  color: #777b86;
}

/* ===== 户型图 ===== */
.plan-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}
.plan-cell {
  width: 100%;
  height: 260rpx;
  border-radius: 12px;
  background-color: #f7f7f8;
}

/* ===== 房源信息 ===== */
.spec-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.spec-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}
.spec-label {
  flex-shrink: 0;
  font-size: 28rpx;
  letter-spacing: -0.12px;
  color: #777b86;
}
.spec-value {
  flex: 1;
  font-size: 28rpx;
  letter-spacing: -0.12px;
  color: #17191c;
  text-align: right;
  word-break: break-all;
}

/* ===== 跟进记录 ===== */
.followup {
  padding: 24rpx 0;
  border-bottom: 2rpx solid rgba(163, 166, 175, 0.3);
}
.followup:first-child {
  padding-top: 0;
}
.followup:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.followup__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.followup__method {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 500;
  color: #4c4c4c;
  background-color: #f7f7f8;
  border-radius: 9999rpx;
  padding: 6rpx 20rpx;
  letter-spacing: 0.01em;
}
.followup__time {
  font-size: 24rpx;
  letter-spacing: -0.1px;
  color: #777b86;
}
.followup__content {
  margin-top: 16rpx;
  font-size: 28rpx;
  letter-spacing: -0.12px;
  color: #4c4c4c;
  line-height: 1.65;
}
.link-more {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 450;
  letter-spacing: -0.12px;
  color: #17191c;
  padding: 12rpx 0;
}
.link-more:active {
  opacity: 0.6;
}
.link-more__chevron {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #17191c;
  border-bottom: 3rpx solid #17191c;
  transform: rotate(45deg) translateY(-4rpx);
}
.empty {
  font-size: 28rpx;
  letter-spacing: -0.12px;
  color: #777b86;
  padding: 16rpx 0;
}

/* ===== 底部操作栏 / 半屏面板（与 authorize 同名样式逐像素同构） ===== */
.actionbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid #e6e8ec;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 24rpx);
}
.abtn {
  border: none;
  border-radius: 9999rpx;
  font-size: 28rpx;
  font-weight: 600;
  height: 92rpx;
  line-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}
.abtn::after {
  border: none;
}
.abtn--primary {
  flex: 1;
  background: #17191c;
  color: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(23, 25, 28, 0.25);
}
.actionbar-placeholder {
  height: 180rpx;
}
.mask {
  position: fixed;
  inset: 0;
  background: rgba(23, 25, 28, 0.45);
  z-index: 70;
  animation: detail-fade-in 0.25s ease;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 75;
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 20rpx 36rpx calc(env(safe-area-inset-bottom) + 28rpx);
  animation: detail-slide-up 0.3s cubic-bezier(0.32, 0.72, 0.28, 1);
}
@keyframes detail-slide-up {
  from {
    transform: translateY(105%);
  }
  to {
    transform: none;
  }
}
@keyframes detail-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.sheet__grab {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #e6e8ec;
  margin: 0 auto 24rpx;
}
.sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sheet__title {
  font-size: 31rpx;
  font-weight: 700;
}
.sheet__sub {
  font-size: 22rpx;
  color: #a3a6af;
  margin-top: 8rpx;
}
.sheet__close {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f7f7f8;
  color: #4c4c4c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.fld {
  margin-top: 32rpx;
}
.fld__lb {
  font-size: 24rpx;
  color: #4c4c4c;
  margin-bottom: 16rpx;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip {
  height: 68rpx;
  padding: 0 28rpx;
  border-radius: 9999rpx;
  background: #f7f7f8;
  border: 2rpx solid #e6e8ec;
  color: #4c4c4c;
  font-size: 25rpx;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
}
.chip--on {
  background: #17191c;
  border-color: #17191c;
  color: #ffffff;
}
.ta {
  width: 100%;
  border: 2rpx solid #e6e8ec;
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  font-size: 26rpx;
  color: #17191c;
  min-height: 140rpx;
  line-height: 1.65;
  box-sizing: border-box;
}
.ta__placeholder {
  color: #a3a6af;
}
.ta-count {
  text-align: right;
  font-size: 21rpx;
  color: #a3a6af;
  margin-top: 10rpx;
}
.form-error {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #b42318;
}
.sheet__actions {
  margin-top: 36rpx;
}
.confirm-btn {
  width: 100%;
  height: 94rpx;
  border-radius: 9999rpx;
  background: #17191c;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 94rpx;
  padding: 0;
  box-shadow: 0 18rpx 44rpx rgba(23, 25, 28, 0.24);
}
.confirm-btn::after {
  border: none;
}
.confirm-btn[disabled] {
  background: #c6cbd4;
  color: #ffffff;
  box-shadow: none;
}

/* ===== 通用状态 ===== */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 48rpx 0;
  text-align: center;
}
.state__icons {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}
.spinner {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(163, 166, 175, 0.35);
  border-top-color: #17191c;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.state__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background-color: #f7f7f8;
  margin-bottom: 28rpx;
}
.state__icon-svg {
  font-size: 48rpx;
  line-height: 1;
  filter: grayscale(1);
  opacity: 0.75;
}
.state__title {
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: -0.15px;
  color: #17191c;
  margin-bottom: 16rpx;
}
.state__text {
  font-size: 28rpx;
  letter-spacing: -0.12px;
  color: #777b86;
  line-height: 1.7;
  margin-bottom: 28rpx;
}
.state__btn {
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: -0.13px;
  color: #ffffff;
  background-color: #17191c;
  border-radius: 9999rpx;
  padding: 20rpx 64rpx;
  margin-top: 28rpx;
}