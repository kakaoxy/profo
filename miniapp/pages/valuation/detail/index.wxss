/* 「评估详情」页 · 对齐 projects/list 暖色编辑风格 */

page {
  background-color: hsl(40, 16%, 98%);
}

.page {
  --warm-bg: hsl(40, 16%, 98%);
  --warm-fg: hsl(37.5, 15.69%, 20%);
  --warm-muted-fg: hsl(36, 19.84%, 49.41%);
  --warm-muted: hsl(44, 26.32%, 88.82%);
  --warm-accent: hsl(40, 24.09%, 73.14%);
  --warm-border: hsl(43.33, 23.08%, 84.71%);

  min-height: 100vh;
  background-color: var(--warm-bg);
  color: var(--warm-fg);
  padding: 24rpx 40rpx 60rpx;
}

/* ===== 分区卡片 ===== */
.section {
  margin-top: 24rpx;
  background-color: var(--warm-bg);
  border: 2rpx solid var(--warm-border);
  border-radius: 48rpx;
  padding: 40rpx;
}
.section__title {
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: -0.2rpx;
  color: var(--warm-muted-fg);
  margin-bottom: 32rpx;
}

/* ===== 房源信息 ===== */
.info-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--warm-border);
}
.info-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.info-row:first-child {
  padding-top: 0;
}
.info-label {
  flex-shrink: 0;
  width: 160rpx;
  font-size: 28rpx;
  letter-spacing: -0.2rpx;
  color: var(--warm-muted-fg);
}
.info-value {
  flex: 1;
  font-size: 28rpx;
  letter-spacing: -0.2rpx;
  color: var(--warm-fg);
  text-align: right;
  word-break: break-all;
}

/* ===== 户型图 ===== */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.image-cell {
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  background: var(--warm-muted);
}

/* ===== 评估价格 ===== */
.section--price {
  background-color: hsla(40, 24.09%, 73.14%, 0.28);
}
.price-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.price-sym {
  font-size: 32rpx;
  color: var(--warm-muted-fg);
}
.price-num {
  font-size: 88rpx;
  font-weight: 500;
  letter-spacing: -0.6rpx;
  color: var(--warm-fg);
  line-height: 1;
}
.price-unit {
  font-size: 32rpx;
  color: var(--warm-muted-fg);
}
.price-pending {
  font-size: 30rpx;
  letter-spacing: -0.2rpx;
  color: var(--warm-muted-fg);
}

/* ===== 跟进记录 ===== */
.followup {
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--warm-border);
}
.followup:first-child {
  padding-top: 0;
}
.followup:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.followup__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.followup__method {
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: -0.2rpx;
  color: var(--warm-fg);
}
.followup__time {
  font-size: 24rpx;
  letter-spacing: -0.13rpx;
  color: var(--warm-muted-fg);
}
.followup__content {
  margin-top: 12rpx;
  font-size: 28rpx;
  letter-spacing: -0.2rpx;
  color: var(--warm-muted-fg);
  line-height: 1.6;
}
.load-more {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 9999rpx;
  background: var(--warm-muted);
  font-size: 28rpx;
  letter-spacing: -0.2rpx;
  color: var(--warm-muted-fg);
}
.empty {
  font-size: 28rpx;
  letter-spacing: -0.2rpx;
  color: var(--warm-muted-fg);
  padding: 16rpx 0;
}

/* ===== 通用状态 ===== */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 32rpx;
}
.state__title {
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: -0.3rpx;
  color: var(--warm-fg);
  margin-bottom: 16rpx;
}
.state__text {
  font-size: 28rpx;
  letter-spacing: -0.2rpx;
  color: var(--warm-muted-fg);
  margin-bottom: 24rpx;
}
.state__btn {
  font-size: 28rpx;
  letter-spacing: -0.2rpx;
  color: var(--warm-bg);
  background-color: var(--warm-fg);
  border-radius: 9999rpx;
  padding: 16rpx 48rpx;
  font-weight: 500;
}