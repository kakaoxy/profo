/* 「评估详情」页 · Steep（DESIGN.md）：Fog 画布 + 白卡 + 24rpx 圆角，暖色仅用于价格 */
page {
  background-color: #f7f7f8;
}

.page {
  min-height: 100vh;
  background-color: #f7f7f8;
  padding: 16rpx 20rpx 64rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ===== 白卡基座 ===== */
.card {
  background-color: #ffffff;
  border-radius: 24px;
  padding: 40rpx;
  box-shadow: rgba(4, 23, 43, 0.05) 0px 0px 0px 1px,
    rgba(0, 0, 0, 0.1) 0px 20px 25px -5px,
    rgba(0, 0, 0, 0.1) 0px 8px 10px -6px;
}
.card__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 28rpx;
}
.card__title {
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: -0.13px;
  color: #17191c;
}
.card__note {
  font-size: 24rpx;
  letter-spacing: -0.1px;
  color: #777b86;
}

/* ===== 价格 Hero（结论先行）===== */
.hero__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.hero__name {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: -0.16px;
  color: #17191c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hero__meta {
  margin-top: 12rpx;
  font-size: 26rpx;
  letter-spacing: -0.11px;
  color: #777b86;
}
.price-block {
  margin-top: 28rpx;
  background-color: #fbe1d1;
  border-radius: 16px;
  padding: 32rpx 36rpx;
}
.price-block__caption {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  letter-spacing: 0.06em;
  color: #777b86;
}
.price-block__caption::before {
  content: "";
  margin-right: 12rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 4rpx;
  background-color: #5d2a1a;
}
.price-row {
  margin-top: 20rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  color: #17191c;
}
.price-sym {
  font-size: 34rpx;
  color: #4c4c4c;
}
.price-num {
  font-size: 96rpx;
  font-weight: 500;
  letter-spacing: -1.2px;
  color: #17191c;
  line-height: 1;
}
.price-unit {
  font-size: 26rpx;
  color: #4c4c4c;
}
.pending-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.pending-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: #5d2a1a;
  animation: pulse 1.6s ease-in-out infinite;
}
.pending-text {
  font-size: 30rpx;
  letter-spacing: -0.14px;
  color: #17191c;
}
@keyframes pulse {
  0% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.7); opacity: 0.35; }
  100% { transform: scale(1); opacity: 1; }
}
.hero__foot {
  margin-top: 20rpx;
  font-size: 24rpx;
  letter-spacing: -0.1px;
  color: #777b86;
}

/* ===== 状态徽标 ===== */
.pill {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 500;
  padding: 8rpx 20rpx;
  border-radius: 9999rpx;
  letter-spacing: 0.01em;
}
.pill--warm {
  background-color: #fbe1d1;
  color: #5d2a1a;
}
.pill--muted {
  background-color: #f7f7f8;
  color: #777b86;
}

/* ===== 户型图 ===== */
.plan-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}
.plan-cell {
  width: 100%;
  height: 260rpx;
  border-radius: 12px;
  background-color: #f7f7f8;
}

/* ===== 房源信息 ===== */
.spec-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.spec-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}
.spec-label {
  flex-shrink: 0;
  font-size: 28rpx;
  letter-spacing: -0.12px;
  color: #777b86;
}
.spec-value {
  flex: 1;
  font-size: 28rpx;
  letter-spacing: -0.12px;
  color: #17191c;
  text-align: right;
  word-break: break-all;
}

/* ===== 小区数据分析入口 ===== */
.entry {
  background-color: #d3e3fc;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.entry:active {
  filter: brightness(0.96);
}
.entry__text {
  flex: 1;
  min-width: 0;
}
.entry__title {
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: -0.13px;
  color: #17191c;
}
.entry__sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  letter-spacing: -0.1px;
  color: #5a6b85;
}
.entry__chart {
  position: relative;
  flex-shrink: 0;
  width: 88rpx;
  height: 48rpx;
}
.entry__line {
  position: absolute;
  left: 0;
  top: 50%;
  width: 88rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #d3e3fc 0%, #4a90e2 100%);
}
.entry__dot {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: #4a90e2;
}
.entry__arrow {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  border-right: 4rpx solid #777b86;
  border-top: 4rpx solid #777b86;
  transform: rotate(45deg);
}

/* ===== 跟进记录 ===== */
.followup {
  padding: 24rpx 0;
  border-bottom: 2rpx solid rgba(163, 166, 175, 0.3);
}
.followup:first-child {
  padding-top: 0;
}
.followup:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.followup__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.followup__method {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 500;
  color: #4c4c4c;
  background-color: #f7f7f8;
  border-radius: 9999rpx;
  padding: 6rpx 20rpx;
  letter-spacing: 0.01em;
}
.followup__time {
  font-size: 24rpx;
  letter-spacing: -0.1px;
  color: #777b86;
}
.followup__content {
  margin-top: 16rpx;
  font-size: 28rpx;
  letter-spacing: -0.12px;
  color: #4c4c4c;
  line-height: 1.65;
}
.link-more {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 450;
  letter-spacing: -0.12px;
  color: #17191c;
  padding: 12rpx 0;
}
.link-more:active {
  opacity: 0.6;
}
.link-more__chevron {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #17191c;
  border-bottom: 3rpx solid #17191c;
  transform: rotate(45deg) translateY(-4rpx);
}
.empty {
  font-size: 28rpx;
  letter-spacing: -0.12px;
  color: #777b86;
  padding: 16rpx 0;
}

/* ===== 通用状态 ===== */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 48rpx 0;
  text-align: center;
}
.state__icons {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}
.spinner {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(163, 166, 175, 0.35);
  border-top-color: #17191c;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.state__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background-color: #f7f7f8;
  margin-bottom: 28rpx;
}
.state__icon-svg {
  font-size: 48rpx;
  line-height: 1;
  filter: grayscale(1);
  opacity: 0.75;
}
.state__title {
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: -0.15px;
  color: #17191c;
  margin-bottom: 16rpx;
}
.state__text {
  font-size: 28rpx;
  letter-spacing: -0.12px;
  color: #777b86;
  line-height: 1.7;
  margin-bottom: 28rpx;
}
.state__btn {
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: -0.13px;
  color: #ffffff;
  background-color: #17191c;
  border-radius: 9999rpx;
  padding: 20rpx 64rpx;
  margin-top: 28rpx;
}