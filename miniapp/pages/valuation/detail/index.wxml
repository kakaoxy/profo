<view class="page">
  <!-- 加载中 -->
  <view class="state" wx:if="{{loading}}">
    <view class="state__icons">
      <view class="spinner"></view>
    </view>
    <view class="state__text">加载中...</view>
  </view>

  <!-- 未登录态 -->
  <view class="state" wx:elif="{{needLogin}}">
    <view class="state__icon">
      <view class="state__icon-svg">🔒</view>
    </view>
    <view class="state__title">登录已失效</view>
    <view class="state__text">请先登录后查看评估详情</view>
    <view class="state__btn" bindtap="onGoLogin">去登录</view>
  </view>

  <!-- 内部员工限定态 -->
  <view class="state" wx:elif="{{internalOnly}}">
    <view class="state__icon">
      <view class="state__icon-svg">🏠</view>
    </view>
    <view class="state__text">内部员工暂无法在端内查看评估详情</view>
  </view>

  <!-- 无权查看 -->
  <view class="state" wx:elif="{{forbidden}}">
    <view class="state__icon">
      <view class="state__icon-svg">⛔</view>
    </view>
    <view class="state__text">无权查看该评估</view>
    <view class="state__btn" bindtap="onBack">返回</view>
  </view>

  <!-- 记录不存在 -->
  <view class="state" wx:elif="{{notFound}}">
    <view class="state__icon">
      <view class="state__icon-svg">📄</view>
    </view>
    <view class="state__text">评估记录不存在</view>
    <view class="state__btn" bindtap="onBack">返回</view>
  </view>

  <!-- 错误态 -->
  <view class="state" wx:elif="{{error}}">
    <view class="state__icon">
      <view class="state__icon-svg">!</view>
    </view>
    <view class="state__text">加载失败，请重试</view>
    <view class="state__btn" bindtap="onRetry">重试</view>
  </view>

  <!-- 详情内容 -->
  <block wx:else>
    <!-- 1. 评估价格（结论先行） -->
    <view class="card hero">
      <view class="hero__head">
        <view class="hero__name">{{community_name}}</view>
        <view class="pill {{hasEvalPrice ? 'pill--warm' : 'pill--muted'}}">
          {{hasEvalPrice ? '已评估' : '评估中'}}
        </view>
      </view>
      <view class="hero__meta" wx:if="{{hero_meta}}">
        {{hero_meta}}
      </view>
      <view class="price-block">
        <view class="price-block__caption">评估价格</view>
        <view class="price-row" wx:if="{{hasEvalPrice}}">
          <text class="price-sym">¥</text>
          <text class="price-num">{{evalPrice}}</text>
          <text class="price-unit">万</text>
        </view>
        <view class="pending-row" wx:else>
          <view class="pending-dot"></view>
          <text class="pending-text">评估中，请耐心等待</text>
        </view>
        <view class="data-guide" wx:if="{{hasEvalPrice}}" bindtap="onTapCommunityAnalysis">
          <text class="data-guide__hint">该价格基于小区数据分析</text>
          <view class="data-guide__btn">
            <text class="data-guide__btn-text">查看数据</text>
            <view class="data-guide__arrow"></view>
          </view>
        </view>
      </view>
      <view class="hero__foot">提交于 {{created_at}}</view>
    </view>

    <!-- 2. 户型图（未提交户型图则不渲染本区块） -->
    <view class="card" wx:if="{{images.length > 0}}">
      <view class="card__head">
        <view class="card__title">户型图</view>
        <view class="card__note">{{images.length}} 张 · 点击预览</view>
      </view>
      <view class="plan-grid">
        <image
          class="plan-cell"
          wx:for="{{images}}"
          wx:key="*this"
          src="{{item}}"
          mode="aspectFill"
          lazy-load
          data-src="{{item}}"
          bindtap="onPreviewImage"
        />
      </view>
    </view>

    <!-- 3. 房源信息 -->
    <view class="card">
      <view class="card__head">
        <view class="card__title">房源信息</view>
      </view>
      <view class="spec-list">
        <view class="spec-row"><text class="spec-label">小区</text><text class="spec-value">{{community_name}}</text></view>
        <view class="spec-row" wx:if="{{layout}}"><text class="spec-label">户型</text><text class="spec-value">{{layout}}</text></view>
        <view class="spec-row" wx:if="{{area}}"><text class="spec-label">面积</text><text class="spec-value">{{area}}</text></view>
        <view class="spec-row" wx:if="{{floor_display}}"><text class="spec-label">楼层/朝向</text><text class="spec-value">{{floor_display}}</text></view>
        <view class="spec-row" wx:if="{{remarks}}"><text class="spec-label">留言</text><text class="spec-value">{{remarks}}</text></view>
        <view class="spec-row"><text class="spec-label">提交时间</text><text class="spec-value">{{created_at}}</text></view>
      </view>
    </view>

    <!-- 4. 跟进记录（内部员工多出「＋ 登记」入口） -->
    <view class="card">
      <view class="card__head">
        <view class="card__title">跟进记录</view>
        <view class="card__act" wx:if="{{canFollowup}}" bindtap="openFollowupPanel">＋ 登记</view>
        <view class="card__note" wx:elif="{{hasMore}}">共 {{allFollowups.length}} 条</view>
      </view>
      <view wx:if="{{followups.length > 0}}">
        <view class="followup" wx:for="{{followups}}" wx:key="id">
          <view class="followup__meta">
            <view class="followup__method">{{item.method}}</view>
            <view class="followup__time">{{item.at}}</view>
          </view>
          <view class="followup__content">{{item.content}}</view>
        </view>
        <view class="link-more" wx:if="{{hasMore}}" bindtap="onLoadMoreFollowups">
          <text>展开剩余 {{remaining}} 条</text>
          <view class="link-more__chevron"></view>
        </view>
      </view>
      <view class="empty" wx:else>暂无跟进记录</view>
    </view>
  </block>
</view>

<!-- 底部操作栏 + 半屏面板（仅 can_follow_up 的内部员工；纯 C 端客户页面与改造前一致） -->
<view class="actionbar" wx:if="{{canFollowup}}">
  <button class="abtn abtn--primary" bindtap="openFollowupPanel">更新跟进</button>
</view>
<view class="actionbar-placeholder" wx:if="{{canFollowup}}"></view>

<view class="mask" wx:if="{{panelMode}}" bindtap="closePanel"></view>

<view class="sheet" wx:if="{{panelMode === 'followup'}}">
  <view class="sheet__grab"></view>
  <view class="sheet__head">
    <view class="sheet__title">登记跟进</view>
    <view class="sheet__close" bindtap="closePanel">×</view>
  </view>
  <view class="sheet__sub">记录与业主的最新沟通进展，保持跟进连续性</view>
  <view class="fld">
    <view class="fld__lb">跟进方式</view>
    <view class="chips">
      <view class="chip {{followupMethod === 'phone' ? 'chip--on' : ''}}" data-method="phone" bindtap="onFollowupMethodTap">电话</view>
      <view class="chip {{followupMethod === 'wechat' ? 'chip--on' : ''}}" data-method="wechat" bindtap="onFollowupMethodTap">微信</view>
      <view class="chip {{followupMethod === 'face' ? 'chip--on' : ''}}" data-method="face" bindtap="onFollowupMethodTap">面谈</view>
      <view class="chip {{followupMethod === 'visit' ? 'chip--on' : ''}}" data-method="visit" bindtap="onFollowupMethodTap">实地带看</view>
    </view>
  </view>
  <view class="fld">
    <view class="fld__lb">跟进内容</view>
    <textarea
      class="ta"
      maxlength="500"
      placeholder="如：已电话确认看房时间，业主周三下午方便"
      placeholder-class="ta__placeholder"
      value="{{followupContent}}"
      bindinput="onFollowupContentInput"
    />
    <view class="ta-count">{{followupLen}}/500</view>
  </view>
  <view class="form-error" wx:if="{{formError}}">{{formError}}</view>
  <view class="sheet__actions">
    <button
      class="confirm-btn"
      loading="{{submitting}}"
      disabled="{{!followupContent || submitting}}"
      bindtap="submitFollowup"
    >确认登记</button>
  </view>
</view>

<!-- 手机号绑定授权弹窗：小区数据分析入口未绑定手机号时主动触发 -->
<phone-bind-modal
  id="phoneModal"
  bind:bound="onPhoneModalBound"
  bind:gobindaccount="onPhoneModalGoBindAccount"
/>