/* ③ 记一笔 全屏表单页 · 对齐设计稿③与 Steep 令牌 */
.page {
  min-height: 100vh;
  background: var(--fog);
  padding-bottom: 200rpx;
}
.content {
  padding: 28rpx 40rpx 0;
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}

/* ===== 项目上下文头 ===== */
.ctx-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-bottom: 8rpx;
}
.ctx-flag {
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  border-radius: 24rpx;
  background: var(--sky-wash);
  display: flex;
  align-items: center;
  justify-content: center;
}
.ctx-flag__icon {
  font-size: 30rpx;
  font-weight: 600;
  color: #2a5ca0;
}
.ctx-main {
  flex: 1;
  min-width: 0;
}
.ctx-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ctx-comm {
  font-size: 24rpx;
  color: var(--graphite);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 字段 ===== */
.field {
  display: flex;
  flex-direction: column;
}
.field-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ash);
  margin-bottom: 16rpx;
}
.field-label .req {
  color: #cf3f3a;
  font-weight: 600;
}
.field-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--graphite);
}
.field-error {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #cf3f3a;
}

/* ===== 行触发器 ===== */
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--pure-white);
  border-radius: 32rpx;
  padding: 26rpx 28rpx;
  box-shadow: var(--shadow-sm);
}
.picker-placeholder {
  color: var(--dove);
  font-size: 28rpx;
}
.picker-val {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: var(--ink);
  font-size: 28rpx;
}
.picker-date {
  color: var(--ink);
  font-size: 28rpx;
}
.lv-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  background: var(--fog);
  color: var(--graphite);
  border-radius: 12rpx;
  padding: 2rpx 10rpx;
}
.chevron {
  color: var(--dove);
  font-size: 36rpx;
  line-height: 1;
}

/* ===== 方向二选一（花出去 / 收进来） ===== */
.dir-cols {
  display: flex;
  gap: 20rpx;
}
.dir-card {
  flex: 1;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  border-radius: 28rpx;
  padding: 24rpx 26rpx;
  background: rgba(240, 241, 243, 0.5);
  box-shadow: var(--shadow-sm);
}
.dir-card--active {
  background: var(--fog);
  box-shadow: inset 0 0 0 3rpx var(--ink), var(--shadow-sm);
}
.dir-dot {
  flex-shrink: 0;
  margin-top: 4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid var(--dove);
  display: flex;
  align-items: center;
  justify-content: center;
}
.dir-dot--on {
  background: var(--ink);
  border-color: var(--ink);
}
.dir-dot__inner {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #fff;
}
.dir-main {
  min-width: 0;
}
.dir-title {
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.3;
}
.dir-title--out { color: #0f7a4c; }
.dir-title--in { color: #cf3f3a; }
.dir-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--graphite);
}

/* ===== 单一金额块 ===== */
.amt-block {
  margin-top: 20rpx;
  border-radius: 32rpx;
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  background: var(--pure-white);
  box-shadow: var(--shadow-sm);
}
.amt-tag {
  font-size: 24rpx;
  font-weight: 500;
}
.amt-tag--out { color: #0f7a4c; }
.amt-tag--in { color: #cf3f3a; }
.amt-input {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.amt-input .cur {
  font-size: 26rpx;
}
.amt-input input {
  border: none;
  background: transparent;
  font-size: 32rpx;
  font-weight: 600;
  width: 100%;
  color: var(--ink);
}
.amt-ph {
  color: var(--dove);
  font-weight: 400;
}
.amt-input--out { color: #0f7a4c; }
.amt-input--in { color: #cf3f3a; }
.amt-input--out input { color: #0f7a4c; }
.amt-input--in input { color: #cf3f3a; }

/* ===== 资金账户 ===== */
.acct-warn {
  border-radius: 20rpx;
  background: #fdf3e7;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #9a6a34;
}
.acct-warn__retry {
  color: #2a5ca0;
  font-weight: 500;
}
.acct-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-radius: 24rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 16rpx;
  background: var(--pure-white);
  box-shadow: var(--shadow-sm);
}
.acct-item--active {
  box-shadow: inset 0 0 0 3rpx var(--ink), var(--shadow-sm);
}
.acct-main {
  min-width: 0;
}
.acct-name {
  font-size: 28rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.acct-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--graphite);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.acct-check {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid var(--dove);
  color: transparent;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.acct-check--on {
  background: var(--ink);
  border-color: var(--ink);
  color: #fff;
}
.acct-loading {
  font-size: 24rpx;
  color: var(--graphite);
  padding: 8rpx 4rpx;
}
.skip-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 4rpx;
}
.skip-box {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  border: 2rpx solid var(--dove);
  color: transparent;
  font-size: 24rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--pure-white);
}
.skip-box--on {
  background: var(--ink);
  border-color: var(--ink);
  color: #fff;
}
.skip-text {
  font-size: 25rpx;
  color: var(--ink);
}
.label-sub {
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--dove);
}

/* ===== 付款方/收款方 ===== */
.form-row2 {
  display: flex;
  gap: 20rpx;
}
.form-row2 > .field {
  flex: 1;
  min-width: 0;
}
.mini-input {
  width: 100%;
  background: var(--pure-white);
  border-radius: 32rpx;
  padding: 26rpx 28rpx;
  font-size: 28rpx;
  color: var(--ink);
  box-shadow: var(--shadow-sm);
}
.mini-ph {
  color: var(--dove);
}

/* ===== 票据九宫格 ===== */
.tkt-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}
.tkt-cell {
  position: relative;
  aspect-ratio: 1 / 1;
  border-radius: 28rpx;
  overflow: hidden;
}
.tkt-img {
  width: 100%;
  height: 100%;
}
.tkt-mask {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(23, 25, 28, 0.4);
  color: #fff;
  font-size: 22rpx;
}
.tkt-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(23, 25, 28, 0.55);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 1;
}
.tkt-add {
  border: 3rpx dashed var(--dove);
  border-radius: 28rpx;
  aspect-ratio: 1 / 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: var(--dove);
  font-size: 22rpx;
}
.tkt-add__plus {
  font-size: 44rpx;
  line-height: 1;
}

/* ===== 备注 ===== */
.textarea {
  width: 100%;
  min-height: 176rpx;
  background: var(--pure-white);
  border-radius: 32rpx;
  padding: 26rpx 28rpx;
  font-size: 28rpx;
  color: var(--ink);
  box-shadow: var(--shadow-sm);
}
.textarea-ph {
  color: var(--dove);
}

/* ===== 底部固定按钮 ===== */
.fab {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: 40rpx;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 10;
}
.btn-ink {
  width: 100%;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ink);
  color: var(--pure-white);
  border-radius: 9999rpx;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1;
}
.btn-ink::after {
  border: none;
}
.btn-ink[disabled] {
  background: var(--dove);
  color: #fff;
}

.tnum {
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}