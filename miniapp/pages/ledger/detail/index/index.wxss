/* ② 项目账目清单页 · warm 风格（对齐 Steep 令牌与设计稿） */
.page {
  min-height: 100vh;
  background: var(--fog);
  padding-bottom: 40rpx;
}

/* ===== 汇总卡 ===== */
.summary {
  background: var(--apricot-wash);
  border-radius: 48rpx;
  padding: 36rpx;
  margin: 28rpx 40rpx 28rpx;
  box-shadow: var(--shadow-sm);
}
.summary-head {
  margin-bottom: 24rpx;
}
.summary-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: -0.1px;
}
.summary-comm {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--graphite);
}
.summary-cols {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.summary-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.sum-label {
  font-size: 24rpx;
  color: var(--graphite);
}
.sum-value {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.15;
  word-break: break-all;
}
.sum-div {
  width: 2rpx;
  align-self: stretch;
  background: rgba(23, 25, 28, 0.1);
}
.summary-foot {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(93, 42, 26, 0.12);
  font-size: 24rpx;
  color: var(--rust);
}

/* ===== 金额配色（中国习惯，与后台一致）===== */
.money-pos { color: #cf3f3a; } /* 流入 */
.money-neg { color: #0f7a4c; } /* 流出 */
.tnum {
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

/* ===== 流水卡片 ===== */
.card {
  margin: 0 40rpx 24rpx;
  background: var(--pure-white);
  border-radius: 48rpx;
  padding: 36rpx;
  box-shadow: var(--shadow-sm);
}
.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
}
.card-note {
  font-size: 24rpx;
  color: var(--graphite);
}
.ledger {
  display: flex;
  flex-direction: column;
}
.rec {
  padding: 28rpx 0;
  border-bottom: 2rpx solid rgba(163, 166, 175, 0.3);
}
.rec:first-child {
  padding-top: 0;
}
.rec:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.rec-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.rec-left {
  flex: 1;
  min-width: 0;
}
.rec-date {
  font-size: 22rpx;
  color: var(--dove);
  letter-spacing: -0.05em;
}
.rec-subject {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
}
.rec-subject-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.lv-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  background: var(--fog);
  color: var(--graphite);
  border-radius: 12rpx;
  padding: 2rpx 10rpx;
}
.rec-flow {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--graphite);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rec-right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}
.rec-amount {
  font-size: 30rpx;
  font-weight: 600;
}
.rec-sign {
  font-size: 22rpx;
  color: var(--dove);
}
.rec-tkt {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--graphite);
  background: var(--fog);
  border-radius: 9999rpx;
  padding: 4rpx 16rpx;
}
.rec-tkt__thumb {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
  background: var(--dove);
}
.rec-flag-miss {
  font-size: 22rpx;
  color: #b98a2e;
  background: rgba(185, 138, 46, 0.12);
  border-radius: 9999rpx;
  padding: 4rpx 16rpx;
}

/* ===== 状态分支 ===== */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 160rpx 40rpx;
}
.state__title {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--ink);
}
.state__text {
  font-size: 26rpx;
  color: var(--graphite);
  text-align: center;
}
.state__btn {
  margin-top: 24rpx;
  padding: 16rpx 56rpx;
  border-radius: 9999rpx;
  background: var(--ink);
  color: var(--pure-white);
  font-size: 28rpx;
  font-weight: 500;
}

/* ===== 底部固定按钮 ===== */
.fab {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: 40rpx;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 10;
}
.btn-ink {
  width: 100%;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ink);
  color: var(--pure-white);
  border-radius: 9999rpx;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1;
}
.btn-ink::after {
  border: none;
}