/* 登录页 · 独立模块样式（Steep 设计系统，与 test-login 视觉一致） */
page {
  height: 100%;
}
.page {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx 80rpx;
}

/* ===== 品牌区 ===== */
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 64rpx;
}
.brand-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  background: var(--ink);
  color: var(--fog);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}
.brand-title {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--ink);
}
.brand-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--graphite);
}

/* ===== 登录卡片 ===== */
.form-card {
  width: 100%;
  max-width: 640rpx;
  background: var(--pure-white);
  border: 2rpx solid #ece7de;
  border-radius: 40rpx;
  padding: 48rpx 40rpx;
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
}

/* ===== 按钮：主（微信一键登录）+ 次（账号密码登录）===== */
.wechat-btn {
  display: flex;
  width: 100%;
  margin: 0 auto;
}
.password-btn {
  display: flex;
  width: 100%;
  margin: 24rpx auto 0;
  border: 2rpx solid var(--dove);
}

/* ===== 协议勾选区 ===== */
.agreement {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 40rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--graphite);
}
.agreement-text {
  color: var(--graphite);
}
.agreement-link {
  color: var(--ink);
  font-weight: 500;
}
