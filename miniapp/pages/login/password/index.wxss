/* 账号密码登录页 · login 体系子页样式（Steep 设计系统，响应式） */
page {
  height: 100%;
}
.page {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx 80rpx;
}

/* ===== 品牌区 ===== */
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 64rpx;
}
.brand-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  background: var(--ink);
  color: var(--fog);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}
.brand-title {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--ink);
}
.brand-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--graphite);
}

/* ===== 表单卡片 ===== */
.form-card {
  width: 100%;
  max-width: 640rpx;
  background: var(--pure-white);
  border: 2rpx solid #ece7de;
  border-radius: 40rpx;
  padding: 48rpx 40rpx;
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
}
.field {
  margin-bottom: 24rpx;
}
.form-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ash);
  margin-bottom: 16rpx;
}
.input {
  width: 100%;
  height: 104rpx;
  padding: 0 32rpx;
  border: 2rpx solid var(--dove);
  border-radius: 32rpx;
  font-size: 30rpx;
  background: var(--pure-white);
  color: var(--ink);
  box-sizing: border-box;
}
.input-error {
  border-color: #d64545;
}
.field-error {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #d64545;
}
.login-btn {
  display: flex;
  width: 400rpx;
  margin: 12rpx auto 0;
}
.hint {
  margin-top: 28rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--graphite);
}

/* ===== 登录失败结果卡片 ===== */
.result-card {
  width: 100%;
  max-width: 640rpx;
  margin-top: 40rpx;
  border-radius: 40rpx;
  padding: 32rpx 36rpx;
  box-sizing: border-box;
  border: 2rpx solid;
}
.result-card.failure {
  background: var(--apricot-wash);
  border-color: #f3c9ae;
}
.result-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}
.result-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--ink);
}
.result-body {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.result-row {
  display: flex;
  align-items: flex-start;
  font-size: 24rpx;
  line-height: 1.5;
}
.result-row .k {
  flex-shrink: 0;
  width: 168rpx;
  color: var(--ash);
}
.result-row .v {
  flex: 1;
  color: var(--ink);
  word-break: break-all;
}
.result-foot {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--graphite);
}
