<view class="page">
  <!-- 未登录 / 令牌失效 -->
  <view class="state" wx:if="{{state === 'needLogin'}}">
    <view class="state__title">登录已失效</view>
    <view class="state__text">请重新登录后查看装修记录</view>
    <view class="state__btn" bindtap="onGoLogin">返回重新登录</view>
  </view>

  <!-- 无权限查看 -->
  <view class="state" wx:elif="{{state === 'noPermission'}}">
    <view class="state__title">无权限查看</view>
    <view class="state__text">当前账号无权查看装修记录</view>
  </view>

  <!-- 加载失败 -->
  <view class="state" wx:elif="{{state === 'error'}}">
    <view class="state__title">加载失败</view>
    <view class="state__text">网络异常，请重试</view>
    <view class="state__btn" bindtap="onRetry">重试</view>
  </view>

  <!-- 加载中 -->
  <view class="state" wx:elif="{{state === 'loading'}}">
    <view class="state__text">加载中...</view>
  </view>

  <!-- 空态 -->
  <view class="state" wx:elif="{{state === 'empty'}}">
    <view class="state__text">暂无装修中项目</view>
  </view>

  <!-- 项目列表 -->
  <block wx:elif="{{state === 'items'}}">
    <view class="list-title">装修记录 · 装修中项目</view>
    <view
      class="project-card"
      wx:for="{{items}}"
      wx:key="id"
      bindtap="onItemTap"
      data-id="{{item.id}}"
      data-name="{{item.name}}"
    >
      <view class="card-header">
        <view class="card-name">{{item.name}}</view>
        <view
          class="status-badge"
          style="color: {{item.statusColor}}; background: {{item.statusColor}}1A;"
        >{{item.statusText}}</view>
      </view>
      <view class="card-progress">
        <view class="progress-item">
          <view class="progress-label">当前阶段</view>
          <view class="progress-value">{{item.stageText}}</view>
        </view>
        <view class="progress-item">
          <view class="progress-label">总体进度</view>
          <view class="progress-value">{{item.progressText}}</view>
        </view>
        <view class="chevron">›</view>
      </view>
    </view>
    <!-- 触底加载 / 没有更多 -->
    <view class="list-footer" wx:if="{{loadingMore}}">加载中...</view>
    <view class="list-footer" wx:elif="{{!hasMore && items.length > 0}}">没有更多了</view>
  </block>

  <!-- 底部留白 -->
  <view style="height: 120rpx;"></view>
</view>
