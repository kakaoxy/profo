/* 单项目装修进度详情页 · warm 风格（对齐 profile 页） */
.page {
  min-height: 100vh;
  background: var(--fog);
}

/* ===== 顶部标题栏 ===== */
.topbar {
  display: flex;
  align-items: center;
  padding: 24rpx 40rpx 8rpx;
}
.topbar-title {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  text-align: center;
  overflow-wrap: break-word;
}

/* ===== KPI 两宫格 ===== */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin: 24rpx 40rpx;
}
.kpi-cell {
  background: var(--pure-white);
  border: 2rpx solid #ece7de;
  border-radius: 24rpx;
  padding: 20rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-shadow: var(--shadow-sm);
}
.kpi-label {
  font-size: 22rpx;
  color: var(--graphite);
}
.kpi-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  text-align: center;
}

/* ===== 阶段时间线 ===== */
.stage-list {
  margin: 0 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.stage-card {
  background: var(--pure-white);
  border: 2rpx solid #ece7de;
  border-radius: 32rpx;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}
.stage-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx;
}
.stage-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 1;
  flex-shrink: 0;
}
.stage-icon--done {
  background: #10b981;
  color: var(--pure-white);
}
.stage-icon--current {
  background: #f97316;
  color: var(--pure-white);
}
.stage-icon--future {
  border: 2rpx solid var(--dove);
  color: var(--dove);
  background: transparent;
}
.stage-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
}
.stage-date {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--graphite);
}
.stage-count {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--fog);
  border: 2rpx solid #ece7de;
  font-size: 22rpx;
  color: var(--graphite);
}
.chevron {
  font-size: 40rpx;
  line-height: 1;
  color: var(--dove);
  transition: transform 0.2s ease;
}
.chevron--open {
  transform: rotate(90deg);
}

/* ===== 展开内容 ===== */
.stage-body {
  padding: 0 28rpx 28rpx;
}
.photo-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}
.photo-item {
  position: relative;
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--fog);
  border: 2rpx solid #ece7de;
}
.photo-img {
  width: 100%;
  height: 100%;
}
.photo-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(23, 25, 28, 0.55);
  color: var(--pure-white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
}
.photo-item--add {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: var(--dove);
  border: 2rpx dashed var(--dove);
  background: transparent;
}
.photo-item--uploading {
  display: flex;
  align-items: center;
  justify-content: center;
}
.upload-mask {
  position: absolute;
  inset: 0;
  background: rgba(23, 25, 28, 0.35);
  color: var(--pure-white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}
.upload-failed {
  position: absolute;
  inset: 0;
  background: rgba(23, 25, 28, 0.55);
  color: var(--pure-white);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.upload-failed-text {
  font-size: 24rpx;
}
.upload-failed-retry {
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
  background: var(--pure-white);
  color: #5d2a1a;
  font-size: 22rpx;
}
.photo-empty {
  padding: 32rpx;
  border: 2rpx dashed #ece7de;
  border-radius: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--graphite);
}

/* ===== 完成阶段 ===== */
.complete-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}
.complete-date {
  flex: 1;
  height: 80rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--dove);
  border-radius: 16rpx;
  background: var(--fog);
  font-size: 26rpx;
  color: var(--ink);
}
.complete-btn {
  flex: 1;
  margin: 0;
  height: 80rpx;
  border-radius: 999rpx;
  background: var(--rust);
  color: var(--pure-white);
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
}
.complete-btn::after {
  border: none;
}
.complete-btn--disabled {
  opacity: 0.6;
}

/* ===== 状态分支 ===== */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 120rpx 40rpx;
}
.state__title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--ink);
}
.state__text {
  font-size: 26rpx;
  color: var(--graphite);
  text-align: center;
}
.state__btn {
  margin-top: 20rpx;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: var(--ink);
  color: var(--pure-white);
  font-size: 28rpx;
  font-weight: 500;
}
