.page {
  min-height: 100vh;
  background: var(--fog);
}

/* 1. hero */
.home-hero {
  position: relative;
  padding: 56rpx 40rpx 64rpx;
  background: var(--pure-white);
  overflow: hidden;
}
.home-hero::after {
  content: "";
  position: absolute;
  top: -120rpx;
  right: -120rpx;
  width: 480rpx;
  height: 480rpx;
  background: radial-gradient(circle, rgba(251, 225, 209, 0.7) 0%, transparent 70%);
  pointer-events: none;
}
.hero-title {
  font-family: "Source Serif Pro", "Noto Serif SC", "Source Han Serif SC", "Songti SC", Georgia, serif;
  font-size: 64rpx;
  line-height: 1.1;
  position: relative;
  z-index: 2;
  margin-bottom: 20rpx;
}
.hero-sub {
  font-size: 28rpx;
  color: var(--ash);
  margin-bottom: 36rpx;
  line-height: 1.5;
  position: relative;
  z-index: 2;
}
.home-hero .btn-primary {
  position: relative;
  z-index: 2;
}

/* hero CTA 行：标签 + 按钮水平排列，始终保持一行 */
.hero-cta-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  position: relative;
  z-index: 2;
}

/* 累计服务家庭数标签：与 .btn-primary 同高(96rpx)同形状(胶囊)，
   浅底辅助色与主按钮(深色实心)形成主辅层级；
   flex:1 占剩余宽度，空间不足时省略尾部，按钮始终完整可点 */
.served-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  padding: 0 28rpx;
  background: var(--apricot-wash);
  color: var(--rust);
  border-radius: 9999rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1;
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.served-tag__num {
  font-weight: 600;
  margin: 0 2rpx;
}
/* 可点击提示：箭头 + 按下反馈 */
.served-tag__arrow {
  margin-left: 6rpx;
  font-size: 24rpx;
  color: var(--rust);
}
.served-tag--hover {
  opacity: 0.7;
}

/* 2. 痛点 / 3. 三部曲 / 5. 算一笔账 共享卡片样式 */
.pain-card,
.step-card,
.calc-card {
  background: var(--pure-white);
  border-radius: 40rpx;
  padding: 32rpx;
  margin: 0 40rpx 20rpx;
  box-shadow: var(--shadow-sm);
}

.pain-title,
.step-title,
.calc-head-title,
.guard-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.calc-title {
  font-size: 26rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.pain-desc,
.step-desc,
.guard-desc {
  font-size: 26rpx;
  color: var(--graphite);
}

/* 3. 三部曲 */
.step-card {
  display: flex;
  gap: 28rpx;
}
.step-num {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: var(--apricot-wash);
  color: var(--rust);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.step-body {
  flex: 1;
}

/* 4. 服务保障 */
.guard-list {
  padding: 0 40rpx;
}
.guard-item {
  background: var(--pure-white);
  border-radius: 32rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}

/* 5. 算一笔账 */
.calc-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.calc-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  padding: 14rpx 0;
}
.calc-row + .calc-row {
  border-top: 2rpx solid rgba(163, 166, 175, 0.2);
}
.calc-label {
  color: var(--graphite);
}
.calc-value {
  font-weight: 500;
}
.calc-value.pos {
  color: #f90000b1;
}
.calc-value.neg {
  color: #0ea365d4;
}
.calc-note {
  margin-top: 24rpx;
  padding: 24rpx;
  background: var(--apricot-wash);
  border-radius: 28rpx;
  font-size: 26rpx;
  color: var(--rust);
  font-weight: 500;
}

/* 6. 常见疑问 */
.faq-list {
  padding: 0 40rpx;
}
.faq-item {
  background: var(--pure-white);
  border-radius: 32rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}
.faq-q {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.faq-chevron {
  color: var(--dove);
  font-size: 28rpx;
}
.faq-a {
  padding: 0 32rpx 32rpx;
  font-size: 26rpx;
  color: var(--graphite);
  line-height: 1.6;
}

/* 7. 风险提示 */
.risk-note {
  margin: 32rpx 40rpx 0;
  font-size: 24rpx;
  color: var(--graphite);
  line-height: 1.6;
}

/* 8. 分享 CTA */
.bottom-share {
  margin: 48rpx 28rpx 0;
  background: var(--pure-white);
  border-radius: 40rpx;
  padding: 36rpx 32rpx;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}
.bs-copy {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 600;
  text-align: center;
}
.share-pill {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  height: 88rpx;
  border-radius: 9999rpx;
  background: var(--apricot-wash);
  color: var(--rust);
  font-size: 29rpx;
  font-weight: 600;
  border: none;
  line-height: 1;
  box-sizing: border-box;
  padding: 0 44rpx;
}
.share-pill::after {
  border: none;
}
.share-pill:active {
  transform: scale(0.97);
}
.share-pill-icon {
  width: 36rpx;
  height: 36rpx;
  background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%20fill='none'%3E%3Cpath%20d='M12%203v11'%20stroke='%235d2a1a'%20stroke-width='2'%20stroke-linecap='round'/%3E%3Cpath%20d='M8%207l4-4%204%204'%20stroke='%235d2a1a'%20stroke-width='2'%20stroke-linecap='round'%20stroke-linejoin='round'/%3E%3Cpath%20d='M5%2012v6a2%202%200%20002%202h10a2%202%200%20002-2v-6'%20stroke='%235d2a1a'%20stroke-width='2'%20stroke-linecap='round'/%3E%3C/svg%3E");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  flex-shrink: 0;
}
