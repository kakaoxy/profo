/* 我的客户页（漏斗统计卡对齐 valuation/mine，列表/空态对齐 bookings/mine） */

.page {
  --brand: #2563eb;
  --brand-weak: #eef4ff;
  --ink: #17191c;
  --ink-2: #777b86;
  --ink-3: #a5a9b3;
  --line: #f2f3f5;
  min-height: 100vh;
  background: #f7f7f8;
}

/* ===== 加载态 ===== */
.state-box {
  padding: 120rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.state-text {
  font-size: 28rpx;
  color: var(--ink-2);
}

/* ===== 统计卡（昨日/累计两行漏斗） ===== */
.stats {
  margin: 24rpx 32rpx 0;
  background: #ffffff;
  border-radius: 28rpx;
}
.stats-row {
  display: grid;
  grid-template-columns: 84rpx repeat(4, 1fr);
  align-items: center;
  padding: 24rpx 0;
}
.stats-row + .stats-row {
  border-top: 2rpx solid var(--line);
}
/* 行标签（昨日/累计）：紧凑置灰 */
.stats-tag {
  text-align: center;
  font-size: 20rpx;
  color: var(--ink-3);
}
.stat {
  text-align: center;
}
.stat + .stat {
  border-left: 2rpx solid var(--line);
}
.stat-num {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}
.stat-label {
  display: block;
  font-size: 20rpx;
  color: var(--ink-2);
  margin-top: 8rpx;
  line-height: 1.4;
  padding: 0 4rpx;
}
.stat--hl .stat-num {
  color: var(--brand);
}

/* ===== 归因客户列表 ===== */
.list {
  padding: 20rpx 32rpx 0;
}
.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}
.c-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
/* 脱敏手机号：大字加粗（等宽数字） */
.c-phone {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 0.6rpx;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}
/* 无联系方式（客户未授权手机号）：次级灰字 */
.c-phone--empty {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--ink-3);
}
/* 「预约客户」标签：品牌蓝弱底 */
.c-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 500;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(37, 99, 235, 0.09);
  color: var(--brand);
}
.c-title {
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.c-community {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.c-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid var(--line);
}
.c-desc {
  font-size: 24rpx;
  color: var(--ink-2);
}
.c-time {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--ink-3);
}
/* 描述为空时时间独占一行，margin-left:auto 保持靠右 */
.c-time--solo {
  margin-left: auto;
}
.leads-empty {
  text-align: center;
  font-size: 26rpx;
  color: var(--ink-2);
  padding: 80rpx 0;
}
.more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0 20rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

/* ===== 游客 / 空态 ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 80rpx 0;
  text-align: center;
}
.e-ill {
  position: relative;
  width: 380rpx;
  height: 304rpx;
}
.e-glow {
  position: absolute;
  left: 50%;
  top: 46%;
  transform: translate(-50%, -50%);
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(37, 99, 235, 0.14) 0%, rgba(37, 99, 235, 0) 68%);
}
.e-card {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 296rpx;
  height: 192rpx;
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 20rpx 52rpx rgba(23, 25, 28, 0.08);
  padding: 36rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.e-pic {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: var(--brand-weak);
  flex-shrink: 0;
}
.e-lines {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.e-bar {
  height: 16rpx;
  border-radius: 8rpx;
  background: #eef0f4;
}
.e-bar--2 {
  background: #f1f2f6;
}
.e-badge {
  position: absolute;
  right: 16rpx;
  bottom: 8rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--brand);
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(37, 99, 235, 0.35);
}
.e-t {
  margin-top: 48rpx;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
}
.e-s {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.7;
}
.e-btn {
  margin-top: 52rpx;
  width: 400rpx;
  height: 88rpx;
  border: none;
  border-radius: 9999rpx;
  background: var(--brand);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
  box-shadow: 0 16rpx 36rpx rgba(37, 99, 235, 0.28);
}
.e-btn::after {
  border: none;
}

/* ===== 底部安全区 ===== */
.safe-bottom {
  height: 64rpx;
}
