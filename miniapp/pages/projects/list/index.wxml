<view class="page">
  <!-- 顶部品牌区 -->
  <view class="hero">
    <view class="hero-title">发现理想居所</view>
    <view class="hero-desc">实景交付、改造溯源、成交价真实可验，每一套都是品质标杆。</view>
    <view class="hero-tags">
      <view class="tag tag-primary">精装实景交付</view>
      <view class="tag tag-muted">成交价真实可验</view>
      <!-- 累计服务人数标签（可点击，跳转过往案例） -->
      <view class="tag tag-served" wx:if="{{servedCountVisible}}" hover-class="tag-served--hover" bindtap="onServedTagTap">
        <block wx:if="{{servedCountLoading}}">累计服务···组家庭</block>
        <block wx:else>累计服务<text class="tag-served__num">{{servedCountDisplay}}</text>组家庭</block>
        <text class="tag-served__arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 吸顶控件区：搜索 + 状态 tab + 属性筛选 -->
  <view class="sticky-controls">
    <!-- 搜索栏：轻量、不抢视觉 -->
    <view class="search-row">
      <view class="search-input-wrap">
        <view class="search-icon"></view>
        <input
          class="search-input"
          type="text"
          placeholder="搜索小区、商圈"
          value="{{searchValue}}"
          confirm-type="search"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
        />
      </view>
    </view>

    <!-- 状态 tab：纯文字 + 下划线 -->
    <view class="status-tabs">
      <view class="status-tab {{tab === 'all' ? 'status-tab--active' : ''}}" bindtap="onStatusTabChange" data-tab="all">全部</view>
      <view class="status-tab {{tab === 'on_sale' ? 'status-tab--active' : ''}}" bindtap="onStatusTabChange" data-tab="on_sale">在售房源</view>
      <view class="status-tab {{tab === 'renovating' ? 'status-tab--active' : ''}}" bindtap="onStatusTabChange" data-tab="renovating">装修中</view>
      <view class="status-tab {{tab === 'sold' ? 'status-tab--active' : ''}}" bindtap="onStatusTabChange" data-tab="sold">过往案例</view>
    </view>

    <!-- 属性筛选：极简文字 chips -->
    <view class="filter-wrap">
      <view class="filter-chips">
        <view
          class="filter-chip {{activeFilter === 'price' ? 'filter-chip--active' : ''}} {{priceKey ? 'filter-chip--selected' : ''}}"
          bindtap="onFilterPillTap"
          data-key="price"
        >
          <text>{{priceLabel}}</text>
          <view class="chevron"></view>
        </view>
        <view
          class="filter-chip {{activeFilter === 'layout' ? 'filter-chip--active' : ''}} {{layoutKey ? 'filter-chip--selected' : ''}}"
          bindtap="onFilterPillTap"
          data-key="layout"
        >
          <text>{{layoutLabel}}</text>
          <view class="chevron"></view>
        </view>
        <view
          class="filter-chip {{activeFilter === 'area' ? 'filter-chip--active' : ''}} {{areaKey ? 'filter-chip--selected' : ''}}"
          bindtap="onFilterPillTap"
          data-key="area"
        >
          <text>{{areaLabel}}</text>
          <view class="chevron"></view>
        </view>
        <view
          class="filter-chip {{activeFilter === 'floor' ? 'filter-chip--active' : ''}} {{(floorMin || floorMax) ? 'filter-chip--selected' : ''}}"
          bindtap="onFilterPillTap"
          data-key="floor"
        >
          <text>{{floorLabel}}</text>
          <view class="chevron"></view>
        </view>
      </view>

      <!-- 下拉面板：价格 -->
      <view wx:if="{{activeFilter === 'price'}}" class="filter-panel">
        <view
          class="filter-option {{priceKey === item.key ? 'filter-option--selected' : ''}}"
          wx:for="{{priceOptions}}"
          wx:key="key"
          data-filter="price"
          data-key="{{item.key}}"
          bindtap="onFilterOptionTap"
        >{{item.label}}</view>
      </view>

      <!-- 下拉面板：户型 -->
      <view wx:if="{{activeFilter === 'layout'}}" class="filter-panel">
        <view
          class="filter-option {{layoutKey === item.key ? 'filter-option--selected' : ''}}"
          wx:for="{{layoutOptions}}"
          wx:key="key"
          data-filter="layout"
          data-key="{{item.key}}"
          bindtap="onFilterOptionTap"
        >{{item.label}}</view>
      </view>

      <!-- 下拉面板：面积 -->
      <view wx:if="{{activeFilter === 'area'}}" class="filter-panel">
        <view
          class="filter-option {{areaKey === item.key ? 'filter-option--selected' : ''}}"
          wx:for="{{areaOptions}}"
          wx:key="key"
          data-filter="area"
          data-key="{{item.key}}"
          bindtap="onFilterOptionTap"
        >{{item.label}}</view>
      </view>

      <!-- 下拉面板：楼层（min/max 数值输入） -->
      <view wx:if="{{activeFilter === 'floor'}}" class="filter-panel filter-panel--floor">
        <view class="floor-input-row">
          <input
            class="floor-input"
            type="number"
            placeholder="最低楼层"
            value="{{floorMin}}"
            bindinput="onFloorMinInput"
          />
          <text class="floor-sep">—</text>
          <input
            class="floor-input"
            type="number"
            placeholder="最高楼层"
            value="{{floorMax}}"
            bindinput="onFloorMaxInput"
          />
        </view>
        <view class="floor-actions">
          <view class="floor-btn floor-btn--ghost" bindtap="onFloorReset">重置</view>
          <view class="floor-btn floor-btn--primary" bindtap="onFloorConfirm">确定</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 计数行：房源计数 + 订阅提醒入口（subscribe_enabled=false 时整体隐藏） -->
  <view class="count-row">
    <text>共 {{total}} 套房源</text>
    <view
      wx:if="{{subscribeEnabled}}"
      class="notify-btn {{subscribeState === 'on' ? 'notify-btn--on' : ''}}"
      hover-class="notify-btn--hover"
      bindtap="onNotifyTap"
    >
      <view class="notify-btn__ico"></view>
      <text wx:if="{{subscribeState === 'on'}}">已订阅 · 可收 {{subscribeQuota}} 条</text>
      <text wx:elif="{{subscribeState === 'expired'}}">续订提醒</text>
      <text wx:else>订阅提醒</text>
      <view wx:if="{{subscribeState === 'expired'}}" class="notify-btn__dot"></view>
    </view>
  </view>

  <!-- 错误态 -->
  <view class="state" wx:if="{{error}}">
    <view class="state__text">加载失败，请重试</view>
    <view class="state__btn" bindtap="onRetry">重试</view>
  </view>

  <!-- 首次加载态 -->
  <view class="state" wx:if="{{!error && loading && items.length === 0}}">
    <view class="state__text">加载中...</view>
  </view>

  <!-- 列表区 -->
  <block wx:if="{{!error}}">
    <view
      class="list-card"
      wx:for="{{items}}"
      wx:key="id"
      bindtap="onItemTap"
      data-id="{{item.id}}"
    >
      <view class="list-thumb">
        <image
          wx:if="{{item.cover_thumbnail_url || item.cover_image}}"
          src="{{item.cover_thumbnail_url || item.cover_image}}"
          mode="aspectFill"
          lazy-load
        />
        <view class="list-badge {{item.badgeClass}}" wx:if="{{item.badgeText}}">{{item.badgeText}}</view>
        <!-- 新上黑标：右上角叠加（发布 ≤ 7 天） -->
        <view class="list-badge--new" wx:if="{{item.isNew}}">新上</view>
      </view>
      <view class="list-content">
        <view class="list-header">
          <view class="list-title">{{item.title}}</view>
          <view class="list-area">{{item.area}}</view>
        </view>
        <view class="list-desc">{{item.desc}}</view>
        <view class="list-footer">
          <view class="list-tags" wx:if="{{item.tags && item.tags.length > 0}}">
            <view
              class="tag tag-muted"
              wx:for="{{item.tags}}"
              wx:for-item="tag"
              wx:key="*this"
            >{{tag}}</view>
          </view>
          <view class="list-price">
            <text class="list-price__sym">¥</text>
            <text class="list-price__num">{{item.total_price}}</text>
            <text class="list-price__unit">万</text>
          </view>
        </view>
        <!-- 调价行：最近一次调价 ≤ 7 天才渲染（降价绿 chip / 涨价灰 chip） -->
        <view class="list-change" wx:if="{{item.changeText}}">
          <view class="list-change__chip {{item.changeClass}}">{{item.changeText}}</view>
          <text class="list-change__meta">{{item.changeMeta}}</text>
        </view>
      </view>
    </view>

    <!-- 空态 -->
    <view class="state" wx:if="{{!loading && items.length === 0}}">
      <view class="state__text">暂无房源</view>
    </view>

    <!-- 底部加载更多 -->
    <view class="footer" wx:if="{{items.length > 0}}">
      <view class="footer__text" wx:if="{{loadingMore}}">加载中...</view>
      <view class="footer__end" wx:elif="{{noMore}}">没有更多了</view>
    </view>
  </block>

  <!-- 底部留白避让 tabBar -->
  <view class="tabbar-safe-area"></view>

  <!-- 订阅弹层（半屏 Sheet）：mask 点击关闭 -->
  <view class="sheet-mask {{sheetVisible ? 'sheet-mask--show' : ''}}" bindtap="onSubscribeClose"></view>
  <view class="subscribe-sheet {{sheetVisible ? 'subscribe-sheet--show' : ''}}" catchtap="noop">
    <view class="subscribe-sheet__grab"></view>
    <view class="subscribe-sheet__title">房源动态提醒</view>
    <view class="subscribe-sheet__sub">新房源上架、价格调整时，第一时间通过微信服务通知告诉你。</view>
    <view class="subscribe-opt">
      <view class="subscribe-opt__ico subscribe-opt__ico--new">
        <view class="subscribe-opt__glyph subscribe-opt__glyph--home"></view>
      </view>
      <view class="subscribe-opt__txt">
        <view class="subscribe-opt__t">上新提醒</view>
        <view class="subscribe-opt__d">新房源上架发布时通知我</view>
      </view>
      <view class="subscribe-opt__quota {{sheetNewQuota > 0 ? '' : 'subscribe-opt__quota--zero'}}">可收 {{sheetNewQuota}} 条</view>
    </view>
    <view class="subscribe-opt">
      <view class="subscribe-opt__ico subscribe-opt__ico--price">
        <view class="subscribe-opt__glyph subscribe-opt__glyph--trend"></view>
      </view>
      <view class="subscribe-opt__txt">
        <view class="subscribe-opt__t">调价提醒</view>
        <view class="subscribe-opt__d">在售房源价格变动时通知我</view>
      </view>
      <view class="subscribe-opt__quota {{sheetPriceQuota > 0 ? '' : 'subscribe-opt__quota--zero'}}">可收 {{sheetPriceQuota}} 条</view>
    </view>
    <view class="subscribe-sheet__fine">微信一次性订阅：每次「允许」可收 1 条，可反复开启累计额度</view>
    <button class="subscribe-sheet__btn" hover-class="subscribe-sheet__btn--hover" bindtap="onSubscribeConfirm">开启提醒</button>
    <button class="subscribe-sheet__ghost" hover-class="subscribe-sheet__ghost--hover" bindtap="onSubscribeClose">暂不</button>
  </view>
</view>
