<view class="page">
  <!-- 顶部品牌区 -->
  <view class="hero">
    <view class="hero-title">发现理想居所</view>
    <view class="hero-desc">实景交付、改造溯源、成交价真实可验，每一套都是品质标杆。</view>
    <view class="hero-tags">
      <view class="tag tag-primary">精装实景交付</view>
      <view class="tag tag-muted">成交价真实可验</view>
    </view>
  </view>

  <!-- 吸顶控件区：搜索 + 状态 tab + 属性筛选 -->
  <view class="sticky-controls">
    <!-- 搜索栏：轻量、不抢视觉 -->
    <view class="search-row">
      <view class="search-input-wrap">
        <view class="search-icon"></view>
        <input
          class="search-input"
          type="text"
          placeholder="搜索小区、商圈"
          value="{{searchValue}}"
          confirm-type="search"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
        />
      </view>
    </view>

    <!-- 状态 tab：纯文字 + 下划线 -->
    <view class="status-tabs">
      <view class="status-tab {{tab === 'all' ? 'status-tab--active' : ''}}" bindtap="onStatusTabChange" data-tab="all">全部</view>
      <view class="status-tab {{tab === 'on_sale' ? 'status-tab--active' : ''}}" bindtap="onStatusTabChange" data-tab="on_sale">在售房源</view>
      <view class="status-tab {{tab === 'renovating' ? 'status-tab--active' : ''}}" bindtap="onStatusTabChange" data-tab="renovating">装修中</view>
      <view class="status-tab {{tab === 'sold' ? 'status-tab--active' : ''}}" bindtap="onStatusTabChange" data-tab="sold">过往案例</view>
    </view>

    <!-- 属性筛选：极简文字 chips -->
    <view class="filter-wrap">
      <view class="filter-chips">
        <view
          class="filter-chip {{activeFilter === 'price' ? 'filter-chip--active' : ''}} {{priceKey ? 'filter-chip--selected' : ''}}"
          bindtap="onFilterPillTap"
          data-key="price"
        >
          <text>{{priceLabel}}</text>
          <view class="chevron"></view>
        </view>
        <view
          class="filter-chip {{activeFilter === 'layout' ? 'filter-chip--active' : ''}} {{layoutKey ? 'filter-chip--selected' : ''}}"
          bindtap="onFilterPillTap"
          data-key="layout"
        >
          <text>{{layoutLabel}}</text>
          <view class="chevron"></view>
        </view>
        <view
          class="filter-chip {{activeFilter === 'area' ? 'filter-chip--active' : ''}} {{areaKey ? 'filter-chip--selected' : ''}}"
          bindtap="onFilterPillTap"
          data-key="area"
        >
          <text>{{areaLabel}}</text>
          <view class="chevron"></view>
        </view>
        <view
          class="filter-chip {{activeFilter === 'floor' ? 'filter-chip--active' : ''}} {{(floorMin || floorMax) ? 'filter-chip--selected' : ''}}"
          bindtap="onFilterPillTap"
          data-key="floor"
        >
          <text>{{floorLabel}}</text>
          <view class="chevron"></view>
        </view>
      </view>

      <!-- 下拉面板：价格 -->
      <view wx:if="{{activeFilter === 'price'}}" class="filter-panel">
        <view
          class="filter-option {{priceKey === item.key ? 'filter-option--selected' : ''}}"
          wx:for="{{priceOptions}}"
          wx:key="key"
          data-filter="price"
          data-key="{{item.key}}"
          bindtap="onFilterOptionTap"
        >{{item.label}}</view>
      </view>

      <!-- 下拉面板：户型 -->
      <view wx:if="{{activeFilter === 'layout'}}" class="filter-panel">
        <view
          class="filter-option {{layoutKey === item.key ? 'filter-option--selected' : ''}}"
          wx:for="{{layoutOptions}}"
          wx:key="key"
          data-filter="layout"
          data-key="{{item.key}}"
          bindtap="onFilterOptionTap"
        >{{item.label}}</view>
      </view>

      <!-- 下拉面板：面积 -->
      <view wx:if="{{activeFilter === 'area'}}" class="filter-panel">
        <view
          class="filter-option {{areaKey === item.key ? 'filter-option--selected' : ''}}"
          wx:for="{{areaOptions}}"
          wx:key="key"
          data-filter="area"
          data-key="{{item.key}}"
          bindtap="onFilterOptionTap"
        >{{item.label}}</view>
      </view>

      <!-- 下拉面板：楼层（min/max 数值输入） -->
      <view wx:if="{{activeFilter === 'floor'}}" class="filter-panel filter-panel--floor">
        <view class="floor-input-row">
          <input
            class="floor-input"
            type="number"
            placeholder="最低楼层"
            value="{{floorMin}}"
            bindinput="onFloorMinInput"
          />
          <text class="floor-sep">—</text>
          <input
            class="floor-input"
            type="number"
            placeholder="最高楼层"
            value="{{floorMax}}"
            bindinput="onFloorMaxInput"
          />
        </view>
        <view class="floor-actions">
          <view class="floor-btn floor-btn--ghost" bindtap="onFloorReset">重置</view>
          <view class="floor-btn floor-btn--primary" bindtap="onFloorConfirm">确定</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 下拉遮罩（点击关闭当前下拉） -->
  <view wx:if="{{activeFilter}}" class="filter-mask" bindtap="onFilterMaskTap"></view>

  <!-- 计数行 -->
  <view class="count-row">共 {{total}} 套房源</view>

  <!-- 错误态 -->
  <view class="state" wx:if="{{error}}">
    <view class="state__text">加载失败，请重试</view>
    <view class="state__btn" bindtap="onRetry">重试</view>
  </view>

  <!-- 首次加载态 -->
  <view class="state" wx:if="{{!error && loading && items.length === 0}}">
    <view class="state__text">加载中...</view>
  </view>

  <!-- 列表区 -->
  <block wx:if="{{!error}}">
    <view
      class="list-card"
      wx:for="{{items}}"
      wx:key="id"
      bindtap="onItemTap"
      data-id="{{item.id}}"
    >
      <view class="list-thumb">
        <image
          wx:if="{{item.cover_thumbnail_url || item.cover_image}}"
          src="{{item.cover_thumbnail_url || item.cover_image}}"
          mode="aspectFill"
        />
        <view class="list-badge {{item.badgeClass}}" wx:if="{{item.badgeText}}">{{item.badgeText}}</view>
      </view>
      <view class="list-content">
        <view class="list-header">
          <view class="list-title">{{item.title}}</view>
          <view class="list-area">{{item.area}}</view>
        </view>
        <view class="list-desc">{{item.desc}}</view>
        <view class="list-footer">
          <view class="list-tags" wx:if="{{item.tags && item.tags.length > 0}}">
            <view
              class="tag tag-muted"
              wx:for="{{item.tags}}"
              wx:for-item="tag"
              wx:key="*this"
            >{{tag}}</view>
          </view>
          <view class="list-price">
            <text class="list-price__sym">¥</text>
            <text class="list-price__num">{{item.total_price}}</text>
            <text class="list-price__unit">万</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 空态 -->
    <view class="state" wx:if="{{!loading && items.length === 0}}">
      <view class="state__text">暂无房源</view>
    </view>

    <!-- 底部加载更多 -->
    <view class="footer" wx:if="{{items.length > 0}}">
      <view class="footer__text" wx:if="{{loadingMore}}">加载中...</view>
      <view class="footer__end" wx:elif="{{noMore}}">没有更多了</view>
    </view>
  </block>

  <!-- 底部留白避让 tabBar -->
  <view class="tabbar-safe-area"></view>
</view>
