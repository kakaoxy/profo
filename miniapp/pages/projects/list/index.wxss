.page {
  min-height: 100vh;
  background-color: var(--fog);
  padding-bottom: 32rpx;
}

/* 顶部品牌区 */
.list-hero {
  position: relative;
  background: var(--pure-white);
  padding: 28rpx 40rpx 32rpx;
  overflow: hidden;
}
.list-hero::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(251, 225, 209, 0.7) 0%, transparent 70%);
  pointer-events: none;
}
.list-hero-title {
  position: relative;
  font-family: Georgia, "Songti SC", serif;
  font-size: 44rpx;
  font-weight: 500;
  line-height: 1.1;
}
.list-hero-desc {
  position: relative;
  font-size: 26rpx;
  color: var(--ash);
  line-height: 1.55;
  margin-top: 16rpx;
}
.list-hero-tags {
  position: relative;
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  flex-wrap: wrap;
}

/* 搜索入口 */
.search-box {
  margin: 24rpx 40rpx 0;
  height: 104rpx;
  background: var(--fog);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  color: var(--graphite);
  font-size: 28rpx;
}
.search-box__icon {
  font-size: 32rpx;
}

/* 状态 tab */
.status-tabs {
  display: flex;
  overflow-x: auto;
  white-space: nowrap;
  padding: 24rpx 40rpx 0;
  -webkit-overflow-scrolling: touch;
}
.status-tabs::-webkit-scrollbar {
  display: none;
}
.status-tab {
  flex-shrink: 0;
  display: inline-block;
  padding: 16rpx 28rpx;
  border-radius: 9999rpx;
  font-size: 26rpx;
  color: var(--graphite);
  margin-right: 12rpx;
}
.status-tab--active {
  background: var(--apricot-wash);
  color: var(--rust);
  font-weight: 500;
}

/* 筛选条 */
.filter-bar {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 40rpx;
  background: var(--pure-white);
  overflow-x: auto;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
}
.filter-bar::-webkit-scrollbar {
  display: none;
}
.filter-pill {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  background: var(--fog);
  border-radius: 9999rpx;
  font-size: 26rpx;
  color: var(--ash);
}

/* 计数行 */
.count-row {
  padding: 16rpx 40rpx;
  font-size: 26rpx;
  color: var(--graphite);
}

/* 房源卡片 */
.list-card {
  display: flex;
  gap: 28rpx;
  background: var(--pure-white);
  border-radius: 40rpx;
  margin: 0 40rpx 24rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}
.list-thumb {
  position: relative;
  width: 192rpx;
  height: 192rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #e8e4df 0%, #d4cfc8 100%);
  flex-shrink: 0;
  overflow: hidden;
}
.list-thumb image {
  width: 100%;
  height: 100%;
  border-radius: 32rpx;
}
.list-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 10rpx 20rpx;
  border-radius: 9999rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.badge-apricot {
  background: rgba(255, 255, 255, 0.95);
  color: var(--rust);
}
.badge-sky {
  background: rgba(255, 255, 255, 0.95);
  color: #2a5ca0;
}
.badge-fog {
  background: rgba(255, 255, 255, 0.95);
  color: var(--graphite);
}
.list-content {
  flex: 1;
  min-width: 0;
}
.list-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.list-desc {
  font-size: 24rpx;
  color: var(--graphite);
  margin-bottom: 16rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.list-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}
.list-tags .chip {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
}
.list-price {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--rust);
}

/* 通用状态（加载/空/错误） */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
}
.state__text {
  font-size: 28rpx;
  color: var(--graphite);
  margin-bottom: 24rpx;
}
.state__btn {
  font-size: 28rpx;
  color: #ffffff;
  background-color: var(--ink);
  border-radius: 9999rpx;
  padding: 16rpx 48rpx;
}

/* 底部加载更多 */
.footer {
  padding: 32rpx 0;
  text-align: center;
}
.footer__text {
  font-size: 26rpx;
  color: var(--graphite);
}
