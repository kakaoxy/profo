<view class="page">
  <!-- 加载态 -->
  <view wx:if="{{loading}}" class="state">
    <text>加载中...</text>
  </view>

  <!-- 404 态 -->
  <view wx:elif="{{notFound}}" class="state">
    <text>项目不存在</text>
  </view>

  <!-- 错误态 -->
  <view wx:elif="{{error}}" class="state">
    <text class="state-text">加载失败，请稍后重试</text>
    <button class="retry-btn" size="mini" bindtap="onRetry">重试</button>
  </view>

  <!-- 详情态 -->
  <block wx:elif="{{detail}}">
    <!-- 图集（图片 + 视频） -->
    <swiper
      wx:if="{{gallery.length}}"
      class="gallery"
      indicator-dots
      indicator-active-color="#ffffff"
      indicator-color="rgba(255,255,255,0.5)"
      circular
    >
      <swiper-item wx:for="{{gallery}}" wx:key="url" data-url="{{item.url}}">
        <image
          wx:if="{{item.type === 'image'}}"
          class="gallery-img"
          src="{{item.url}}"
          mode="aspectFill"
          bindtap="onImageTap"
        />
        <video
          wx:else
          class="gallery-img"
          src="{{item.url}}"
          controls
          object-fit="cover"
        />
      </swiper-item>
    </swiper>
    <view wx:else class="gallery gallery-placeholder">
      <text>暂无图片</text>
    </view>

    <!-- 详情主体（上浮白卡） -->
    <view class="detail-body">
      <!-- 标题区 -->
      <view class="detail-head">
        <view class="detail-price">¥ {{detail.total_price}} 万</view>
        <view class="detail-title">{{detail.title}}</view>
        <view wx:if="{{detail.tags && detail.tags.length}}" class="detail-chips">
          <text
            wx:for="{{detail.tags}}"
            wx:for-item="tag"
            wx:key="*this"
            class="{{index===0 ? 'chip chip-apricot' : index===1 ? 'chip chip-sky' : 'chip chip-fog'}}"
            >{{tag}}</text
          >
        </view>
      </view>

      <!-- 基础信息 -->
      <view class="info-grid">
        <view class="info-item">
          <view class="info-label">总价</view>
          <view class="info-value">{{detail.total_price}}万</view>
        </view>
        <view class="info-item">
          <view class="info-label">单价</view>
          <view class="info-value">{{detail.unit_price}}万/㎡</view>
        </view>
        <view class="info-item">
          <view class="info-label">户型</view>
          <view class="info-value">{{detail.layout}}</view>
        </view>
        <view class="info-item">
          <view class="info-label">面积</view>
          <view class="info-value">{{detail.area}}㎡</view>
        </view>
        <view class="info-item">
          <view class="info-label">楼层</view>
          <view class="info-value">{{detail.floor_info}}</view>
        </view>
        <view class="info-item">
          <view class="info-label">朝向</view>
          <view class="info-value">{{detail.orientation}}</view>
        </view>
      </view>

      <!-- 小区信息 -->
      <view class="detail-section">
        <view class="section-title">小区信息</view>
        <view class="community-card">
          <view class="community-name">📍{{detail.community_name || '—'}}</view>
          <view class="community-rows">
            <!-- ⚠️TODO 待后端补小区详情字段：所在位置/建成年代/绿化率/配套 -->
            <view class="community-row">
              <text class="k">所在位置</text>
              <text class="v">—</text>
            </view>
            <view class="community-row">
              <text class="k">建成年代</text>
              <text class="v">—</text>
            </view>
            <view class="community-row">
              <text class="k">绿化率</text>
              <text class="v">—</text>
            </view>
            <view class="community-row">
              <text class="k">配套</text>
              <text class="v">—</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 改造过程 -->
      <view class="detail-section">
        <view class="section-title">改造过程</view>
        <view class="renovation-hort">
          <view
            wx:for="{{stages}}"
            wx:for-item="stage"
            wx:key="stage"
            class="renovation-card"
          >
            <!-- ⚠️TODO API 暂无阶段首图，renovation-img 用渐变占位，待后端补阶段图片字段 -->
            <view class="renovation-img">
              <view class="badge">{{stage.stage}}</view>
            </view>
            <view class="renovation-name">{{stage.stage}}</view>
            <view class="renovation-meta">{{stage.meta}}</view>
          </view>
        </view>
      </view>

      <!-- 房源特色 -->
      <view wx:if="{{detail.description}}" class="detail-section">
        <view class="section-title">房源特色</view>
        <view class="feature-text">{{detail.description}}</view>
      </view>

      <!-- 底部留白（避让固定底栏） -->
      <view style="height: 200rpx;"></view>
    </view>

    <!-- 固定底栏 -->
    <view class="detail-footer">
      <button class="btn-secondary footer-btn" bindtap="onAddWechat">添加微信</button>
      <button class="btn-primary footer-btn" bindtap="onCallPhone">电话联系</button>
    </view>
  </block>
</view>
