<view class="page">
  <!-- 加载态 -->
  <view wx:if="{{loading}}" class="state">
    <text>加载中...</text>
  </view>

  <!-- 404 态 -->
  <view wx:elif="{{notFound}}" class="state">
    <text>项目不存在</text>
  </view>

  <!-- 错误态 -->
  <view wx:elif="{{error}}" class="state">
    <text class="state-text">加载失败，请稍后重试</text>
    <button class="retry-btn" size="mini" bindtap="onRetry">重试</button>
  </view>

  <!-- 详情态 -->
  <block wx:elif="{{detail}}">
    <!-- 右上角分享按钮 -->
    <button class="share-btn" open-type="share" aria-label="分享">分享</button>

    <!-- 图集（图片 + 视频） -->
    <swiper
      wx:if="{{gallery.length}}"
      class="gallery"
      indicator-dots
      indicator-active-color="#ffffff"
      indicator-color="rgba(255,255,255,0.5)"
      circular
    >
      <swiper-item class="gallery-item" wx:for="{{gallery}}" wx:key="url" data-url="{{item.url}}">
        <image
          wx:if="{{item.type === 'image'}}"
          class="gallery-img"
          src="{{item.url}}"
          mode="aspectFill"
          data-url="{{item.url}}"
          bindtap="onMediaTap"
        />
        <block wx:else>
          <image
            wx:if="{{item.poster}}"
            class="gallery-img"
            src="{{item.poster}}"
            mode="aspectFill"
            data-url="{{item.url}}"
            bindtap="onMediaTap"
          />
          <view
            wx:else
            class="gallery-img gallery-video-placeholder"
            data-url="{{item.url}}"
            bindtap="onMediaTap"
          ></view>
          <view class="play-btn" data-url="{{item.url}}" bindtap="onMediaTap">
            <view class="play-triangle"></view>
          </view>
        </block>
      </swiper-item>
    </swiper>
    <view wx:else class="gallery gallery-placeholder">
      <text>暂无图片</text>
    </view>

    <!-- 详情主体（上浮白卡） -->
    <view class="detail-body">
      <!-- 标题区 -->
      <view class="detail-head">
        <view class="detail-price">¥ {{detail.total_price}} 万</view>
        <view class="detail-title">{{detail.title}}</view>
        <view wx:if="{{detail.tags && detail.tags.length}}" class="detail-chips">
          <text
            wx:for="{{detail.tags}}"
            wx:for-item="tag"
            wx:key="*this"
            class="{{index===0 ? 'chip chip-apricot' : index===1 ? 'chip chip-sky' : 'chip chip-fog'}}"
            >{{tag}}</text
          >
        </view>
      </view>

      <!-- 基础信息 -->
      <view class="info-grid">
        <view class="info-item">
          <view class="info-label">总价</view>
          <view class="info-value">{{detail.total_price}}万</view>
        </view>
        <view class="info-item">
          <view class="info-label">单价</view>
          <view class="info-value">{{detail.unit_price}}万/㎡</view>
        </view>
        <view class="info-item">
          <view class="info-label">户型</view>
          <view class="info-value">{{detail.layout}}</view>
        </view>
        <view class="info-item">
          <view class="info-label">面积</view>
          <view class="info-value">{{detail.area}}㎡</view>
        </view>
        <view class="info-item">
          <view class="info-label">楼层</view>
          <view class="info-value">{{detail.floor_info}}</view>
        </view>
        <view class="info-item">
          <view class="info-label">朝向</view>
          <view class="info-value">{{detail.orientation}}</view>
        </view>
      </view>

      <!-- 改造过程 -->
      <view wx:if="{{hasRenovationPhotos}}" class="detail-section">
        <view class="section-title">改造过程</view>
        <view class="renovation-hort">
          <view
            wx:for="{{stages}}"
            wx:for-item="stage"
            wx:key="stage"
            class="renovation-card {{stage.clickable ? 'renovation-card--clickable' : ''}}"
            hover-class="{{stage.clickable ? 'renovation-card--hover' : ''}}"
            hover-stay-time="100"
            data-stage="{{stage.stage}}"
            bindtap="onStageTap"
          >
            <view class="renovation-img">
              <image
                wx:if="{{stage.cover}}"
                class="renovation-cover"
                src="{{stage.cover}}"
                mode="aspectFill"
              />
              <view wx:else class="renovation-placeholder"></view>
              <view class="badge">{{stage.stage}}</view>
              <view wx:if="{{stage.photoCount > 0}}" class="photo-count">{{stage.photoCount}}</view>
            </view>
            <view class="renovation-name">{{stage.stage}}</view>
            <view class="renovation-meta">
              <block wx:if="{{stage.status === 'completed'}}">完成于 {{stage.completedDate}}</block>
              <block wx:elif="{{stage.status === 'in_progress'}}">进行中 · {{stage.photoCount}}张</block>
              <block wx:else>待开始</block>
            </view>
          </view>
        </view>
      </view>

      <!-- 房源特色 -->
      <view wx:if="{{detail.description}}" class="detail-section">
        <view class="section-title">房源特色</view>
        <view class="feature-text">{{detail.description}}</view>
      </view>

      <!-- 员工专属入口：我的客户（分享漏斗 + 归因预约客户） -->
      <view
        wx:if="{{employeeId}}"
        class="staff-entry"
        hover-class="staff-entry--hover"
        hover-stay-time="100"
        bindtap="onMyCustomersTap"
      >
        <view class="staff-entry-icon">客</view>
        <view class="staff-entry-info">
          <view class="staff-entry-title">我的客户</view>
          <view class="staff-entry-sub">查看分享带来的预约客户</view>
        </view>
        <view class="staff-entry-arrow">›</view>
      </view>

      <!-- 底部留白（避让固定底栏） -->
      <view style="height: 200rpx;"></view>
    </view>

    <!-- 固定底栏：顾问卡片 + 想看房 -->
    <view class="detail-footer">
      <view wx:if="{{booked}}" class="booked-tip">已预约，工作人员将在24小时内电话联系您</view>
      <view class="footer-main">
        <view class="advisor">
          <image class="advisor-avatar" src="{{contactAvatarUrl}}" wx:if="{{contactAvatarUrl}}" />
          <view class="advisor-avatar advisor-avatar--fallback" wx:else>{{contactFallbackChar}}</view>
          <view class="advisor-info">
            <text class="advisor-name">{{contact.nickname}}</text>
            <text class="advisor-role">{{contactRoleText}}</text>
          </view>
        </view>
        <button
          class="btn-primary btn-book {{booked ? 'btn-book--done' : ''}}"
          bindtap="onBookTap"
          disabled="{{booked}}"
          loading="{{bookingSubmitting}}"
        >
          {{booked ? '已预约' : '想看房'}}
        </button>
      </view>
    </view>

    <!-- 手机号授权弹层（想看房未绑手机号时引导微信一键绑定） -->
    <view wx:if="{{phoneAuthVisible}}" class="phone-mask">
      <view class="phone-modal">
        <view class="phone-title">绑定手机号</view>
        <view class="phone-desc">预约看房需先绑定手机号，工作人员将通过电话与您联系</view>
        <view class="phone-actions">
          <button
            class="phone-btn"
            open-type="getPhoneNumber"
            bindgetphonenumber="onPhoneAuth"
            loading="{{bookingSubmitting}}"
          >微信一键绑定并预约</button>
          <button class="phone-cancel" bindtap="onPhoneAuthCancel">取消</button>
        </view>
      </view>
    </view>

    <!-- 阶段照片轮播弹层 -->
    <view wx:if="{{stageViewer.visible}}" class="stage-viewer" catchtap="onViewerClose">
      <view class="stage-viewer-inner" catchtap="">
        <view class="stage-viewer-header">
          <text class="stage-viewer-title">{{stageViewer.stage}} · {{stageViewer.current + 1}}/{{stageViewer.photos.length}}</text>
          <view class="stage-viewer-close" bindtap="onViewerClose">×</view>
        </view>
        <swiper
          class="stage-viewer-swiper"
          current="{{stageViewer.current}}"
          bindchange="onViewerChange"
          indicator-dots
          indicator-active-color="#ffffff"
          indicator-color="rgba(255,255,255,0.5)"
          circular
        >
          <swiper-item wx:for="{{stageViewer.photos}}" wx:key="*this">
            <image class="stage-viewer-img" src="{{item}}" mode="aspectFit" />
          </swiper-item>
        </swiper>
      </view>
    </view>
  </block>
</view>
