.page {
  min-height: 100vh;
  background: var(--fog);
}

.state {
  padding: 400rpx 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--graphite);
}

.state-text {
  font-size: 28rpx;
}

.retry-btn {
  margin-top: 32rpx;
}

.gallery {
  width: 100%;
  height: 640rpx;
}

.gallery-img {
  width: 100%;
  height: 100%;
  display: block;
}

.gallery video.gallery-img {
  background: #000;
}

.gallery-placeholder {
  background: var(--fog);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--graphite);
}

.detail-body {
  position: relative;
  z-index: 2;
  margin-top: -48rpx;
  padding: 48rpx 40rpx;
  background: var(--pure-white);
  border-radius: 56rpx 56rpx 0 0;
}

.detail-head {
  margin-bottom: 44rpx;
}

.detail-price {
  font-size: 64rpx;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.detail-chips {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.info-item {
  background: var(--fog);
  border-radius: 32rpx;
  padding: 28rpx;
}

.info-label {
  font-size: 24rpx;
  color: var(--graphite);
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 30rpx;
  font-weight: 500;
}

.detail-section {
  margin-bottom: 48rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}

.community-card {
  background: var(--fog);
  border-radius: 36rpx;
  padding: 32rpx;
}

.community-name {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}

.community-rows {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.community-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
}

.community-row .k {
  color: var(--graphite);
}

.community-row .v {
  font-weight: 500;
}

.renovation-hort {
  display: flex;
  gap: 24rpx;
  white-space: nowrap;
  padding: 4rpx 4rpx 16rpx;
  overflow-x: auto;
}

.renovation-hort::-webkit-scrollbar {
  display: none;
}

.renovation-card {
  flex-shrink: 0;
  width: 256rpx;
  display: inline-block;
}

.renovation-img {
  position: relative;
  width: 256rpx;
  height: 256rpx;
  margin-bottom: 16rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #e8e4df 0%, #d4cfc8 100%);
}

.renovation-img .badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 9999rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--rust);
}

.renovation-name {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.renovation-meta {
  font-size: 24rpx;
  color: var(--graphite);
}

.feature-text {
  font-size: 28rpx;
  color: var(--ash);
  line-height: 1.6;
}

.detail-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 90;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 40rpx 48rpx;
  background: var(--pure-white);
  border-top: 2rpx solid rgba(163, 166, 175, 0.3);
}

.footer-btn {
  flex: 1;
  margin: 0;
}

.footer-btn.btn-secondary {
  border: 2rpx solid var(--dove);
}
