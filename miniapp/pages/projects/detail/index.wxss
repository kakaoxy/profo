.page {
  position: relative;
  min-height: 100vh;
  background: var(--fog);
}

/* 右上角分享按钮 */
.share-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.4);
  color: #fff;
  font-size: 26rpx;
  line-height: 1;
}

.share-btn::after {
  border: none;
}

.state {
  padding: 400rpx 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--graphite);
}

.state-text {
  font-size: 28rpx;
}

.retry-btn {
  margin-top: 32rpx;
}

.gallery {
  width: 100%;
  height: 640rpx;
}

.gallery-item {
  width: 100%;
  height: 640rpx;
}

.gallery-img {
  width: 100%;
  height: 100%;
  display: block;
}

.gallery video.gallery-img {
  background: #000;
}

.gallery-placeholder {
  background: var(--fog);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--graphite);
}

.detail-body {
  position: relative;
  z-index: 2;
  margin-top: -48rpx;
  padding: 48rpx 40rpx;
  background: var(--pure-white);
  border-radius: 56rpx 56rpx 0 0;
}

.detail-head {
  margin-bottom: 44rpx;
}

.detail-price {
  font-size: 64rpx;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.detail-chips {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.info-item {
  background: var(--fog);
  border-radius: 32rpx;
  padding: 28rpx;
}

.info-label {
  font-size: 24rpx;
  color: var(--graphite);
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 30rpx;
  font-weight: 500;
}

.detail-section {
  margin-bottom: 48rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}

.renovation-hort {
  display: flex;
  gap: 24rpx;
  white-space: nowrap;
  padding: 4rpx 4rpx 16rpx;
  overflow-x: auto;
}

.renovation-hort::-webkit-scrollbar {
  display: none;
}

.renovation-card {
  flex-shrink: 0;
  width: 256rpx;
  display: inline-block;
}

.renovation-card--clickable {
  cursor: pointer;
}

.renovation-card--hover {
  opacity: 0.85;
}

.renovation-img {
  position: relative;
  width: 256rpx;
  height: 256rpx;
  margin-bottom: 16rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: var(--fog);
}

.renovation-cover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.renovation-placeholder {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, #e8e4df 0%, #d4cfc8 100%);
}

.renovation-img .badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 9999rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--rust);
  z-index: 2;
}

.renovation-img .photo-count {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 12rpx;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 9999rpx;
  font-size: 22rpx;
  color: #fff;
  text-align: center;
  line-height: 36rpx;
  z-index: 2;
}

.renovation-name {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.renovation-meta {
  font-size: 24rpx;
  color: var(--graphite);
}

.feature-text {
  font-size: 28rpx;
  color: var(--ash);
  line-height: 1.6;
}

.detail-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 90;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 40rpx 48rpx;
  background: var(--pure-white);
  border-top: 2rpx solid rgba(163, 166, 175, 0.3);
}

.footer-btn {
  flex: 1;
  margin: 0;
}

.footer-btn.btn-secondary {
  border: 2rpx solid var(--dove);
}

/* 阶段照片轮播弹层 */
.stage-viewer {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
}

.stage-viewer-inner {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.stage-viewer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 40rpx 24rpx;
}

.stage-viewer-title {
  font-size: 28rpx;
  color: #fff;
}

.stage-viewer-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 40rpx;
  color: #fff;
}

.stage-viewer-swiper {
  flex: 1;
  width: 100%;
}

.stage-viewer-img {
  width: 100%;
  height: 100%;
  display: block;
}
