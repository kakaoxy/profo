.page {
  position: relative;
  min-height: 100vh;
  background: var(--fog);
}

/* 右上角分享按钮：用 line-height=text-height 居中，避免 flex 在 button 上失效导致椭圆；
   遮罩提至 0.6：M-02 白字在最亮图上仍 ≥4.5:1（0.4 时仅 3.02） */
.share-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  z-index: 20;
  box-sizing: border-box;
  width: 88rpx;
  height: 88rpx;
  min-width: 88rpx;
  max-width: 88rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 24rpx;
  line-height: 88rpx;
  text-align: center;
  overflow: hidden;
}

.share-btn::after {
  border: none;
}

/* 通用状态页（m-03）：图标 + 主文案 + 副文案 + 动作按钮 */
.state {
  padding: 280rpx 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--graphite);
}

/* 状态图标：fog 底圆形 + graphite 感叹号（纯 CSS，无图片资源） */
.state-ic {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--fog);
  color: var(--graphite);
  font-size: 56rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.state-text {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
}

.state-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--graphite);
}

/* 状态页动作按钮（m-02：热区 ≥44px） */
.state-btn {
  margin: 40rpx 0 0;
  min-width: 240rpx;
  min-height: 44px;
  padding: 0 48rpx;
  border: none;
  border-radius: 9999rpx;
  background: var(--ink);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.state-btn::after {
  border: none;
}

/* 加载骨架屏（m-03）：静态雾色块占位，避免首屏布局跳变（无动效，尊重 reduced-motion） */
.sk-gallery {
  height: 640rpx;
  background: var(--fog);
}

.sk-card {
  margin-top: -48rpx;
  padding: 48rpx 40rpx;
  background: var(--pure-white);
  border-radius: 56rpx 56rpx 0 0;
}

.sk-line {
  height: 40rpx;
  border-radius: 12rpx;
  background: var(--fog);
}

.sk-line--price {
  width: 40%;
  margin-bottom: 24rpx;
}

.sk-line--title {
  width: 75%;
  margin-bottom: 40rpx;
}

.sk-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.sk-cell {
  height: 140rpx;
  border-radius: 32rpx;
  background: var(--fog);
}

.gallery {
  width: 100%;
  height: 640rpx;
}

.gallery-item {
  position: relative;
  width: 100%;
  height: 640rpx;
}

.gallery-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 视频无封面(thumbnail_url 为空)时的黑色占位 */
.gallery-video-placeholder {
  background: #000;
}

/* 视频封面上的播放按钮 */
.play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.play-triangle {
  width: 0;
  height: 0;
  margin-left: 8rpx;
  border-left: 28rpx solid #fff;
  border-top: 18rpx solid transparent;
  border-bottom: 18rpx solid transparent;
}

.gallery-placeholder {
  background: var(--fog);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--graphite);
}

.detail-body {
  position: relative;
  z-index: 2;
  margin-top: -48rpx;
  padding: 48rpx 40rpx;
  background: var(--pure-white);
  border-radius: 56rpx 56rpx 0 0;
}

.detail-head {
  margin-bottom: 44rpx;
}

/* 标签行（B-01；状态徽章已移至价格行操作组，本行仅承载房源标签） */
.detail-chips-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.detail-chips-row .detail-chips {
  flex: 1 1 auto;
  min-width: 0;
}

.detail-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

/* 左侧价格组：价格与「挂牌价」口径 chip 作为一个整体，避免 chip 漂在行中间 */
.detail-price-main {
  display: flex;
  align-items: center;
  min-width: 0;
}

/* 右侧操作组（四轮迭代）：状态徽章 + 调价铃铛水平排列，替代原先的垂直堆叠 */
.detail-head-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.detail-price {
  font-size: 64rpx;
  font-weight: 500;
  color: var(--ink);
  /* M-03：主价格禁止折行（320px 视口下「¥ 228 万」被拆两行破坏首屏层级） */
  white-space: nowrap;
}

/* M-01：无有效价格时的「价格待定」缺省分支（字号降级，非成交报价） */
.detail-price--pending {
  font-size: 40rpx;
}

/* 320px 级小视口：主价格缩号，保证价格单行（M-03） */
@media (max-width: 339px) {
  .detail-price {
    font-size: 56rpx;
  }
}

/* 调价提醒图标钮（房源级订阅两态，纯图标无文字，用户反馈 2026-10-28）：
   未订阅 = ink 实心底 / 已订阅 = apricot-wash 暖底（沿用原胶囊两态色词汇，白卡上清晰可辨）；
   🔔 为 emoji，颜色由字形自绘，CSS color 仅作文本字形回退与无障碍语义兜底；
   88rpx=44px 保持 m-02 热区下限。
   正圆保障（用户反馈：真机上底色呈椭圆）：同页 share-btn 同款处理——min/max 锁尺寸 +
   line-height=高 + text-align 居中，不依赖 flex（真机上 flex 在 button 上可能失效导致椭圆） */
.price-alert-btn {
  flex-shrink: 0;
  width: 88rpx;
  min-width: 88rpx;
  max-width: 88rpx;
  height: 88rpx;
  min-height: 88rpx;
  max-height: 88rpx;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 50%;
  background: var(--ink, #1a1a1a);
  color: #ffffff;
  font-size: 40rpx;
  line-height: 88rpx;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
}

.price-alert-btn--on {
  color: var(--rust, #5d2a1a);
  background: var(--apricot-wash, #fbe1d1);
}

.price-alert-btn--hover {
  opacity: 0.82;
}

.price-alert-btn::after {
  border: none;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.detail-chips {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.info-item {
  background: var(--fog);
  border-radius: 32rpx;
  padding: 28rpx;
}

.info-label {
  font-size: 24rpx;
  color: var(--graphite);
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 30rpx;
  font-weight: 500;
}

/* 贷款参考卡（语言对齐 info-item：fog 底 · 32rpx 圆角；¥ 图标复用 clue-ic 的 apricot 词汇） */
.loan-card {
  margin: -24rpx 0 48rpx;
  padding: 32rpx;
  background: var(--fog);
  border-radius: 32rpx;
  cursor: pointer;
}

.loan-card--hover {
  opacity: 0.85;
}

.loan-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.loan-ic {
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  background: var(--apricot-wash);
  color: var(--rust);
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loan-ct {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.loan-link {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 25rpx;
  font-weight: 500;
  color: var(--graphite);
}

.loan-chev {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  border-right: 4rpx solid var(--dove);
  border-top: 4rpx solid var(--dove);
  transform: rotate(45deg);
}

.loan-nums {
  display: flex;
  align-items: stretch;
  gap: 36rpx;
  margin: 28rpx 0 24rpx;
  padding: 0 4rpx;
}

.loan-num {
  flex: 1;
  min-width: 0;
}

.loan-k {
  font-size: 24rpx;
  color: var(--graphite);
  margin-bottom: 6rpx;
}

.loan-v {
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: -0.02em;
  color: var(--ink);
  white-space: nowrap;
}

.loan-u {
  font-size: 25rpx;
  font-weight: 500;
  color: var(--graphite);
  margin-left: 6rpx;
}

.loan-sep {
  width: 2rpx;
  background: var(--dove);
  opacity: 0.5;
  flex-shrink: 0;
}

.loan-sum {
  font-size: 25rpx;
  color: var(--graphite);
}

.loan-sum-b {
  color: var(--rust);
  font-weight: 500;
}

/* 价格口径标注（广告法自查 P0-02）：小号灰字 chip，紧跟价格；
   22rpx=11px：m-01 中文可读性下限（原 20rpx 过小） */
.price-scope {
  margin-left: 12rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 9999rpx;
  background: rgba(0, 0, 0, 0.04);
  color: var(--graphite);
  white-space: nowrap;
}

/* 价格有效期说明（广告法自查 P1-04） */
.price-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--graphite);
}

/* 贷款口径提示：M-02 由 dove 提为 graphite（dove 不再作文字色，fog 底 5.0:1 达标） */
.loan-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--graphite);
}

.detail-section {
  margin-bottom: 48rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}

/* 右缘渐变 + 阶段计数（m-04）：提示改造过程可横滑，避免右缘卡片被硬切无感知 */
.renovation-scroll {
  position: relative;
}

.renovation-scroll::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 16rpx;
  width: 48rpx;
  background: linear-gradient(to left, rgba(255, 255, 255, 1), rgba(255, 255, 255, 0));
  pointer-events: none;
}

.renovation-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--graphite);
  text-align: right;
}

.renovation-hort {
  display: flex;
  gap: 24rpx;
  white-space: nowrap;
  padding: 4rpx 4rpx 16rpx;
  overflow-x: auto;
}

.renovation-hort::-webkit-scrollbar {
  display: none;
}

.renovation-card {
  flex-shrink: 0;
  width: 256rpx;
  display: inline-block;
}

.renovation-card--clickable {
  cursor: pointer;
}

.renovation-card--hover {
  opacity: 0.85;
}

.renovation-img {
  position: relative;
  width: 256rpx;
  height: 256rpx;
  margin-bottom: 16rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: var(--fog);
}

.renovation-cover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.renovation-placeholder {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, #e8e4df 0%, #d4cfc8 100%);
}

/* 阶段含视频但无封面时的深色占位 */
.renovation-placeholder--video {
  background: #000;
}

/* 阶段封面视频播放角标 */
.renovation-play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.renovation-play-triangle {
  width: 0;
  height: 0;
  margin-left: 6rpx;
  border-left: 20rpx solid #fff;
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
}

.renovation-img .badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 9999rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--rust);
  z-index: 2;
}

.renovation-img .photo-count {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 12rpx;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 9999rpx;
  font-size: 22rpx;
  color: #fff;
  text-align: center;
  line-height: 36rpx;
  z-index: 2;
}

.renovation-name {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.renovation-meta {
  font-size: 24rpx;
  color: var(--graphite);
}

/* 现场实景：营销视频纵向列表，内嵌播放 */
.site-videos {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.site-video {
  width: 100%;
  height: 380rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: #000;
}

.feature-text {
  font-size: 28rpx;
  color: var(--ash);
  line-height: 1.6;
}

/* 员工专属区块（分享提示 + 我的客户 + 分享给客户，Steep 配色）：白卡内 fog 底区块，卡片语言对齐 info-item */
.share-tip {
  margin-bottom: 48rpx;
  padding: 32rpx 40rpx;
  background: var(--fog);
  border-radius: 32rpx;
}

.share-tip-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.share-tip-sub {
  font-size: 26rpx;
  color: var(--graphite);
  line-height: 1.6;
}

/* dove 1px 分隔线 */
.staff-divider {
  height: 2rpx;
  background: var(--dove);
  margin: 24rpx 0 20rpx;
}

.clue-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 8rpx 0 4rpx;
}

.clue-ic {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: var(--apricot-wash);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.clue-ic-line {
  width: 30rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--rust);
}

.clue-ic-line--short {
  width: 20rpx;
}

.clue-tt {
  flex: 1;
  min-width: 0;
}

.clue-tt-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.clue-tt-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--graphite);
}

.clue-chev {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  border-right: 4rpx solid var(--dove);
  border-top: 4rpx solid var(--dove);
  transform: rotate(45deg);
}

.staff-btn-row {
  display: flex;
  gap: 20rpx;
  padding-top: 20rpx;
}

/* Steep 主按钮：ink 底白字 9999rpx 药丸 */
.staff-btn {
  flex: 1;
  height: 88rpx;
  border: none;
  border-radius: 9999rpx;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  padding: 0;
  margin: 0;
}

.staff-btn::after {
  border: none;
}

.staff-btn--pri {
  background: var(--ink);
  color: var(--pure-white);
}

.detail-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 90;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx 40rpx 48rpx;
  background: var(--pure-white);
  border-top: 2rpx solid rgba(163, 166, 175, 0.3);
}

/* 已预约提示行（footer 顶部居中） */
.booked-tip {
  font-size: 24rpx;
  color: var(--rust);
  text-align: center;
}

.footer-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

/* 顾问卡片：头像（缺省首字符占位）+ 名字 + 角色标签 */
.advisor {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.advisor-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.advisor-avatar--fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--fog);
  color: var(--graphite);
  font-size: 32rpx;
  font-weight: 500;
}

.advisor-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
}

.advisor-name {
  max-width: 100%;
  font-size: 28rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 角色标签：22rpx=11px（m-01 中文可读性下限，原 20rpx 过小） */
.advisor-role {
  margin-top: 6rpx;
  padding: 2rpx 16rpx;
  border-radius: 9999rpx;
  background: var(--apricot-wash);
  color: var(--rust);
  font-size: 22rpx;
}

/* 想看房按钮（btn-primary 全局底色，此处定宽不挤压卡片） */
.btn-book {
  flex-shrink: 0;
  min-width: 224rpx;
  margin: 0;
}

.btn-book--done {
  opacity: 0.7;
}

/* 手机号授权弹层（样式对齐 components/phone-bind-modal） */
.phone-mask {
  position: fixed;
  inset: 0;
  z-index: 1001;
  background: rgba(23, 25, 28, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.phone-modal {
  width: 600rpx;
  box-sizing: border-box;
  padding: 48rpx 40rpx;
  background: var(--pure-white);
  border-radius: 32rpx;
}

.phone-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink);
  text-align: center;
}

.phone-desc {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--graphite);
  line-height: 1.5;
  text-align: center;
}

.phone-actions {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.phone-btn {
  margin: 0;
  border: none;
  border-radius: 9999rpx;
  background: var(--ink);
  color: var(--pure-white);
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1;
  padding: 0 48rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.phone-btn::after {
  border: none;
}

.phone-cancel {
  margin: 0;
  border: none;
  background: transparent;
  color: var(--graphite);
  border-radius: 9999rpx;
  font-size: 28rpx;
  line-height: 1;
  padding: 0 48rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.phone-cancel::after {
