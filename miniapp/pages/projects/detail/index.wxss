.page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.state {
  padding: 200rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #888;
}

.state-text {
  font-size: 28rpx;
}

.retry-btn {
  margin-top: 32rpx;
}

.swiper {
  width: 100%;
  height: 480rpx;
}

.swiper-image {
  width: 100%;
  height: 480rpx;
  display: block;
}

.image-placeholder {
  width: 100%;
  height: 480rpx;
  background-color: #ececec;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
}

.section {
  margin: 16rpx 0;
  padding: 24rpx 32rpx;
  background-color: #ffffff;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
}

.tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
}

.tag {
  margin-right: 12rpx;
  margin-bottom: 8rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: #ff6b35;
  background-color: rgba(255, 107, 53, 0.1);
  border-radius: 4rpx;
}

.price-section {
  display: flex;
  flex-direction: column;
}

.total-price {
  font-size: 52rpx;
  font-weight: 700;
  color: #ff6b35;
  line-height: 1.2;
}

.price-unit {
  font-size: 24rpx;
  font-weight: 400;
}

.unit-price {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #999;
}

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.info-row .label {
  width: 160rpx;
  color: #999;
  flex-shrink: 0;
}

.info-row .value {
  flex: 1;
  color: #333;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.stage-card {
  border: 1rpx solid #eeeeee;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.stage-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stage-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.stage-photos {
  font-size: 26rpx;
  color: #999;
}

.stage-date {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.description {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}
