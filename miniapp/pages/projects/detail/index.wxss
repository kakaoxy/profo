.page {
  position: relative;
  min-height: 100vh;
  background: var(--fog);
}

/* 右上角分享按钮：用 line-height=text-height 居中，避免 flex 在 button 上失效导致椭圆 */
.share-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  z-index: 20;
  box-sizing: border-box;
  width: 88rpx;
  height: 88rpx;
  min-width: 88rpx;
  max-width: 88rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.4);
  color: #fff;
  font-size: 24rpx;
  line-height: 88rpx;
  text-align: center;
  overflow: hidden;
}

.share-btn::after {
  border: none;
}

.state {
  padding: 400rpx 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--graphite);
}

.state-text {
  font-size: 28rpx;
}

.retry-btn {
  margin-top: 32rpx;
}

.gallery {
  width: 100%;
  height: 640rpx;
}

.gallery-item {
  position: relative;
  width: 100%;
  height: 640rpx;
}

.gallery-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 视频无封面(thumbnail_url 为空)时的黑色占位 */
.gallery-video-placeholder {
  background: #000;
}

/* 视频封面上的播放按钮 */
.play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.play-triangle {
  width: 0;
  height: 0;
  margin-left: 8rpx;
  border-left: 28rpx solid #fff;
  border-top: 18rpx solid transparent;
  border-bottom: 18rpx solid transparent;
}

.gallery-placeholder {
  background: var(--fog);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--graphite);
}

.detail-body {
  position: relative;
  z-index: 2;
  margin-top: -48rpx;
  padding: 48rpx 40rpx;
  background: var(--pure-white);
  border-radius: 56rpx 56rpx 0 0;
}

.detail-head {
  margin-bottom: 44rpx;
}

.detail-price {
  font-size: 64rpx;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.detail-chips {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.info-item {
  background: var(--fog);
  border-radius: 32rpx;
  padding: 28rpx;
}

.info-label {
  font-size: 24rpx;
  color: var(--graphite);
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 30rpx;
  font-weight: 500;
}

.detail-section {
  margin-bottom: 48rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}

.renovation-hort {
  display: flex;
  gap: 24rpx;
  white-space: nowrap;
  padding: 4rpx 4rpx 16rpx;
  overflow-x: auto;
}

.renovation-hort::-webkit-scrollbar {
  display: none;
}

.renovation-card {
  flex-shrink: 0;
  width: 256rpx;
  display: inline-block;
}

.renovation-card--clickable {
  cursor: pointer;
}

.renovation-card--hover {
  opacity: 0.85;
}

.renovation-img {
  position: relative;
  width: 256rpx;
  height: 256rpx;
  margin-bottom: 16rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: var(--fog);
}

.renovation-cover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.renovation-placeholder {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, #e8e4df 0%, #d4cfc8 100%);
}

.renovation-img .badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 9999rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--rust);
  z-index: 2;
}

.renovation-img .photo-count {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 12rpx;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 9999rpx;
  font-size: 22rpx;
  color: #fff;
  text-align: center;
  line-height: 36rpx;
  z-index: 2;
}

.renovation-name {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.renovation-meta {
  font-size: 24rpx;
  color: var(--graphite);
}

.feature-text {
  font-size: 28rpx;
  color: var(--ash);
  line-height: 1.6;
}

/* 员工专属区块（分享提示 + 我的客户 + 分享给客户，Steep 配色）：白卡内 fog 底区块，卡片语言对齐 info-item */
.share-tip {
  margin-bottom: 48rpx;
  padding: 32rpx 40rpx;
  background: var(--fog);
  border-radius: 32rpx;
}

.share-tip-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.share-tip-sub {
  font-size: 26rpx;
  color: var(--graphite);
  line-height: 1.6;
}

/* dove 1px 分隔线 */
.staff-divider {
  height: 2rpx;
  background: var(--dove);
  margin: 24rpx 0 20rpx;
}

.clue-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 8rpx 0 4rpx;
}

.clue-ic {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: var(--apricot-wash);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.clue-ic-line {
  width: 30rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--rust);
}

.clue-ic-line--short {
  width: 20rpx;
}

.clue-tt {
  flex: 1;
  min-width: 0;
}

.clue-tt-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.clue-tt-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--graphite);
}

.clue-chev {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  border-right: 4rpx solid var(--dove);
  border-top: 4rpx solid var(--dove);
  transform: rotate(45deg);
}

.staff-btn-row {
  display: flex;
  gap: 20rpx;
  padding-top: 20rpx;
}

/* Steep 主按钮：ink 底白字 9999rpx 药丸 */
.staff-btn {
  flex: 1;
  height: 88rpx;
  border: none;
  border-radius: 9999rpx;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  padding: 0;
  margin: 0;
}

.staff-btn::after {
  border: none;
}

.staff-btn--pri {
  background: var(--ink);
  color: var(--pure-white);
}

.detail-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 90;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx 40rpx 48rpx;
  background: var(--pure-white);
  border-top: 2rpx solid rgba(163, 166, 175, 0.3);
}

/* 已预约提示行（footer 顶部居中） */
.booked-tip {
  font-size: 24rpx;
  color: var(--rust);
  text-align: center;
}

.footer-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

/* 顾问卡片：头像（缺省首字符占位）+ 名字 + 角色标签 */
.advisor {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.advisor-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.advisor-avatar--fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--fog);
  color: var(--graphite);
  font-size: 32rpx;
  font-weight: 500;
}

.advisor-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
}

.advisor-name {
  max-width: 100%;
  font-size: 28rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.advisor-role {
  margin-top: 6rpx;
  padding: 2rpx 16rpx;
  border-radius: 9999rpx;
  background: var(--apricot-wash);
  color: var(--rust);
  font-size: 20rpx;
}

/* 想看房按钮（btn-primary 全局底色，此处定宽不挤压卡片） */
.btn-book {
  flex-shrink: 0;
  min-width: 224rpx;
  margin: 0;
}

.btn-book--done {
  opacity: 0.7;
}

/* 手机号授权弹层（样式对齐 components/phone-bind-modal） */
.phone-mask {
  position: fixed;
  inset: 0;
  z-index: 1001;
  background: rgba(23, 25, 28, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.phone-modal {
  width: 600rpx;
  box-sizing: border-box;
  padding: 48rpx 40rpx;
  background: var(--pure-white);
  border-radius: 32rpx;
}

.phone-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink);
  text-align: center;
}

.phone-desc {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--graphite);
  line-height: 1.5;
  text-align: center;
}

.phone-actions {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.phone-btn {
  margin: 0;
  border: none;
  border-radius: 9999rpx;
  background: var(--ink);
  color: var(--pure-white);
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1;
  padding: 0 48rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.phone-btn::after {
  border: none;
}

.phone-cancel {
  margin: 0;
  border: none;
  background: transparent;
  color: var(--graphite);
  border-radius: 9999rpx;
  font-size: 28rpx;
  line-height: 1;
  padding: 0 48rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.phone-cancel::after {
  border: none;
}

/* 阶段照片轮播弹层 */
.stage-viewer {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
}

.stage-viewer-inner {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.stage-viewer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 40rpx 24rpx;
}

.stage-viewer-title {
  font-size: 28rpx;
  color: #fff;
}

.stage-viewer-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 40rpx;
  color: #fff;
}

.stage-viewer-swiper {
  flex: 1;
  width: 100%;
}

.stage-viewer-img {
  width: 100%;
  height: 100%;
  display: block;
}
