.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
  background: var(--fog);
}

/* 非法进入态 */
.state-box {
  padding: 320rpx 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.state-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.state-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--graphite);
}

/* 房源摘要卡 */
.house-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 26rpx 32rpx;
  background: var(--pure-white);
  border-radius: 32rpx;
}

.house-lt {
  flex: 1;
  min-width: 0;
}

.house-t {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.house-s {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--graphite);
}

.house-pr {
  flex-shrink: 0;
  text-align: right;
}

/* 价格行：新价 + 划线原价（已砍价时） */
.house-pv {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 12rpx;
}

.house-was {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--dove);
  text-decoration: line-through;
  flex-shrink: 0;
}

/* 标签行 + 砍价按钮 */
.house-pk {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 6rpx;
}

.house-k {
  font-size: 20rpx;
  color: var(--dove);
}

/* 砍价入口（apricot 胶囊，对齐设计稿 bargain-btn） */
.bargain-btn {
  flex-shrink: 0;
  height: 48rpx;
  padding: 0 22rpx;
  display: inline-flex;
  align-items: center;
  border-radius: 9999rpx;
  background: var(--apricot-wash);
  color: var(--rust);
  font-size: 22rpx;
  font-weight: 600;
}

/* 砍价弹层（对齐设计稿 bargain-modal） */
.bargain-modal {
  width: 620rpx;
  box-sizing: border-box;
  padding: 48rpx 40rpx;
  background: var(--pure-white);
  border-radius: 32rpx;
}

.bm-t {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  text-align: center;
}

.bm-d {
  margin-top: 20rpx;
  font-size: 25rpx;
  color: var(--graphite);
  line-height: 1.6;
  text-align: center;
}

.bm-input {
  margin-top: 34rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 100rpx;
  padding: 0 32rpx;
  border: 3rpx solid var(--dove);
  border-radius: 28rpx;
}

.bm-yen {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--rust);
}

.bm-field {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink);
}

.bm-unit {
  font-size: 25rpx;
  color: var(--graphite);
}

.bm-actions {
  margin-top: 40rpx;
  display: flex;
  gap: 20rpx;
}

.bm-reset {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9999rpx;
  background: var(--fog);
  color: var(--graphite);
  font-size: 28rpx;
  font-weight: 500;
}

.bm-ok {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9999rpx;
  background: var(--ink);
  color: var(--pure-white);
  font-size: 28rpx;
  font-weight: 500;
}

/* 自定义首付有效区间提示（spec K12） */
.bm-hint {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--dove);
  text-align: center;
}

.house-v {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
}

.house-u {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--graphite);
  margin-left: 6rpx;
}

.house-k {
  font-size: 20rpx;
  color: var(--dove);
}

/* 结果卡（ink 深色，对齐 Steep 主按钮词汇） */
.result-card {
  margin-top: 24rpx;
  padding: 40rpx 40rpx 36rpx;
  background: var(--ink);
  color: var(--pure-white);
  border-radius: 44rpx;
}

.result-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.result-mode {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
}

/* 执行利率徽标（apricot 低透明底） */
.rate-chip {
  display: inline-flex;
  padding: 8rpx 20rpx;
  border-radius: 9999rpx;
  background: rgba(251, 225, 209, 0.14);
  color: var(--apricot-wash);
  font-size: 22rpx;
  font-weight: 500;
}

.result-big {
  margin-top: 12rpx;
  font-size: 80rpx;
  font-weight: 600;
  letter-spacing: -0.02em;
  line-height: 1.1;
}

.result-u {
  font-size: 28rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.55);
  margin-left: 10rpx;
}

/* 等额本金附注行 */
.prin-note {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.prin-b {
  color: var(--pure-white);
  font-weight: 600;
}

.result-stats {
  display: flex;
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.14);
}

.r-stat {
  flex: 1;
  min-width: 0;
}

/* 支付利息可点击 */
.r-stat--click {
  cursor: pointer;
}

.r-k {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 6rpx;
}

.r-v {
  font-size: 31rpx;
  font-weight: 600;
  white-space: nowrap;
}

.r-u {
  font-size: 20rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.5);
  margin-left: 4rpx;
}

.r-hint {
  margin-top: 6rpx;
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.45);
}

/* 贷款方式 tabs（胶囊分段） */
.tabs {
  display: flex;
  gap: 4rpx;
  margin-top: 28rpx;
  padding: 6rpx;
  background: #ececef;
  border-radius: 9999rpx;
}

.tab {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9999rpx;
  font-size: 27rpx;
  font-weight: 500;
  color: var(--ash);
}

.tab--on {
  background: var(--ink);
  color: var(--pure-white);
}

/* 参数白卡 */
.card {
  margin-top: 24rpx;
  padding: 32rpx 36rpx;
  background: var(--pure-white);
  border-radius: 40rpx;
}

.card-hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  flex-wrap: wrap;
}

.card-t {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.card-v {
  font-size: 26rpx;
  color: var(--graphite);
}

.card-b {
  color: var(--ink);
  font-weight: 600;
  font-size: 30rpx;
}

.card-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--dove);
  line-height: 1.6;
}

/* 首付滑杆与刻度 */
.down-slider {
  margin: 28rpx 8rpx 0;
  transform: translateY(-4rpx);
}

.scale-row {
  display: flex;
  justify-content: space-between;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--dove);
}

/* 首付快捷档 */
/* 首付快捷档 + 自定义：flex 等宽强制单行（wrap 会导致真机字体渲染下「自定义」被挤到第二行） */
.chips-row {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
}

.chip-btn {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  padding: 0 16rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 9999rpx;
  background: var(--fog);
  color: var(--ash);
  font-size: 24rpx;
  font-weight: 500;
  white-space: nowrap;
}

.chip-btn--on {
  background: var(--ink);
  color: var(--pure-white);
}

/* 年限 / 还款方式 分段控件 */
.seg {
  display: flex;
  gap: 4rpx;
  margin-top: 28rpx;
  padding: 6rpx;
  background: var(--fog);
  border-radius: 9999rpx;
}

.seg-btn {
  flex: 1;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9999rpx;
  font-size: 25rpx;
  font-weight: 500;
  color: var(--ash);
}

.seg-btn--on {
  background: var(--pure-white);
  color: var(--ink);
  box-shadow: 0 2rpx 10rpx rgba(23, 25, 28, 0.14);
}

/* stepper 行 */
.step-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 0;
}

.step-row + .step-row {
  border-top: 2rpx solid #f0f0f2;
}

.step-k {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--ink);
}

.step-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  font-weight: 400;
  color: var(--dove);
}

.stepper {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
}

.step-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--fog);
  color: var(--ink);
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.step-v {
  min-width: 148rpx;
  text-align: center;
  font-size: 31rpx;
  font-weight: 600;
  color: var(--ink);
}

.step-u {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--graphite);
  margin-left: 2rpx;
}

/* 利率徽标（apricot / mint） */
.pill {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 22rpx;
  border-radius: 9999rpx;
  font-size: 25rpx;
  font-weight: 500;
  white-space: nowrap;
}

.pill--apricot {
  background: var(--apricot-wash);
  color: var(--rust);
}

.pill--mint {
  background: var(--mint);
  color: #0e6e56;
}

.pill--lg {
  font-size: 30rpx;
  padding: 16rpx 28rpx;
}

/* 恢复默认 */
.reset-btn {
  margin-top: 32rpx;
  height: 92rpx;
  line-height: 92rpx;
  border: none;
  border-radius: 9999rpx;
  background: transparent;
  color: var(--graphite);
  font-size: 28rpx;
  font-weight: 500;
  padding: 0;
}

.reset-btn::after {
  border: none;
}

/* 底部行动按钮：咨询（fog 幽灵钮）+ 购房流程（ink 主钮）— spec K11 */
.cta-row {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.cta-btn {
  flex: 1;
  height: 92rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 9999rpx;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  line-height: 1;
}

.cta-btn::after {
  border: none;
}

.cta-btn--ghost {
  background: var(--pure-white);
  color: var(--ink);
}

.cta-btn--pri {
  background: var(--ink);
  color: var(--pure-white);
}

.cta-ic {
  font-size: 26rpx;
}

/* 还款计划明细弹窗 */
.sched-mask {
  position: fixed;
  inset: 0;
  z-index: 1001;
  background: rgba(23, 25, 28, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sched-modal {
  width: 690rpx;
  max-height: 80vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--pure-white);
  border-radius: 48rpx;
}

.sched-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 36rpx 0;
}

.sched-t {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.sched-x {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--fog);
  color: var(--graphite);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sched-sub {
  padding: 12rpx 36rpx 20rpx;
  font-size: 23rpx;
  color: var(--graphite);
  line-height: 1.6;
}

/* 表头 */
.sched-thead {
  display: flex;
  padding: 18rpx 28rpx;
  background: var(--fog);
  font-size: 20rpx;
  font-weight: 600;
  color: var(--graphite);
}

.sched-thead text,
.sched-row text {
  text-align: right;
}

.sch-no {
  width: 72rpx;
  text-align: left !important;
}

.sch-num {
  flex: 1;
}

.sched-body {
  max-height: 640rpx;
  padding-bottom: 24rpx;
}

.sched-row {
  display: flex;
  align-items: baseline;
  padding: 13rpx 28rpx;
  border-bottom: 2rpx solid #f4f4f6;
  font-size: 21rpx;
  color: var(--ink);
}

.sch-gray {
  color: var(--graphite);
}
