<view class="page">
  <!-- 未登录 / 令牌失效（/keys 需 C 端令牌） -->
  <view class="state" wx:if="{{state === 'needLogin'}}">
    <view class="state__title">登录已失效</view>
    <view class="state__text">请使用微信登录后查看钥匙管理</view>
    <view class="state__btn" bindtap="onGoLogin">返回重新登录</view>
  </view>

  <!-- 无权限（403：无后台身份） -->
  <view class="state" wx:elif="{{state === 'forbidden'}}">
    <view class="state__title">无权限</view>
    <view class="state__text">暂无钥匙管理权限，请联系管理员</view>
    <view class="state__btn" bindtap="onGoLogin">返回</view>
  </view>

  <!-- 加载失败 -->
  <view class="state" wx:elif="{{state === 'error'}}">
    <view class="state__title">加载失败</view>
    <view class="state__text">网络异常，请重试</view>
    <view class="state__btn" bindtap="onRetry">重试</view>
  </view>

  <!-- 加载中 -->
  <view class="state" wx:elif="{{state === 'loading'}}">
    <view class="state__text">加载中...</view>
  </view>

  <!-- 空态 -->
  <view class="state" wx:elif="{{state === 'empty'}}">
    <view class="state__title">暂无可操作的房源</view>
    <view class="state__text">管理员可操作全部房源；项目负责人、对接负责人、渠道经理、讲房人、谈判人仅可操作其关联房源，无关人员不可见。</view>
  </view>

  <!-- 房源列表 -->
  <block wx:elif="{{state === 'items'}}">
    <!-- 指标 Hero 区（设计稿 docs/2026-10-10：三指标 + 周期新增 +N · +0 同橙；summary 失败整卡隐藏） -->
    <view class="kpi-hero" wx:if="{{summary}}">
      <view class="kpi-mask" wx:if="{{summaryPopOpen}}" catchtap="onToggleSummaryPop"></view>
      <view class="kpi-info {{summaryPopOpen ? 'kpi-info--open' : ''}}" catchtap="onToggleSummaryPop">i</view>
      <view class="kpi-pop {{summaryPopOpen ? 'kpi-pop--show' : ''}}" wx:if="{{summaryPopOpen}}">
        <view class="kpi-pop__title">指标与统计周期说明</view>
        <view class="kpi-pop__desc">
          <text class="kpi-pop__em">房源</text>＝有钥匙的房源数 · <text class="kpi-pop__em">分享</text>＝钥匙分享数 ·
          <text class="kpi-pop__em">查看</text>＝密码被查看次数。增量 +N 为本周期内新增量，每周二 00:00 重置。
        </view>
        <view class="kpi-pop__range">{{summary.periodText}}</view>
      </view>
      <view class="kpi-row">
        <view class="kpi-cell">
          <view class="kpi-label-line">
            <text class="kpi-label">房源</text>
            <text class="kpi-delta">{{summary.deltaText}}</text>
          </view>
          <view class="kpi-num">{{summary.propertiesWithKeys}}</view>
        </view>
        <view class="kpi-cell">
          <view class="kpi-label-line">
            <text class="kpi-label">分享</text>
            <text class="kpi-delta">{{summary.sharesDeltaText}}</text>
          </view>
          <view class="kpi-num">{{summary.sharesTotal}}</view>
        </view>
        <view class="kpi-cell">
          <view class="kpi-label-line">
            <text class="kpi-label">查看</text>
            <text class="kpi-delta">{{summary.viewsDeltaText}}</text>
          </view>
          <view class="kpi-num">{{summary.viewsTotal}}</view>
        </view>
      </view>
      <view class="kpi-foot">
        <text class="kpi-foot__note">相关人仅见关联房源</text>
        <text class="kpi-foot__link" catchtap="onShareRecords">分享记录</text>
      </view>
    </view>
    <view class="list-head">
      <view class="list-count">共 {{total}} 套</view>
    </view>
    <view class="search-box">
      <view class="search-icon">⌕</view>
      <input
        class="search-input"
        type="text"
        value="{{searchKey}}"
        placeholder="搜索小区 / 详细地址"
        placeholder-class="search-ph"
        confirm-type="search"
        bindinput="onSearch"
      />
      <text class="search-clear" wx:if="{{searchKey}}" bindtap="onClearSearch">✕</text>
    </view>
    <view
      class="prop-card"
      wx:for="{{items}}"
      wx:key="projectId"
      bindtap="onItemTap"
      data-project-id="{{item.projectId}}"
      data-address="{{item.address}}"
    >
      <view class="prop-top">
        <view class="prop-addr">{{item.address}}</view>
        <view
          class="prop-share-hit"
          catchtap="onShareTap"
          data-project-id="{{item.projectId}}"
          data-address="{{item.address}}"
          data-has-normal="{{item.hasNormal}}"
        >
          <view class="prop-share-btn">分享</view>
        </view>
      </view>
      <view class="prop-meta" wx:if="{{item.metaText}}">{{item.metaText}}</view>
      <view class="prop-stats">
        <view class="chip {{item.managerOk ? 'chip--active' : 'chip--warn'}}">
          <view wx:if="{{item.managerOk}}" class="cdot"></view>{{item.managerText}}
        </view>
        <view class="chip chip--gray">{{item.normalText}}</view>
        <view class="chip chip--cool" wx:if="{{item.shareCount > 0}}">{{item.shareText}}</view>
      </view>
    </view>
    <view wx:if="{{items.length === 0}}" class="state">
      <view class="state__text">未找到匹配的房源</view>
    </view>
    <view class="mnote">权限说明：管理员可操作全部房源；项目负责人、对接负责人、渠道经理、讲房人、谈判人仅可操作其关联房源，无关人员不可见。所有查看与修改行为将记录日志。</view>
  </block>

  <!-- 底部留白 -->
  <view style="height: 60rpx;"></view>
</view>
