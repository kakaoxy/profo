/* 钥匙管理 · 房源列表（C2）· warm 风格，chip/mnote 等类为本页定义 */
.page {
  min-height: 100vh;
  background: var(--fog);
  padding-bottom: 40rpx;
}

/* ===== 页头 ===== */
.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 44rpx 20rpx;
}
.list-count {
  font-size: 24rpx;
  color: var(--graphite);
}

/* ===== 指标 Hero 区（设计稿 docs/2026-10-10 · 三指标 + 周期新增 +N） ===== */
.kpi-hero {
  position: relative;
  margin: 24rpx 40rpx 0;
  background: var(--pure-white);
  border: 2rpx solid #ece7de;
  border-radius: 40rpx;
  padding: 30rpx 34rpx 28rpx;
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
}
/* 透明蒙层：弹层打开时铺满全屏，点击浮层外任意区域收起（catchtap 阻断穿透） */
.kpi-mask {
  position: fixed;
  inset: 0;
  z-index: 2;
}
/* 右上角 ⓘ：点击弹出周期说明，不占常驻版面（40rpx 热区 + 20rpx 视觉圆） */
.kpi-info {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--fog);
  color: var(--graphite);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 40rpx;
  text-align: center;
  z-index: 3;
}
.kpi-info--open {
  background: var(--ink);
  color: var(--pure-white);
}
.kpi-pop {
  position: absolute;
  top: 72rpx;
  right: 16rpx;
  z-index: 4;
  width: 440rpx;
  background: var(--pure-white);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 48rpx -8rpx rgba(23, 25, 28, 0.18), 0 0 0 2rpx rgba(23, 25, 28, 0.05);
  padding: 24rpx 28rpx 22rpx;
}
/* 弹层小箭头（旋转 45° 方块） */
.kpi-pop::before {
  content: "";
  position: absolute;
  top: -10rpx;
  right: 32rpx;
  width: 20rpx;
  height: 20rpx;
  background: var(--pure-white);
  transform: rotate(45deg);
  border-radius: 4rpx;
}
.kpi-pop__title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
}
.kpi-pop__desc {
  font-size: 22rpx;
  color: var(--ash);
  line-height: 1.65;
  margin-top: 10rpx;
}
.kpi-pop__em {
  color: var(--rust);
  font-weight: 600;
}
.kpi-pop__range {
  margin-top: 16rpx;
  padding: 12rpx 18rpx;
  border-radius: 18rpx;
  background: var(--fog);
  font-size: 20rpx;
  color: var(--graphite);
  letter-spacing: 0.02em;
}
.kpi-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 8rpx;
}
.kpi-cell {
  min-width: 0;
}
.kpi-label-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}
.kpi-label {
  font-size: 22rpx;
  color: var(--graphite);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* 增量徽标：+0 与 +N 同 Rust 橙（对齐参考稿「咨询 +0」） */
.kpi-delta {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--rust);
}
.kpi-num {
  margin-top: 6rpx;
  font-size: 52rpx;
  font-weight: 500;
  color: var(--ink);
  line-height: 1.15;
  letter-spacing: -0.02em;
}
.kpi-foot {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #f2f0ec;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.kpi-foot__note {
  font-size: 20rpx;
  color: var(--dove);
}
.kpi-foot__link {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--rust);
}

/* ===== 快速搜索 ===== */
.search-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 40rpx 24rpx;
  padding: 0 28rpx;
  height: 84rpx;
  background: var(--pure-white);
  border: 2rpx solid #ece7de;
  border-radius: 9999rpx;
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
}
.search-icon {
  font-size: 32rpx;
  color: var(--dove);
}
.search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--ink);
}
.search-ph {
  color: var(--dove);
}
.search-clear {
  font-size: 26rpx;
  color: var(--dove);
  padding: 8rpx;
}

/* ===== chip（对齐设计稿 C2 三态徽章）===== */
.chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
  padding: 8rpx 18rpx;
  border-radius: 9999rpx;
  white-space: nowrap;
}
.chip--active {
  background: var(--apricot-wash);
  color: var(--rust);
}
.chip--cool {
  background: var(--sky-wash);
  color: #2c4d7f;
}
.chip--gray {
  background: #eef0f3;
  color: #6b6e76;
}
.chip--warn {
  background: var(--apricot-wash);
  color: var(--rust);
}
.cdot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.75;
}

/* ===== 房源卡 ===== */
.prop-card {
  margin: 0 40rpx 24rpx;
  background: var(--pure-white);
  border: 2rpx solid #ece7de;
  border-radius: 40rpx;
  padding: 28rpx 28rpx 24rpx;
  box-shadow: var(--shadow-sm);
}
.prop-top {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.prop-addr {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  line-height: 1.45;
}
/* 分享按钮触控热区：视觉胶囊外扩点击范围（向上/下/左含卡片间距），负 margin 抵消占位避免挤压地址 */
.prop-share-hit {
  flex-shrink: 0;
  padding: 10rpx 8rpx 10rpx 14rpx;
  margin: -10rpx -8rpx -10rpx -14rpx;
}
/* 卡片右上「分享」胶囊按钮（对齐 chip--active：apricot-wash 底 + rust 字） */
.prop-share-btn {
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1;
  padding: 16rpx 30rpx;
  border-radius: 9999rpx;
  background: var(--apricot-wash);
  color: var(--rust);
}
.prop-meta {
  font-size: 24rpx;
  color: var(--graphite);
  margin-top: 8rpx;
}
.prop-stats {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}

/* ===== 权限说明（对齐设计稿 C2 mnote：fog 底圆角块）===== */
.mnote {
  margin: 8rpx 40rpx 0;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6b6e76;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border: 2rpx solid #ece7de;
  border-radius: 24rpx;
}

/* ===== 状态分支 ===== */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 120rpx 40rpx;
}
.state__title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--ink);
}
.state__text {
  font-size: 26rpx;
  color: var(--graphite);
  text-align: center;
}
.state__btn {
  margin-top: 20rpx;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: var(--ink);
  color: var(--pure-white);
  font-size: 28rpx;
  font-weight: 500;
}
