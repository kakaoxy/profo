<view class="page">
  <!-- 未登录 -->
  <view class="state" wx:if="{{state === 'needLogin'}}">
    <view class="state__title">登录已失效</view>
    <view class="state__text">请使用微信登录后查看分享记录</view>
    <view class="state__btn" bindtap="onGoLogin">返回重新登录</view>
  </view>
  <!-- 加载失败 -->
  <view class="state" wx:elif="{{state === 'error'}}">
    <view class="state__title">加载失败</view>
    <view class="state__text">网络异常，请重试</view>
    <view class="state__btn" bindtap="onRetry">重试</view>
  </view>
  <!-- 加载中 -->
  <view class="state" wx:elif="{{state === 'loading'}}">
    <view class="state__text">加载中...</view>
  </view>
  <!-- 空态 -->
  <view class="state" wx:elif="{{state === 'empty'}}">
    <view class="state__title">暂无分享记录</view>
    <view class="state__text">在房源钥匙详情页点「分享给经纪人」生成分享后，可在此跟踪查看进度</view>
  </view>

  <block wx:elif="{{state === 'items'}}">
    <!-- 状态过滤 chips -->
    <view class="filter-bar">
      <view
        class="mode-chip {{activeFilter === item.key ? 'mode-chip--on' : ''}}"
        wx:for="{{filters}}"
        wx:key="key"
        bindtap="onFilterTap"
        data-key="{{item.key}}"
      >{{item.label}} {{item.count}}</view>
    </view>

    <!-- 记录卡 -->
    <view
      class="mcard record-card"
      wx:for="{{items}}"
      wx:key="id"
      bindtap="onItemTap"
      data-id="{{item.id}}"
    >
      <view class="record-head">
        <view class="record-main">
          <view class="record-line1">
            <text class="record-title">{{item.itemsText}}</text>
            <view class="chip {{item.statusClass}}">
              <view wx:if="{{item.status === 'active'}}" class="cdot"></view>{{item.statusLabel}}
            </view>
          </view>
          <view class="record-meta">{{item.createdText}} 分享 · {{item.expireText}}</view>
          <view class="record-meta" wx:if="{{item.viewersText}}">查看人：{{item.viewersText}}</view>
        </view>
      </view>
      <view class="record-foot">
        <view class="chip {{item.status === 'active' ? 'chip--cool' : 'chip--gray'}}">{{item.viewedText}}</view>
        <text class="mlink">详情 ›</text>
      </view>
      <!-- 已过期提示条：过期后经纪人不可查看（延长有效期可恢复） -->
      <view class="expire-bar" wx:if="{{item.status === 'expired'}}">已过有效期（经纪人不可查看，延长有效期可恢复）</view>
    </view>

    <view wx:if="{{items.length === 0}}" class="list-empty">暂无该状态的分享记录</view>
  </block>

  <!-- 底部留白 -->
  <view style="height: 60rpx;"></view>
</view>
