/* 分享记录列表（C10）· warm 风格 */
.page {
  min-height: 100vh;
  background: var(--fog);
  padding-bottom: 40rpx;
}

/* ===== 状态过滤 chips ===== */
.filter-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx 40rpx 20rpx;
  flex-wrap: wrap;
}
.mode-chip {
  padding: 14rpx 28rpx;
  border-radius: 9999rpx;
  font-size: 24rpx;
  font-weight: 500;
  background: #eef0f3;
  color: #6b6e76;
}
.mode-chip--on {
  background: var(--ink);
  color: var(--pure-white);
}

/* ===== 记录卡 ===== */
.mcard {
  margin: 0 40rpx 24rpx;
  background: var(--pure-white);
  border: 2rpx solid #ece7de;
  border-radius: 40rpx;
  box-shadow: var(--shadow-sm);
}
.record-card {
  padding: 28rpx;
}
.record-head {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.record-main {
  flex: 1;
  min-width: 0;
}
.record-line1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.record-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
}
.record-meta {
  font-size: 23rpx;
  color: var(--graphite);
  margin-top: 6rpx;
}
.record-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}
.mlink {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--rust);
}

/* 已过期提示条 */
.expire-bar {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: var(--fog);
  color: var(--graphite);
  font-size: 22rpx;
}

/* ===== chip ===== */
.chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
  padding: 8rpx 18rpx;
  border-radius: 9999rpx;
  white-space: nowrap;
}
.chip--active {
  background: var(--apricot-wash);
  color: var(--rust);
}
.chip--gray {
  background: #eef0f3;
  color: #6b6e76;
}
.chip--mute {
  background: var(--fog);
  color: var(--dove);
}
.chip--cool {
  background: var(--sky-wash);
  color: #2c4d7f;
}
.cdot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.75;
}

/* 过滤后空提示 */
.list-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--graphite);
}

/* ===== 状态分支 ===== */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 120rpx 40rpx;
}
.state__title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--ink);
}
.state__text {
  font-size: 26rpx;
  color: var(--graphite);
  text-align: center;
}
.state__btn {
  margin-top: 20rpx;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: var(--ink);
  color: var(--pure-white);
  font-size: 28rpx;
  font-weight: 500;
}
