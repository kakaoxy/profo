.page {
  min-height: 100vh;
  background-color: var(--fog);
}

.placeholder {
  padding: 240rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.placeholder-title {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.placeholder-sub {
  font-size: 28rpx;
  color: var(--graphite);
}
