<view class="container">
  <view class="brand">
    <view class="brand-title">Profo</view>
    <view class="brand-subtitle">专业房产服务平台</view>
  </view>

  <view wx:if="{{loading}}" class="status">加载中...</view>
  <view wx:elif="{{error}}" class="status status-error">{{error}}</view>

  <view wx:else class="stats">
    <view class="stat-card">
      <view class="stat-value">{{totalOwners}}</view>
      <view class="stat-label">业主总数</view>
    </view>
    <view class="stat-card">
      <view class="stat-value">{{onSaleCount}}</view>
      <view class="stat-label">在售房源</view>
    </view>
    <view class="stat-card">
      <view class="stat-value">{{totalSold}}</view>
      <view class="stat-label">累计成交</view>
    </view>
  </view>

  <view class="footer">
    <button class="primary-btn" bindtap="onNavigateToProjects">查看房源</button>
  </view>
</view>
