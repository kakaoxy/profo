.container {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background-color: #f5f5f5;
}

.brand {
  padding: 48rpx 16rpx 32rpx;
}

.brand-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.brand-subtitle {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #666666;
}

.status {
  margin-top: 96rpx;
  text-align: center;
  font-size: 30rpx;
  color: #999999;
}

.status-error {
  color: #d4380d;
}

.stats {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 32rpx;
}

.stat-card {
  flex: 1;
  margin: 0 8rpx;
  padding: 32rpx 16rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.stat-card:first-child {
  margin-left: 0;
}

.stat-card:last-child {
  margin-right: 0;
}

.stat-value {
  font-size: 52rpx;
  font-weight: 700;
  color: #1677ff;
  line-height: 1.2;
}

.stat-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666666;
}

.footer {
  margin-top: 96rpx;
  padding: 0 16rpx;
}

.primary-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  color: #ffffff;
  background-color: #1677ff;
  border-radius: 44rpx;
}

.primary-btn::after {
  border: none;
}
