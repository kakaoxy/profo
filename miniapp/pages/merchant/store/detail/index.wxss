.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 80rpx;
  box-sizing: border-box;
}

.hero {
  background: var(--ink);
  color: #fff;
  border-radius: 40rpx;
  padding: 40rpx;
  margin-bottom: 28rpx;
}
.hero__top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}
.hero__name {
  font-size: 40rpx;
  font-weight: 600;
}
.hero__company {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.72);
}
.hero__address {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.86);
}
.hero__meta {
  margin-top: 18rpx;
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

.action-grid {
  display: flex;
  background: var(--pure-white);
  border-radius: 32rpx;
  box-shadow: var(--shadow-sm);
  padding: 24rpx 8rpx;
  margin-bottom: 28rpx;
}
.action {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: var(--graphite);
}
.action__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--fog);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--ink);
}

.section {
  background: var(--pure-white);
  border-radius: 40rpx;
  box-shadow: var(--shadow-sm);
  padding: 32rpx;
  margin-bottom: 28rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
}
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.link {
  color: var(--rust);
  font-size: 26rpx;
}
.empty-line {
  margin-top: 20rpx;
  color: var(--graphite);
  font-size: 26rpx;
}

.photo-scroll {
  margin-top: 20rpx;
  white-space: nowrap;
}
.photo-item {
  display: inline-block;
  width: 200rpx;
  height: 150rpx;
  margin-right: 16rpx;
  border-radius: 20rpx;
  overflow: hidden;
}
.photo-img {
  width: 100%;
  height: 100%;
}

.timeline-item {
  position: relative;
  padding: 24rpx 0 24rpx 32rpx;
  border-bottom: 1rpx solid var(--fog);
}
.timeline-item:last-child {
  border-bottom: none;
}
.timeline-dot {
  position: absolute;
  left: 0;
  top: 36rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--rust);
}
.timeline-top {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
}
.timeline-time {
  font-weight: 500;
}
.timeline-employee {
  color: var(--graphite);
  font-size: 24rpx;
}
.timeline-row {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: var(--graphite);
  line-height: 1.5;
}
.timeline-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.status-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--fog);
}
.status-row:last-child {
  border-bottom: none;
}
.status-change {
  font-size: 28rpx;
  font-weight: 500;
}
.status-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--graphite);
}

.state {
  padding: 120rpx 48rpx;
  text-align: center;
}
.state__title {
  font-size: 34rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}
.state__text {
  font-size: 26rpx;
  color: var(--graphite);
  line-height: 1.6;
}
.state__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
  height: 80rpx;
  padding: 0 48rpx;
  border-radius: 9999rpx;
  background: var(--ink);
  color: #fff;
  font-size: 28rpx;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(23, 25, 28, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  z-index: 20;
}
.modal {
  width: 100%;
  background: #fff;
  border-radius: 40rpx;
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 600;
}
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip--tap {
  border: 2rpx solid transparent;
}
.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--fog);
  border-radius: 24rpx;
  font-size: 28rpx;
  background: var(--fog);
  box-sizing: border-box;
}
.modal-actions {
  display: flex;
  gap: 16rpx;
}
.mini-btn {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: 9999rpx;
  background: var(--fog);
  color: var(--ink);
  font-size: 28rpx;
}
.mini-btn--primary {
  background: var(--ink);
  color: #fff;
}
