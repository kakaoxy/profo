@import "../../../../styles/merchant-theme.wxss";

/* 门店详情页布局。基础件全部来自 shared 层；本文件只写三件事：
 * 次要动作行、拜访时间线（本页视觉重心）、协议行与状态变更行。 */

/* ---- 档案：地址块 + 键值行 ---- */
.addr {
  font-size: var(--mp-body);
  font-weight: 500;
  line-height: 1.5;
  letter-spacing: -0.14px;
  color: var(--ink);
}
.addr--detail {
  margin-top: 4rpx;
  font-size: var(--mp-label);
  font-weight: 400;
  line-height: 1.5;
  letter-spacing: -0.13px;
  color: var(--ash);
}
.row--first {
  margin-top: var(--mp-gap);
}

/* ---- 次要动作：三项平分，图标 + 文案，不套圆形底（审查报告 I6） ---- */
.ops {
  display: flex;
  margin-bottom: var(--mp-gap);
}
.ops__item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 88rpx;
  font-size: var(--mp-label);
  color: var(--ink);
  transition: opacity var(--mp-ease);
}

/* ---- 拜访时间线：一条连续竖轨 + 节点，最近一次用 Rust 点标「现在」 ---- */
.tl {
  position: relative;
}
.tl__item {
  position: relative;
  padding-left: 48rpx;
  padding-bottom: 32rpx;
}
.tl__item:last-child {
  padding-bottom: 0;
}
/* 竖向轨迹：每节从节点下方连到下一节，最后一节不画 */
.tl__item::before {
  content: "";
  position: absolute;
  top: 24rpx;
  bottom: 0;
  left: 11rpx;
  width: 2rpx;
  background: var(--mp-hairline);
}
.tl__item:last-child::before {
  display: none;
}
.tl__dot {
  position: absolute;
  top: 8rpx;
  left: 4rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 9999rpx;
  background: var(--pure-white);
  box-shadow: 0 0 0 2rpx var(--mp-hairline);
}
/* Rust 只做「印」：最近一次拜访是这条线上唯一的红点 */
.tl__dot--now {
  background: var(--rust);
  box-shadow: none;
}
.tl__top {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.tl__date {
  font-size: var(--mp-label);
  font-weight: 500;
  line-height: 1.45;
  color: var(--ink);
}
.tl__clock {
  font-size: var(--mp-caption);
  line-height: 1.4;
  color: var(--graphite);
}
.tl__who {
  margin-left: auto;
  font-size: var(--mp-caption);
  line-height: 1.4;
  color: var(--graphite);
}
.tl__line {
  margin-top: 8rpx;
  font-size: var(--mp-label);
  line-height: 1.5;
  color: var(--ash);
}
.tl__remark {
  margin-top: 4rpx;
  font-size: var(--mp-label);
  line-height: 1.5;
  color: var(--graphite);
}
.tl__tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}
.tl__dist {
  font-size: var(--mp-caption);
  line-height: 1.4;
  color: var(--graphite);
}

/* ---- 协议行：标题 + 到期 + 状态 chip + chevron ---- */
.agreement {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--mp-hairline);
  transition: opacity var(--mp-ease);
}
.agreement:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.agreement__main {
  flex: 1;
  min-width: 0;
}
.agreement__title {
  font-size: var(--mp-label);
  font-weight: 500;
  line-height: 1.45;
  color: var(--ink);
}
.agreement__meta {
  margin-top: 4rpx;
  font-size: var(--mp-caption);
  line-height: 1.4;
  color: var(--graphite);
}
.agreement__chevron {
  width: 28rpx;
  height: 28rpx;
}

/* ---- 门店照片横向滚动 ---- */
.photo-scroll {
  margin-top: var(--mp-gap);
  white-space: nowrap;
}
.photo-thumb {
  display: inline-block;
  width: 200rpx;
  height: 200rpx;
  margin-right: 16rpx;
  border-radius: var(--mp-radius-inner);
  background: var(--fog);
}
.photo-thumb:last-child {
  margin-right: 0;
}

/* ---- 合作状态变更行 ---- */
.log {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--mp-hairline);
}
.log:first-child {
  padding-top: 0;
}
.log:last-child {
  padding-bottom: 0;
  border-bottom: none;
}
.log__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.log__from,
.log__to {
  font-size: var(--mp-label);
  line-height: 1.45;
  color: var(--ink);
}
.log__arrow {
  width: 28rpx;
  height: 28rpx;
}
.log__meta {
  margin-top: 4rpx;
  font-size: var(--mp-caption);
  line-height: 1.4;
  color: var(--graphite);
}

/* ---- 邀请二维码 ---- */
.qr-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
}
.qr-image {
  width: 400rpx;
}
