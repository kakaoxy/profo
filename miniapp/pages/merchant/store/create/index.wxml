<view class="page page--foot">
  <view class="head">
    <view class="head__title">{{mode === 'edit' ? '编辑门店' : '新增门店'}}</view>
    <view class="head__sub">
      {{mode === 'edit' ? '地址与坐标变动需要填写变更方式，提交后留痕' : '提交后门店立即进入你的门店列表，并自动生成首条拜访记录'}}
    </view>
  </view>

  <view class="state" wx:if="{{state === 'needLogin'}}">
    <view class="state__title">请先登录</view>
    <view class="state__text">查看与编辑门店档案需要登录商户账号</view>
    <view class="state__btn" hover-class="hoverable" bindtap="onGoLogin">去登录</view>
  </view>

  <view class="state" wx:elif="{{state === 'loading'}}">
    <view class="state__text">加载中…</view>
  </view>

  <view class="state" wx:elif="{{state === 'error'}}">
    <view class="state__title">没能加载门店信息</view>
    <view class="state__text">{{errorText}}</view>
    <view class="state__btn" hover-class="hoverable" bindtap="onRetry">重试</view>
  </view>

  <block wx:else>
    <!-- 所属公司 -->
    <view class="card">
      <view class="card__title">所属公司</view>
      <view class="card__body">
        <view class="rowhead" wx:if="{{selectedCompany}}">
          <view>
            <view class="company-name">{{selectedCompany.company_name}}</view>
            <view class="chip {{selectedCompany.status === 'disabled' ? 'chip--void' : 'chip--done'}} company-chip">
              {{selectedCompany.status === 'disabled' ? '已停用' : '正常'}}
            </view>
          </view>
          <view class="link" hover-class="hoverable" bindtap="onClearCompany">更换</view>
        </view>

        <block wx:else>
          <view class="search-row">
            <input
              class="input input--flex"
              placeholder="输入公司名称搜索"
              placeholder-class="ph"
              value="{{companyKeyword}}"
              bindinput="onCompanyKeyword"
              bindconfirm="onSearchCompany"
            />
            <button class="mbtn" hover-class="hoverable" bindtap="onSearchCompany">搜索</button>
          </view>

          <view class="company-list" wx:if="{{companies.length}}">
            <view
              class="option"
              wx:for="{{companies}}"
              wx:key="id"
              data-index="{{index}}"
              hover-class="hoverable"
              bindtap="onSelectCompany"
            >
              <view class="option__title">{{item.company_name}}</view>
              <view class="chip {{item.status === 'disabled' ? 'chip--void' : 'chip--done'}}">
                {{item.status === 'disabled' ? '已停用' : '正常'}}
              </view>
            </view>
          </view>
          <view class="empty" wx:elif="{{companySearched}}">没有匹配的公司，可以新建一个</view>

          <view class="link-row" wx:if="{{companySearched}}">
            <view class="link" hover-class="hoverable" bindtap="onToggleCompanyCreate">
              <image class="icon" src="{{icons.plus}}" />
              <text>{{showCompanyCreate ? '收起' : '新增公司'}}</text>
            </view>
          </view>

          <view class="company-create" wx:if="{{showCompanyCreate}}">
            <view class="field">
              <text class="field__label">公司名称 *</text>
              <input class="input" placeholder="与营业执照一致即可" placeholder-class="ph" value="{{newCompanyName}}" bindinput="onNewCompanyName" />
            </view>
            <view class="field-row">
              <view class="field">
                <text class="field__label">联系人</text>
                <input class="input" placeholder="选填" placeholder-class="ph" value="{{newCompanyContact}}" bindinput="onNewCompanyContact" />
              </view>
              <view class="field">
                <text class="field__label">联系电话</text>
                <input class="input" type="number" placeholder="选填" placeholder-class="ph" value="{{newCompanyPhone}}" bindinput="onNewCompanyPhone" />
              </view>
            </view>
            <button class="mbtn mbtn--block" hover-class="hoverable" bindtap="onCreateCompany">创建并选择</button>
          </view>
        </block>
      </view>
    </view>

    <!-- 门店信息 -->
    <view class="card">
      <view class="card__title">门店信息</view>
      <view class="card__body">
        <view class="field">
          <text class="field__label">门店名称 *</text>
          <input class="input" placeholder="如：链家·世纪大道店" placeholder-class="ph" value="{{form.store_name}}" bindinput="onInput" data-field="store_name" />
        </view>

        <view class="field">
          <text class="field__label">门店位置 *</text>
          <button class="mbtn mbtn--block" hover-class="hoverable" bindtap="onChooseLocation">
            <image class="icon" src="{{icons.pin}}" />
            <text>{{form.lng ? '重新选点' : '选择门店位置'}}</text>
          </button>
          <view class="hint tnum" wx:if="{{form.lng}}">经度 {{form.lng}} · 纬度 {{form.lat}}（GCJ-02）</view>
          <view class="hint hint--warn" wx:else>未选坐标无法提交；选点后会自动带出区域与商圈</view>
        </view>

        <view class="field-row">
          <view class="field">
            <text class="field__label">区域 *</text>
            <picker mode="selector" range="{{districts}}" value="{{districtIndex}}" bindchange="onSelectDistrict" disabled="{{!districts.length}}">
              <view class="pick {{form.district ? '' : 'pick--empty'}}">
                <text>{{form.district || (districts.length ? '请选择区域' : '区域列表加载失败')}}</text>
                <image class="pick__icon" src="{{icons.chevronDown}}" />
              </view>
            </picker>
          </view>
          <view class="field">
            <text class="field__label">商圈 *</text>
            <picker wx:if="{{businessCircles.length}}" mode="selector" range="{{businessCircles}}" value="{{businessCircleIndex}}" bindchange="onSelectBusinessCircle">
              <view class="pick {{form.business_circle ? '' : 'pick--empty'}}">
                <text>{{form.business_circle || '请选择商圈'}}</text>
                <image class="pick__icon" src="{{icons.chevronDown}}" />
              </view>
            </picker>
            <input
              wx:else
              class="input"
              placeholder="{{form.district ? '该区域暂无候选，手动填写' : '请先选择区域'}}"
              placeholder-class="ph"
              value="{{form.business_circle}}"
              bindinput="onInput"
              data-field="business_circle"
            />
          </view>
        </view>

        <view class="field">
          <text class="field__label">详细地址 *</text>
          <input class="input" placeholder="街道、门牌号" placeholder-class="ph" value="{{form.address}}" bindinput="onInput" data-field="address" />
        </view>

        <view class="field-row">
          <view class="field">
            <text class="field__label">联系人 *</text>
            <input class="input" value="{{form.contact_name}}" bindinput="onInput" data-field="contact_name" />
          </view>
          <view class="field">
            <text class="field__label">联系电话 *</text>
            <input class="input tnum" type="number" value="{{form.contact_phone}}" bindinput="onInput" data-field="contact_phone" />
          </view>
        </view>
        <view class="hint">该联系人会成为门店经纪人，本人扫码认证时自动关联到本档案。</view>

        <view class="field field--last">
          <text class="field__label">合作状态</text>
          <view class="chip-row">
            <view
              wx:for="{{cooperationOptions}}"
              wx:key="code"
              class="chip chip--tap {{form.cooperation_status === item.code ? 'chip--on' : ''}}"
              data-code="{{item.code}}"
              hover-class="hoverable"
              bindtap="onSelectCooperation"
            >{{item.label}}</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 门店照片 -->
    <view class="card">
      <view class="rowhead">
        <view class="card__title">门店照片</view>
        <view class="hint tnum">{{form.photos.length}}/20</view>
      </view>
      <view class="photo-grid">
        <view class="photo-item" wx:for="{{form.photos}}" wx:key="file_url">
          <image class="photo-img" src="{{item.displayUrl}}" mode="aspectFill" />
          <view class="photo-type">{{item.photo_type === 'head' ? '门头' : item.photo_type === 'interior' ? '店内' : '其他'}}</view>
          <view class="photo-remove" data-index="{{index}}" hover-class="hoverable" bindtap="onRemovePhoto">
            <view class="photo-remove__dot">
              <image class="icon photo-remove__icon" src="{{icons.close}}" />
            </view>
          </view>
        </view>
        <view class="photo-add" data-type="head" hover-class="hoverable" bindtap="onAddPhoto">
          <image class="icon" src="{{icons.camera}}" />
          <text class="photo-add__label">门头照</text>
        </view>
        <view class="photo-add" data-type="interior" hover-class="hoverable" bindtap="onAddPhoto">
          <image class="icon" src="{{icons.camera}}" />
          <text class="photo-add__label">店内照</text>
        </view>
      </view>
    </view>

    <!-- 编辑模式：变更类型 -->
    <view class="card" wx:if="{{mode === 'edit'}}">
      <view class="card__title">地址变更方式</view>
      <view class="card__body">
        <view class="chip-row">
          <view class="chip chip--tap {{changeType === 'edit' ? 'chip--on' : ''}}" data-type="edit" hover-class="hoverable" bindtap="onSelectChangeType">仅编辑</view>
          <view class="chip chip--tap {{changeType === 'correct' ? 'chip--on' : ''}}" data-type="correct" hover-class="hoverable" bindtap="onSelectChangeType">地址纠错</view>
          <view class="chip chip--tap {{changeType === 'relocate' ? 'chip--on' : ''}}" data-type="relocate" hover-class="hoverable" bindtap="onSelectChangeType">门店搬迁</view>
        </view>
        <view class="field field--last" wx:if="{{changeType !== 'edit'}}">
          <text class="field__label">变更原因 *</text>
          <input class="input" placeholder="一句话说明为什么改地址" placeholder-class="ph" value="{{changeReason}}" bindinput="onChangeReason" />
        </view>
      </view>
    </view>

    <!-- 备注 -->
    <view class="card">
      <view class="field field--last">
        <text class="field__label">备注</text>
        <textarea class="input input--area" placeholder="门店补充说明，例如营业时间、进门方式" placeholder-class="ph" value="{{form.remark}}" bindinput="onInput" data-field="remark" />
      </view>
    </view>
  </block>

  <!-- 查重提示 -->
  <view class="modal-mask" wx:if="{{duplicateOpen}}">
    <view class="modal">
      <view class="modal-title">发现疑似重复门店</view>
      <view class="modal-sub">如果是同一家店，直接打开已有档案；确实不是，请填写强制新建的理由</view>
      <scroll-view scroll-y class="modal-list">
        <view class="option" wx:for="{{duplicates}}" wx:key="id" data-id="{{item.id}}" hover-class="hoverable" bindtap="onOpenDuplicate">
          <view class="dup-info">
            <view class="option__title">{{item.store_name}}</view>
            <view class="option__sub">{{item.address}}</view>
            <view class="option__sub tnum">匹配：{{item.matchedText}}{{item.distanceText ? ' · ' + item.distanceText : ''}}</view>
          </view>
        </view>
      </scroll-view>
      <input class="input" placeholder="强制新建理由" placeholder-class="ph" value="{{forceReason}}" bindinput="onForceReason" />
      <view class="modal-actions">
        <view class="mbtn" hover-class="hoverable" bindtap="onCloseDuplicate">返回修改</view>
        <view class="mbtn mbtn--ink" hover-class="hoverable" bindtap="onForceCreate">确认新建</view>
      </view>
    </view>
  </view>
</view>

<view class="foot" wx:if="{{state === 'ok'}}">
  <button class="mbtn mbtn--ink mbtn--cta" hover-class="hoverable" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">
    {{mode === 'edit' ? '保存修改' : '提交建档'}}
  </button>
</view>
