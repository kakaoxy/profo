@import "../../../../styles/merchant-theme.wxss";

/* 门店建档 / 编辑页独有布局。基础件全部来自 shared 层，本文件只放：
 * 公司结果行、新增公司块、照片网格、查重行。 */

/* 已选公司：左名称 + 右侧「更换」 */
.company-name {
  font-size: var(--mp-body);
  font-weight: 500;
  line-height: 1.5;
  letter-spacing: -0.14px;
  color: var(--ink);
}
.company-chip {
  margin-top: 8rpx;
}
.company-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: var(--mp-gap);
}
/* 「新增公司」入口独占一行，热区由 .link 保证 88rpx */
.link-row {
  display: flex;
  margin-top: 16rpx;
}
.company-create {
  margin-top: var(--mp-gap);
  padding-top: var(--mp-gap);
  border-top: 1rpx solid var(--mp-hairline);
}

/* ---- 照片网格：三列等宽，间距 16rpx ---- */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: var(--mp-gap);
}
.photo-item,
.photo-add {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  height: 180rpx;
  border-radius: var(--mp-radius-inner);
  overflow: visible;
  box-sizing: border-box;
}
.photo-img {
  width: 100%;
  height: 100%;
  border-radius: var(--mp-radius-inner);
  background: var(--fog);
}
/* 角标：可读下限 24rpx（审查报告 D13） */
.photo-type {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.92);
  font-size: var(--mp-caption);
  font-weight: 400;
  line-height: 1.4;
  color: var(--ink);
}
/* 删除热区 88rpx（M6），视觉是一个 44rpx 白点 */
.photo-remove {
  position: absolute;
  top: -32rpx;
  right: -32rpx;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  width: 88rpx;
  height: 88rpx;
}
.photo-remove__dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 9999rpx;
  background: var(--pure-white);
  box-shadow: 0 0 0 1rpx var(--mp-hairline);
}
.photo-remove__icon {
  width: 24rpx;
  height: 24rpx;
}
.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 2rpx dashed var(--mp-hairline);
  background: var(--pure-white);
}
.photo-add__label {
  font-size: var(--mp-caption);
  font-weight: 400;
  line-height: 1.4;
  color: var(--graphite);
}

/* ---- 查重弹层行 ---- */
.dup-info {
  flex: 1;
  min-width: 0;
}
