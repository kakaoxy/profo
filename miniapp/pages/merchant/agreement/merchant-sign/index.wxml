<view class="page">
  <view class="state" wx:if="{{state === 'loading'}}">
    <view class="state__text">加载中...</view>
  </view>

  <view class="state" wx:elif="{{state === 'needLogin'}}">
    <view class="state__title">请先登录</view>
    <view class="state__text">{{errorText || '商户需使用微信登录后才能核对并签署协议'}}</view>
    <button class="btn-primary login-btn" bindtap="onGoLogin">微信登录</button>
  </view>

  <view class="state" wx:elif="{{state === 'error'}}">
    <view class="state__title">无法打开</view>
    <view class="state__text">{{errorText}}</view>
    <view class="state__btn" bindtap="onRetry">重试</view>
  </view>

  <block wx:elif="{{state === 'ok' && view}}">
    <view class="hero" wx:if="{{!done}}">
      <view class="hero__title">合作协议待签署</view>
      <view class="hero__sub">请核对协议正文与商户信息，确认无误后手写签名提交</view>
    </view>

    <view class="card" wx:if="{{!done}}">
      <view class="row"><text class="row-label">协议编号</text><text>{{view.agreement_no || '—'}}</text></view>
      <view class="row"><text class="row-label">签约主体</text><text>{{view.subject_name || '—'}}</text></view>
      <view class="row"><text class="row-label">协议模板</text><text>{{view.template_name || '—'}}</text></view>
      <view class="row"><text class="row-label">签署人</text><text>{{view.signer_name || '—'}} · {{signerPhoneMasked}}</text></view>
      <view class="row"><text class="row-label">到期时间</text><text>{{view.expire_at || '长期有效'}}</text></view>
    </view>

    <view class="card" wx:if="{{!done}}">
      <view class="card-title">协议正文</view>
      <text class="content">{{content}}</text>
    </view>

    <block wx:if="{{!done && view.can_sign}}">
      <view class="card">
        <view class="card-title">签署人信息</view>
        <view class="field-label">姓名</view>
        <input class="input" placeholder="请填写签署人姓名" value="{{signerName}}" bindinput="onSignerNameInput" maxlength="50" />
        <view class="field-label">手机号</view>
        <input
          class="input"
          type="number"
          placeholder="请填写 11 位手机号"
          value="{{signerPhone}}"
          bindinput="onSignerPhoneInput"
          maxlength="11"
        />
      </view>

      <view class="card">
        <view class="section-head">
          <view class="card-title">手写签名</view>
          <view class="link" bindtap="onClear">清空</view>
        </view>
        <canvas
          type="2d"
          id="merchant-signature"
          class="signature-canvas"
          disable-scroll="true"
          bindtouchstart="onTouchStart"
          bindtouchmove="onTouchMove"
          bindtouchend="onTouchEnd"
        ></canvas>
        <view class="confirm-row" bindtap="onToggleConfirmed">
          <view class="checkbox {{confirmed ? 'checkbox--on' : ''}}">{{confirmed ? '✓' : ''}}</view>
          <text class="confirm-text">我已核对协议正文与商户信息，确认以格式条款签署</text>
        </view>
        <button
          class="btn-primary submit-btn"
          loading="{{submitting}}"
          disabled="{{submitting}}"
          bindtap="onSubmit"
        >
          确认签署
        </button>
      </view>
    </block>

    <view class="card" wx:if="{{!done && !view.can_sign}}">
      <view class="card-title">当前不可签署</view>
      <view class="hint">{{view.reason || '协议状态已变化，请联系门店员工确认'}}</view>
      <view class="hint">协议状态：{{view.status_label}}</view>
    </view>

    <view class="card" wx:if="{{done}}">
      <view class="card-title">签署完成</view>
      <view class="hint">协议已提交，门店员工侧会看到「已签署」。如需留档可复制协议文件地址。</view>
      <view class="mini-btn" wx:if="{{signedFileUrl}}" bindtap="onCopyFileUrl">复制协议文件地址</view>
      <button class="btn-primary submit-btn" bindtap="onBackHome">返回首页</button>
    </view>
  </block>
</view>
