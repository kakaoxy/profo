@import "../../../../styles/merchant-theme.wxss";

/* 商户签署协议页布局。基础件（页面骨架/标题/卡片/状态四态/按钮/输入/chip/底栏）
 * 全部来自共享层 styles/merchant-theme.wxss；本文件只写本页独有的排布、
 * 协议正文阅读块、手写签名画布与勾选确认行。 */

/* 登录按钮与状态说明之间留一档间距（共享层 `.state` 不假设内部有按钮） */
.state-cta {
  margin-top: var(--mp-gap-lg);
}

/* 卡内标题与下方内容的间距（共享层只对 `.rowhead + .card__body` 给出该间距） */
.card-note {
  margin-top: var(--mp-gap);
}

/* 协议正文属长文阅读，行高 1.7（DESIGN.md:470 唯一例外），其余说明文字统一 1.5 */
.content {
  display: block;
  margin-top: var(--mp-gap);
  font-size: var(--mp-label);
  font-weight: 400;
  line-height: 1.7;
  letter-spacing: -0.13px;
  color: var(--ash);
  white-space: pre-wrap;
}

/* 手写签名画布：虚线边框只作为「可书写区」的提示，不是装饰卡 */
.signature-canvas {
  width: 100%;
  height: 360rpx;
  margin-top: var(--mp-gap);
  background: var(--pure-white);
  border: 2rpx dashed var(--dove);
  border-radius: var(--mp-radius-inner);
  box-sizing: border-box;
}

/* 勾选确认行：整行（方框 + 文案）是一个热区，热区高度不低于 88rpx */
.confirm-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
  margin-top: var(--mp-gap);
  box-sizing: border-box;
}

/* 圆形勾选框：未选 = 白底 + hairline 描边；选中 = 白底 + Ink 描边 + 单色勾
 * （40rpx 外框减 2rpx 描边后内框恰为 36rpx，等于图标原尺寸，无需缩放） */
.checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  background: var(--pure-white);
  border: 2rpx solid var(--mp-hairline);
  border-radius: 9999rpx;
  box-sizing: border-box;
}
.checkbox--on {
  border-color: var(--ink);
}

/* 确认文案：随方框排布，所以单独给 flex 与文字档，不复用 `.hint`（`.hint` 无 flex） */
.confirm-text {
  flex: 1;
  min-width: 0;
  font-size: var(--mp-label);
  font-weight: 400;
  line-height: 1.5;
  letter-spacing: -0.13px;
  color: var(--graphite);
}
