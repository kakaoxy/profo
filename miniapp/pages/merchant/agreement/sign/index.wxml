<view class="page">
  <view class="state" wx:if="{{state === 'loading'}}">
    <view class="state__text">加载中...</view>
  </view>
  <view class="state" wx:elif="{{state === 'error'}}">
    <view class="state__title">无法签署</view>
    <view class="state__text">{{errorText}}</view>
    <view class="state__btn" bindtap="onRetry">重试</view>
  </view>

  <block wx:elif="{{state === 'ok' && agreement}}">
    <view class="hero">
      <view class="hero__title">{{agreement.agreement_no || '合作协议'}}</view>
      <view class="hero__sub">请阅读协议正文后在下方手写签名</view>
    </view>

    <view class="card">
      <view class="card-title">协议正文</view>
      <text class="content">{{content}}</text>
    </view>

    <view class="card">
      <view class="card-title">签署人信息</view>
      <view class="field-label">姓名</view>
      <input class="input" value="{{signerName}}" bindinput="onSignerNameInput" maxlength="50" />
      <view class="field-label">手机号</view>
      <input class="input" type="number" placeholder="请输入协议签署人手机号" value="{{signerPhone}}" bindinput="onSignerPhoneInput" maxlength="20" />
    </view>

    <view class="card">
      <view class="section-head">
        <view class="card-title">手写签名</view>
        <view class="link" bindtap="onClear">清空</view>
      </view>
      <canvas
        type="2d"
        id="signature"
        class="signature-canvas"
        disable-scroll="true"
        bindtouchstart="onTouchStart"
        bindtouchmove="onTouchMove"
        bindtouchend="onTouchEnd"
      ></canvas>
      <view class="hint">签名将合成到协议 PDF，请确认姓名与手机号与签约主体一致。</view>
      <button class="btn-primary submit-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">
        确认签署
      </button>
    </view>
  </block>
</view>
