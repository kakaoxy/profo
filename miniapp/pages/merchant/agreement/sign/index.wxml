<view class="page page--foot">
  <view class="state" wx:if="{{state === 'needLogin'}}">
    <view class="state__title">请先登录</view>
    <view class="state__text">协议签署需要微信登录后才能核对正文并手写签名</view>
    <view class="state__btn" hover-class="hoverable" bindtap="onGoLogin">去登录</view>
  </view>

  <view class="state" wx:elif="{{state === 'loading'}}">
    <view class="state__text">加载中…</view>
  </view>

  <view class="state" wx:elif="{{state === 'error'}}">
    <view class="state__title">无法签署</view>
    <view class="state__text">{{errorText}}</view>
    <view class="state__btn" hover-class="hoverable" bindtap="onRetry">重试</view>
  </view>

  <block wx:elif="{{state === 'ok' && agreement}}">
    <view class="head">
      <view class="head__title">{{agreement.agreement_no || '合作协议'}}</view>
      <view class="head__sub">核对正文后在下方手写签名，提交后不可修改</view>
    </view>

    <view class="card">
      <view class="card__title">合作协议正文</view>
      <view class="agreement-body">
        <text class="agreement-text">{{content}}</text>
      </view>
    </view>

    <view class="card">
      <view class="card__title">签署人信息</view>
      <view class="field">
        <label class="field__label" for="signer-name">姓名</label>
        <input
          id="signer-name"
          class="input"
          placeholder="请填写签署人姓名"
          placeholder-class="ph"
          value="{{signerName}}"
          bindinput="onSignerNameInput"
          maxlength="50"
        />
      </view>
      <view class="field">
        <label class="field__label" for="signer-phone">手机号</label>
        <input
          id="signer-phone"
          class="input"
          type="number"
          placeholder="请填写协议签署人手机号"
          placeholder-class="ph"
          value="{{signerPhone}}"
          bindinput="onSignerPhoneInput"
          maxlength="20"
        />
      </view>
    </view>

    <view class="card">
      <view class="rowhead">
        <view class="card__title">手写签名</view>
        <view class="link" wx:if="{{hasStroke}}" hover-class="hoverable" bindtap="onClear">清空</view>
      </view>
      <view class="card__body">
        <canvas
          type="2d"
          id="signature"
          class="signature-canvas"
          disable-scroll="true"
          bindtouchstart="onTouchStart"
          bindtouchmove="onTouchMove"
          bindtouchend="onTouchEnd"
        ></canvas>
        <view class="hint signature-hint">签名会打印在协议末页，请保持笔画清晰</view>
      </view>
    </view>
  </block>
</view>

<view class="foot" wx:if="{{state === 'ok' && agreement}}">
  <button
    class="mbtn mbtn--ink mbtn--cta"
    hover-class="hoverable"
    loading="{{submitting}}"
    disabled="{{submitting}}"
    bindtap="onSubmit"
  >
    确认签署
  </button>
</view>
