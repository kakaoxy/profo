@import "../../../../styles/merchant-theme.wxss";

/* 协议签署页布局。基础件（页面标题 / 卡片 / 状态四态 / 按钮 / 输入 / 底栏）
 * 全部来自 shared 层 styles/merchant-theme.wxss；本文件只写本页独有的正文块、
 * 签署人字段与签名画布排布，不重定义任何字号 / 字重 / 颜色 / 圆角 / 阴影。 */

/* ---- 协议正文卡 ---- */
.agreement-body {
  margin-top: var(--mp-gap);
}
/* 协议正文属长文阅读，行高 1.7（DESIGN.md:470 长文唯一例外，其余说明文字统一 1.5） */
.agreement-text {
  display: block;
  font-size: var(--mp-label);
  font-weight: 400;
  line-height: 1.7;
  letter-spacing: -0.13px;
  color: var(--ash);
  white-space: pre-wrap;
}

/* ---- 签署人信息卡：卡内最后一个字段贴齐卡片内边距 ---- */
.field:last-child {
  margin-bottom: 0;
}

/* ---- 签名卡：白底 + dashed hairline 边框，圆角走内层圆角 ---- */
.signature-canvas {
  width: 100%;
  height: 360rpx;
  background: var(--pure-white);
  border: 2rpx dashed var(--mp-hairline);
  border-radius: var(--mp-radius-inner);
  box-sizing: border-box;
}
.signature-hint {
  margin-top: 16rpx;
}
