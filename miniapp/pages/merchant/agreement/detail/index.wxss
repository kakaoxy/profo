@import "../../../../styles/merchant-theme.wxss";

/* 协议详情页布局。
 * 基础件（页面标题 / 卡片 / 键值行 / 状态 chip / 文本动作 / 四态 / 弹层 / 底栏）
 * 全部来自 shared 层 styles/merchant-theme.wxss，本文件只留本页独有的两处：
 * 操作行的垂直对齐，以及 <button open-type="share"> 的原生样式复位。 */

/* 操作行：共享 .row 用 align-items: flex-start 是为了长值换行，
 * 本页每行右侧是 88rpx 热区的文本动作，需要与 label 垂直居中。 */
.act {
  align-items: center;
}

/* <button open-type="share"> 是微信唯一可用的分享触发方式，只能用 button。
 * 这里只做原生样式复位（背景/外边距/行高/边框），字号、字重、颜色、热区
 * 仍由共享层 .link 决定；内边距由同一行的共享 .row 决定，故不复位 padding。 */
.share-btn {
  background: transparent;
  margin: 0;
  line-height: inherit;
  border: none;
}
.share-btn::after {
  border: none;
}
