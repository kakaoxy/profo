.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 80rpx;
  box-sizing: border-box;
}
.hero {
  background: var(--ink);
  color: #fff;
  border-radius: 40rpx;
  padding: 40rpx;
  margin-bottom: 28rpx;
}
.hero__title {
  font-size: 40rpx;
  font-weight: 600;
}
.hero__sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.72);
}
.card {
  background: var(--pure-white);
  border-radius: 40rpx;
  box-shadow: var(--shadow-sm);
  padding: 32rpx;
}
.field-label {
  margin: 24rpx 0 12rpx;
  font-size: 26rpx;
  color: var(--graphite);
}
.input,
.select-row {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--fog);
  border-radius: 24rpx;
  font-size: 28rpx;
  background: var(--fog);
  box-sizing: border-box;
}
.select-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.placeholder {
  color: var(--dove);
}
.chevron {
  font-size: 30rpx;
  color: var(--graphite);
}
.hint {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--graphite);
}
/* REQ-IT4-06：`.btn-primary` 是 inline-flex，无 width 时按钮按内容收缩并贴在容器左侧；
   表单主操作按钮统一铺满父容器，让文字在整行内居中。 */
.submit-btn {
  display: flex;
  width: 100%;
  margin-top: 36rpx;
}
.state {
  padding: 100rpx 48rpx;
  text-align: center;
}
.state__title {
  font-size: 34rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}
.state__text {
  font-size: 26rpx;
  color: var(--graphite);
  line-height: 1.6;
}
.state__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
  height: 80rpx;
  padding: 0 48rpx;
  border-radius: 9999rpx;
  background: var(--ink);
  color: #fff;
  font-size: 28rpx;
}
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(23, 25, 28, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  z-index: 20;
}
.modal {
  width: 100%;
  max-height: 86vh;
  background: #fff;
  border-radius: 40rpx;
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 600;
}
.store-list {
  max-height: 60vh;
}
.option {
  padding: 20rpx;
  border: 2rpx solid var(--fog);
  border-radius: 24rpx;
  margin-bottom: 16rpx;
}
.option--active {
  border-color: var(--rust);
  background: var(--apricot-wash);
}
.option-title {
  font-size: 28rpx;
  font-weight: 500;
}
.option-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--graphite);
  line-height: 1.4;
}
.mini-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: 9999rpx;
  background: var(--fog);
  color: var(--ink);
  font-size: 27rpx;
  padding: 0 48rpx;
}

/* REQ-IT5-05：门店无经纪人时在发起页补录，入口与表单弹层 */
.add-broker-btn {
  display: flex;
  width: 100%;
  margin-top: 16rpx;
}
.mini-btn--primary {
  background: var(--ink);
  color: var(--pure-white);
}
.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 28rpx;
}
