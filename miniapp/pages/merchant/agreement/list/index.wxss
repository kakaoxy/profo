@import "../../../../styles/merchant-theme.wxss";

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 160rpx;
  box-sizing: border-box;
}

.hero {
  background: var(--pure-white);
  color: var(--ink);
  box-shadow: var(--merchant-shadow);
  border-radius: var(--merchant-card-radius);
  padding: 40rpx;
  margin-bottom: 24rpx;
}
.hero__title {
  font-size: 40rpx;
  font-weight: 600;
}
.hero__sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--graphite);
}

.tabs {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  white-space: nowrap;
  margin-bottom: 24rpx;
}
.tab {
  padding: 12rpx 28rpx;
  border-radius: 9999rpx;
  background: var(--pure-white);
  color: var(--graphite);
  font-size: 26rpx;
  box-shadow: none;
  border: 1rpx solid var(--merchant-hairline);
}
.tab--active {
  background: var(--ink);
  color: var(--pure-white);
}

.list-head {
  font-size: 24rpx;
  color: var(--graphite);
  margin-bottom: 16rpx;
}
.agreement-card {
  background: var(--pure-white);
  border-radius: var(--merchant-card-radius);
  box-shadow: var(--merchant-shadow);
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.agreement-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}
.agreement-title {
  font-size: 30rpx;
  font-weight: 600;
}
.agreement-line {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: var(--graphite);
}
.agreement-meta {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--graphite);
}
.chevron {
  font-size: 30rpx;
}

.state {
  padding: 100rpx 48rpx;
  text-align: center;
}
.state__title {
  font-size: 34rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}
.state__text {
  font-size: 26rpx;
  color: var(--graphite);
  line-height: 1.6;
}
.state__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 9999rpx;
  background: transparent;
  color: var(--rust);
  font-size: 28rpx;
  font-weight: 500;
}

.footer {
  display: flex;
  justify-content: center;
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(247, 247, 248, 0.94);
}
.footer__btn {
  flex: 1;
  width: 100%;
}
