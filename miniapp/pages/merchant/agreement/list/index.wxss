@import "../../../../styles/merchant-theme.wxss";

/* 本页只剩三件版面：横向 tab 条、协议行的三段结构、卡片内标题与 chip 的对齐。
   其余（画布/标题/四态/卡片/图标/底栏）全部来自 merchant-theme.wxss。 */

/* L6：scroll-x 容器 + enable-flex，tab 不换行也不被压缩 */
.tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: var(--mp-gap);
}
.tabs .tab { flex: 0 0 auto; }

.agreement__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.agreement__title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-size: var(--mp-body);
  font-weight: 500;
  line-height: 1.5;
  letter-spacing: -0.14px;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.agreement__sub {
  margin-top: 8rpx;
  font-size: var(--mp-label);
  color: var(--graphite);
}
.agreement__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
}
.agreement__meta {
  flex: 1;
  min-width: 0;
  font-size: var(--mp-caption);
  color: var(--graphite);
}
