@import "../../../../styles/merchant-theme.wxss";

/* 拜访登记页独有布局。基础件（卡片/字段/按钮/chip/pick/照片网格）全部来自 shared 层。 */

/* 定位状态行下面的一组动作：主按钮 + 文本降级入口 */
.loc-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: var(--mp-gap);
}
/* 补录日期/时间并排等分 */
.backfill-pick {
  flex: 1;
  min-width: 0;
}
