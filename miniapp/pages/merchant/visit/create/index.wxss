.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 200rpx;
  box-sizing: border-box;
}

.store-head {
  background: var(--ink);
  color: #fff;
  border-radius: 40rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
}
.store-name {
  font-size: 36rpx;
  font-weight: 600;
}
.store-address {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.86);
  line-height: 1.5;
}
.store-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.section {
  background: var(--pure-white);
  border-radius: 40rpx;
  box-shadow: var(--shadow-sm);
  padding: 32rpx;
  margin-bottom: 28rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.form-group {
  margin-bottom: 24rpx;
}
.form-group--flex {
  flex: 1;
  min-width: 0;
}
.form-row {
  display: flex;
  gap: 20rpx;
}
.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--fog);
  border-radius: 24rpx;
  font-size: 28rpx;
  background: var(--fog);
  color: var(--ink);
  box-sizing: border-box;
}
.textarea {
  height: 150rpx;
  padding: 20rpx 24rpx;
}
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip--tap {
  border: 2rpx solid transparent;
}

.location-box {
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--fog);
  color: var(--graphite);
  font-size: 26rpx;
}
.location-box--ok {
  background: var(--mint);
  color: #1f6b52;
}
.row-actions {
  display: flex;
  gap: 16rpx;
  margin: 20rpx 0;
}
.mini-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 9999rpx;
  background: var(--ink);
  color: #fff;
  font-size: 26rpx;
}
.mini-btn--ghost {
  background: var(--fog);
  color: var(--ink);
}

.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
}
.picker-value {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.photo-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: var(--fog);
}
.photo-img {
  width: 100%;
  height: 100%;
}
.photo-remove {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(23, 25, 28, 0.7);
  color: #fff;
  text-align: center;
  line-height: 40rpx;
}
.photo-add {
  width: 180rpx;
  height: 180rpx;
  border-radius: 24rpx;
  border: 2rpx dashed var(--dove);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: var(--graphite);
  font-size: 24rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(247, 247, 248, 0), var(--fog) 30%);
}
.footer__btn {
  width: 100%;
}
