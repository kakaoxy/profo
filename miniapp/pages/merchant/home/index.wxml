<view class="page page--foot">
  <view class="head">
    <view class="head__title">商户拓展</view>
  </view>

  <view class="search-row home-search" wx:if="{{state === 'items' || state === 'empty'}}">
    <input
      class="input input--flex"
      placeholder="搜索门店名称 / 地址"
      placeholder-class="ph"
      value="{{keyword}}"
      confirm-type="search"
      bindinput="onKeywordInput"
      bindconfirm="onSearch"
    />
    <button class="mbtn" hover-class="hoverable" bindtap="onSearch">搜索</button>
  </view>

  <view class="state" wx:if="{{state === 'needLogin'}}">
    <view class="state__title">请先登录</view>
    <view class="state__text">商户拓展仅对已绑定后台账号的员工开放</view>
    <view class="state__btn" hover-class="hoverable" bindtap="onGoLogin">去登录</view>
  </view>

  <view class="state" wx:elif="{{state === 'loading'}}">
    <view class="state__text">加载中…</view>
  </view>

  <view class="state" wx:elif="{{state === 'error'}}">
    <view class="state__title">没能加载门店</view>
    <view class="state__text">{{errorText}}</view>
    <view class="state__btn" hover-class="hoverable" bindtap="onRetry">重试</view>
  </view>

  <view class="state" wx:elif="{{state === 'empty'}}">
    <view class="state__title">还没有门店</view>
    <view class="state__text">{{keyword ? '没有匹配「' + keyword + '」的门店，换个关键词试试' : '现场拜访新门店后可直接建档，首访记录会自动生成'}}</view>
  </view>

  <block wx:elif="{{state === 'items'}}">
    <view class="listhead">
      <text class="listhead__count tnum">共 {{total}} 家门店</text>
      <view class="link" hover-class="hoverable" bindtap="onRefresh">刷新</view>
    </view>

    <view
      class="card card--tap store"
      wx:for="{{stores}}"
      wx:key="id"
      data-id="{{item.id}}"
      hover-class="hoverable"
      bindtap="onStoreTap"
    >
      <view class="store__top">
        <view class="store__name">{{item.store_name}}</view>
        <view class="chip {{item.statusTone === 'todo' ? 'chip--todo' : item.statusTone === 'void' ? 'chip--void' : 'chip--done'}}">
          {{item.statusLabel}}
        </view>
        <image class="icon store__chevron" src="{{icons.chevronRight}}" />
      </view>
      <view class="store__sub">{{item.company_name}}</view>
      <view class="store__region" wx:if="{{item.district || item.business_circle}}">
        {{item.district}}{{item.district && item.business_circle ? ' · ' : ''}}{{item.business_circle}}
      </view>
      <view class="store__foot">
        <text class="store__meta tnum">最近拜访 {{item.lastVisitText}}</text>
        <text class="store__distance tnum" wx:if="{{item.distanceText}}">· {{item.distanceText}}</text>
        <!-- catchtap：避免冒泡到卡片 tap 又跳一次详情页 -->
        <view class="link store__visit" hover-class="hoverable" catchtap="onVisitTap" data-id="{{item.id}}">
          <image class="icon" src="{{icons.plus}}" />
          <text>拜访登记</text>
        </view>
      </view>
    </view>
  </block>
</view>

<view class="foot" wx:if="{{state === 'items' || state === 'empty'}}">
  <button class="mbtn mbtn--ink mbtn--cta" hover-class="hoverable" bindtap="onCreate">新增门店</button>
</view>
