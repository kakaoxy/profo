@import "../../../styles/merchant-theme.wxss";

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 180rpx;
  box-sizing: border-box;
}

.hero {
  padding: 16rpx 8rpx 32rpx;
}
.hero__title {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--ink);
}
.hero__sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--graphite);
}

.search-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
  margin-bottom: 32rpx;
}
.search-input {
  flex: 1;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 9999rpx;
  background: var(--pure-white);
  border: 2rpx solid transparent;
  font-size: 28rpx;
  box-sizing: border-box;
}
/* DESIGN §Do's：一屏只留一个 Ink 填充 CTA（页脚「新增门店」），搜索降级为文字链接 */
.search-btn {
  flex-shrink: 0;
  height: 88rpx;
  padding: 0 12rpx;
  border-radius: 9999rpx;
  background: transparent;
  color: var(--rust);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 88rpx;
}
.search-btn::after {
  border: none;
}

.list-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 8rpx 8rpx 20rpx;
  font-size: 26rpx;
  color: var(--graphite);
}
.list-refresh {
  color: var(--rust);
}

.store-card {
  background: var(--pure-white);
  border-radius: var(--merchant-card-radius);
  box-shadow: var(--merchant-shadow);
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.store-card__top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}
.store-card__name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
}
.store-card__company {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--graphite);
}
.store-card__region {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--ash);
  line-height: 1.5;
}
/* REQ-IT6-01：正文左、动作右，拜访按钮与卡片 tap 并存 */
.store-card__body {
  display: flex;
  gap: 24rpx;
}
.store-card__info {
  flex: 1;
  min-width: 0;
}
.store-card__aside {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}
.store-card__meta {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--merchant-hairline);
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 24rpx;
  color: var(--graphite);
}
.store-card__arrow {
  color: var(--dove);
}
.store-card__distance {
  color: var(--ink);
  font-weight: 500;
}
/* REQ-IT6-01：访客入口用次要按钮样式（Fog 底 + 墨字），避免与页脚主 CTA 抢焦点 */
.visit-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  height: 60rpx;
  padding: 0 22rpx;
  border-radius: 9999rpx;
  background: var(--fog);
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
}

.footer {
  display: flex;
  justify-content: center;
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(247, 247, 248, 0), var(--fog) 30%);
}
.footer__btn {
  flex: 1;
  width: 100%;
}

.state {
  padding: 120rpx 48rpx;
  text-align: center;
}
.state__title {
  font-size: 34rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}
.state__text {
  font-size: 26rpx;
  color: var(--graphite);
  line-height: 1.6;
}
.state__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 9999rpx;
  background: transparent;
  color: var(--rust);
  font-size: 28rpx;
  font-weight: 500;
}
