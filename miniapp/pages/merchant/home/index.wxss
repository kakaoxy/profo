@import "../../../styles/merchant-theme.wxss";

/* 商户首页布局。基础件（标题/卡片/状态/按钮/chip/底栏）全部来自 shared 层
 * styles/merchant-theme.wxss；本文件只写本页独有的门店卡排布。 */

/* 搜索行与下方列表之间留一档间距（shared 层只给 flex 排布，不假设上下文） */
.home-search {
  margin-bottom: var(--mp-gap);
}

/* ---- 门店卡 ---- */
.store__top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.store__name {
  flex: 1;
  min-width: 0;
  font-size: var(--mp-body);
  font-weight: 500;
  line-height: 1.5;
  letter-spacing: -0.14px;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.store__chevron {
  flex-shrink: 0;
}
.store__sub {
  margin-top: 8rpx;
  font-size: var(--mp-label);
  font-weight: 400;
  line-height: 1.5;
  letter-spacing: -0.13px;
  color: var(--graphite);
}
.store__region {
  margin-top: 4rpx;
  font-size: var(--mp-label);
  font-weight: 400;
  line-height: 1.5;
  letter-spacing: -0.13px;
  color: var(--graphite);
}

/* 卡底一行：最近拜访 + 距离 + 本卡主操作（拜访登记） */
.store__foot {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: var(--mp-gap);
}
.store__meta,
.store__distance {
  font-size: var(--mp-caption);
  font-weight: 400;
  line-height: 1.4;
  letter-spacing: -0.1px;
  color: var(--graphite);
}
.store__visit {
  gap: 8rpx;
  margin-left: auto;
}
