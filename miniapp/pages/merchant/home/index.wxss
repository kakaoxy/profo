.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 180rpx;
  box-sizing: border-box;
}

.hero {
  padding: 16rpx 8rpx 32rpx;
}
.hero__title {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--ink);
}
.hero__sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--graphite);
}

.search-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
  margin-bottom: 32rpx;
}
.search-input {
  flex: 1;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 9999rpx;
  background: var(--pure-white);
  border: 2rpx solid transparent;
  font-size: 28rpx;
  box-sizing: border-box;
}
.search-btn {
  height: 88rpx;
  padding: 0 32rpx;
  border-radius: 9999rpx;
  background: var(--ink);
  color: #fff;
  font-size: 28rpx;
  line-height: 88rpx;
}
.search-btn::after {
  border: none;
}

.list-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 8rpx 8rpx 20rpx;
  font-size: 26rpx;
  color: var(--graphite);
}
.list-refresh {
  color: var(--rust);
}

.store-card {
  background: var(--pure-white);
  border-radius: 40rpx;
  box-shadow: var(--shadow-sm);
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.store-card__top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}
.store-card__name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
}
.store-card__company {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--graphite);
}
.store-card__address {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--ash);
  line-height: 1.5;
}
.store-card__meta {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--fog);
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--graphite);
}
.store-card__arrow {
  color: var(--dove);
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(247, 247, 248, 0), var(--fog) 30%);
}
.footer__btn {
  width: 100%;
}

.state {
  padding: 120rpx 48rpx;
  text-align: center;
}
.state__title {
  font-size: 34rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}
.state__text {
  font-size: 26rpx;
  color: var(--graphite);
  line-height: 1.6;
}
.state__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
  height: 80rpx;
  padding: 0 48rpx;
  border-radius: 9999rpx;
  background: var(--ink);
  color: #fff;
  font-size: 28rpx;
}
