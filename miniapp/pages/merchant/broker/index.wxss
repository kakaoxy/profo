@import "../../../styles/merchant-theme.wxss";

/* 经纪人中心页布局。基础件（标题 / 卡片 / 状态 / 按钮 / chip / 输入 / 弹层 / 图标 / 底栏）
 * 全部来自 shared 层 styles/merchant-theme.wxss（DESIGN.md M1–M7）；本文件只写本页独有的排布：
 * 头部动作行、档案说明段、卡内动作区、门店主字段、记录行（绑定历史与推荐记录共用）、
 * 弹层门店候选列。 */

/* 头部一行：状态 chip + 「编辑资料」文本动作（.link 自带 88rpx 热区） */
.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

/* 档案备注与邀请说明：标题区之下、门店卡之上的一段说明，底部留一档间距接卡片 */
.notes {
  margin-bottom: var(--mp-gap);
}

/* 卡内动作区：按钮与行级说明纵向堆叠，只有一种间距 */
.acts {
  display: flex;
  flex-direction: column;
  gap: var(--mp-gap);
  margin-top: var(--mp-gap);
}

/* 门店主字段（卡内首行，比键值行重一档） */
.store-name {
  font-size: var(--mp-body);
  font-weight: 500;
  line-height: 1.5;
  letter-spacing: -0.14px;
  color: var(--ink);
}

/* 记录行（绑定历史 / 推荐记录共用）：hairline 分隔，不用 fog 底做分隔线 */
.entry {
  padding: var(--mp-gap) 0;
  border-bottom: 1rpx solid var(--mp-hairline);
}
.entry:first-child {
  padding-top: 0;
}
.entry:last-child {
  padding-bottom: 0;
  border-bottom: none;
}
.entry__top {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.entry__name {
  flex: 1;
  min-width: 0;
  font-size: var(--mp-body);
  font-weight: 500;
  line-height: 1.5;
  letter-spacing: -0.14px;
  color: var(--ink);
}
/* 记录状态用文本而不是 chip：绑定 / 推荐的状态码没有 merchant-status.ts 的三档映射，
 * 在页面里手写映射会重新长出「一色多义」，所以降级为次要文字。 */
.entry__status {
  flex-shrink: 0;
  font-size: var(--mp-caption);
  font-weight: 400;
  line-height: 1.4;
  color: var(--graphite);
}

/* 推荐记录里的跟进：只用 .hint 语义，不再造一个圆角小卡 */
.entry__follows {
  margin-top: 8rpx;
}
.entry__follow + .entry__follow {
  margin-top: var(--mp-gap);
}
/* 翻页是列表的延伸，用整宽 Fog 按钮，不与卡片标题同重 */
.entry__more {
  margin-top: var(--mp-gap);
}

/* 弹层门店候选：左信息列 + 选中 check */
.option-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.option__main {
  flex: 1;
  min-width: 0;
}
