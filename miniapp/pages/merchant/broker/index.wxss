@import "../../../styles/merchant-theme.wxss";

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 80rpx;
  box-sizing: border-box;
}

.hero {
  background: var(--pure-white);
  color: var(--ink);
  box-shadow: var(--merchant-shadow);
  border-radius: var(--merchant-card-radius);
  padding: 40rpx;
  margin-bottom: 28rpx;
}
.hero__top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}
.hero__title {
  font-size: 40rpx;
  font-weight: 600;
}
.hero__sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--graphite);
}
.hero__meta {
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: var(--ash);
}
.hero__edit {
  flex-shrink: 0;
  padding: 8rpx 24rpx;
  border: 1rpx solid var(--merchant-hairline);
  border-radius: 9999rpx;
  font-size: 24rpx;
}

.card {
  background: var(--pure-white);
  border-radius: var(--merchant-card-radius);
  box-shadow: var(--merchant-shadow);
  padding: var(--merchant-card-padding);
  margin-bottom: 28rpx;
}
.card-title {
  font-size: 32rpx;
  font-weight: 600;
}
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.link {
  color: var(--rust);
  font-size: 26rpx;
}
.link-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  height: 76rpx;
  font-weight: 500;
  padding: 0 40rpx;
  border-radius: 9999rpx;
  background: transparent;
  color: var(--rust);
  font-size: 27rpx;
}

.field-label {
  margin: 24rpx 0 12rpx;
  font-size: 26rpx;
  color: var(--graphite);
}
.field-gap {
  margin-top: 28rpx;
}
.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--merchant-hairline);
  border-radius: 32rpx;
  font-size: 28rpx;
  background: var(--fog);
  box-sizing: border-box;
}
.input--flex {
  flex: 1;
}
/* REQ-IT4-06：`.btn-primary` 是 inline-flex，无 width 时按钮按内容收缩并贴在容器左侧；
   表单主操作按钮统一铺满父容器，让文字在整行内居中。 */
.submit-btn {
  display: flex;
  width: 100%;
  margin-top: 32rpx;
}

.hint {
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--graphite);
}
.hint--warn {
  color: var(--rust);
}
.empty-line {
  margin-top: 20rpx;
  color: var(--graphite);
  font-size: 26rpx;
}

.store-name {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 600;
}
.store-line {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: var(--graphite);
  line-height: 1.5;
}
.chips {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.mini-btn {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: 9999rpx;
  background: var(--fog);
  color: var(--ink);
  font-size: 27rpx;
}
.mini-btn--primary {
  background: var(--ink);
  color: var(--pure-white);
}
.mini-btn--danger {
  color: var(--rust);
}
.mini-btn--search {
  flex: none;
  padding: 0 28rpx;
  height: 88rpx;
}

.history-item,
.lead-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--fog);
}
.history-item:last-child,
.lead-item:last-child {
  border-bottom: none;
}
.history-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.history-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--graphite);
  line-height: 1.5;
}
.followup {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: var(--fog);
  border-radius: 20rpx;
}
.followup-top {
  font-size: 23rpx;
  color: var(--graphite);
}
.followup-content {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.5;
}

.state {
  padding: 120rpx 48rpx;
  text-align: center;
}
.state__title {
  font-size: 34rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}
.state__text {
  font-size: 26rpx;
  color: var(--graphite);
  line-height: 1.6;
}
.state__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 9999rpx;
  background: transparent;
  color: var(--rust);
  font-size: 28rpx;
  font-weight: 500;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(23, 25, 28, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  z-index: 20;
}
.modal {
  width: 100%;
  max-height: 86vh;
  background: var(--pure-white);
  border-radius: var(--merchant-card-radius);
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 600;
}
.search-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.store-list {
  max-height: 44vh;
}
.option {
  padding: 20rpx;
  border: 1rpx solid var(--merchant-hairline);
  border-radius: 24rpx;
  margin-bottom: 16rpx;
}
.option--active {
  border-color: var(--rust);
  background: var(--apricot-wash);
}
.option-title {
  font-size: 28rpx;
  font-weight: 500;
}
.option-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--graphite);
  line-height: 1.4;
}
.modal-actions {
  display: flex;
  gap: 16rpx;
}
