<view class="page">
  <view class="state" wx:if="{{state === 'needLogin'}}">
    <view class="state__title">请先登录</view>
    <view class="state__text">经纪人认证需要微信登录并绑定手机号</view>
    <view class="state__btn" bindtap="onGoLogin">去登录</view>
  </view>

  <view class="state" wx:elif="{{state === 'loading'}}">
    <view class="state__text">加载中...</view>
  </view>

  <view class="state" wx:elif="{{state === 'error'}}">
    <view class="state__title">加载失败</view>
    <view class="state__text">{{errorText}}</view>
    <view class="state__btn" bindtap="load">重试</view>
  </view>

  <!-- 认证 -->
  <block wx:elif="{{state === 'register'}}">
    <view class="hero">
      <view class="hero__title">经纪人认证</view>
      <view class="hero__sub">认证后可绑定门店、推荐客户并查看推荐记录</view>
    </view>

    <view class="card" wx:if="{{qrStoreName || qrReason}}">
      <view class="card-title">门店邀请</view>
      <view wx:if="{{qrStoreName}}" class="hint">扫码门店：{{qrStoreName}}，认证成功后自动绑定</view>
      <view wx:if="{{qrReason}}" class="hint hint--warn">{{qrReason}}</view>
    </view>

    <view class="card">
      <view class="field-label">姓名</view>
      <input class="input" placeholder="请输入真实姓名" value="{{regName}}" bindinput="onRegNameInput" maxlength="50" />
      <view class="field-label field-gap">手机号</view>
      <view wx:if="{{hasPhone}}" class="hint">已使用当前账号绑定手机号，认证后自动关联</view>
      <block wx:else>
        <view class="hint hint--warn">经纪人认证前必须先在「我的」页完善手机号</view>
        <view class="link-btn" bindtap="onGoProfile">去完善手机号</view>
      </block>
      <button class="btn-primary submit-btn" loading="{{saving}}" disabled="{{saving}}" bindtap="onRegister">
        提交认证
      </button>
    </view>
  </block>

  <!-- 已认证 -->
  <block wx:elif="{{state === 'profile' && broker}}">
    <view class="hero">
      <view class="hero__top">
        <view>
          <view class="hero__title">{{broker.name}}</view>
          <view class="hero__sub">{{broker.phone_masked}} · {{bindStatusText}}</view>
        </view>
        <view class="hero__edit" bindtap="onOpenEdit">编辑</view>
      </view>
      <view class="hero__meta" wx:if="{{broker.remark}}">备注：{{broker.remark}}</view>
      <view class="hero__meta" wx:if="{{broker.inviter_employee_id}}">邀请归因已记录，推荐线索将归属邀请员工</view>
    </view>

    <view class="card">
      <view class="section-head">
        <view class="card-title">我的门店</view>
        <view class="link" wx:if="{{myStore}}" bindtap="onOpenChange">换绑</view>
      </view>
      <block wx:if="{{myStore}}">
        <view class="store-name">{{myStore.store_name}}</view>
        <view class="store-line">{{myStore.company_name}}</view>
        <view class="store-line">{{myStore.district}} · {{myStore.business_circle}}</view>
        <view class="store-line">{{myStore.address}}</view>
        <view class="chips">
          <text class="chip chip-fog">{{myStore.cooperation_status_label}}</text>
          <text class="chip chip-fog">{{myStore.review_status === 'pending' ? '门店待审核' : '已转正'}}</text>
        </view>
        <view class="actions">
          <view class="mini-btn" bindtap="onOpenChange">申请换绑</view>
          <view class="mini-btn mini-btn--danger" bindtap="onOpenUnbind">申请解绑</view>
        </view>
      </block>
      <block wx:else>
        <view class="empty-line">暂无绑定门店，可作为独立经纪人使用</view>
        <view class="actions">
          <view class="mini-btn mini-btn--primary" bindtap="onOpenBind">绑定已有门店</view>
          <view class="mini-btn" bindtap="onCreateStore">创建新门店</view>
        </view>
        <view class="hint">创建门店后进入后台审核，并自动绑定为你的门店。</view>
      </block>
    </view>

    <view class="card">
      <view class="card-title">绑定历史</view>
      <view class="empty-line" wx:if="{{!bindings.length}}">暂无绑定记录</view>
      <view class="history-item" wx:for="{{bindings}}" wx:key="id">
        <view class="history-top">
          <text>{{item.store_name}}</text>
          <text class="chip chip-fog">{{item.statusText}}</text>
        </view>
        <view class="history-meta">{{item.timeText}}<text wx:if="{{item.reason}}"> · {{item.reason}}</text></view>
      </view>
    </view>

    <view class="card">
      <view class="section-head">
        <view class="card-title">我的推荐记录</view>
        <view class="link" wx:if="{{leads.length < leadsTotal}}" bindtap="onMoreLeads">加载更多</view>
      </view>
      <view class="empty-line" wx:if="{{!leads.length}}">暂无推荐记录</view>
      <view class="lead-item" wx:for="{{leads}}" wx:key="id">
        <view class="history-top">
          <text>{{item.community_name}}</text>
          <text class="chip chip-apricot">{{item.statusText}}</text>
        </view>
        <view class="history-meta" wx:if="{{item.infoText}}">{{item.infoText}}</view>
        <view class="history-meta">推荐时间：{{item.createdText}}</view>
        <view class="followup" wx:for="{{item.followUps}}" wx:for-item="fu" wx:key="id">
          <view class="followup-top">{{fu.followedText}} · {{fu.methodText}}</view>
          <view class="followup-content">{{fu.content}}</view>
        </view>
      </view>
    </view>
  </block>
</view>

<!-- 门店搜索/绑定/换绑 -->
<view class="modal-mask" wx:if="{{storePanelOpen}}">
  <view class="modal">
    <view class="modal-title">{{storeAction === 'bind' ? '绑定门店' : '换绑门店'}}</view>
    <view class="search-row">
      <input class="input input--flex" placeholder="门店名称 / 地址" value="{{storeKeyword}}" bindinput="onStoreKeywordInput" bindconfirm="searchStores" />
      <view class="mini-btn mini-btn--search" bindtap="searchStores">搜索</view>
    </view>
    <scroll-view scroll-y class="store-list">
      <view class="empty-line" wx:if="{{!storeOptions.length}}">暂无可选门店</view>
      <view
        wx:for="{{storeOptions}}"
        wx:key="id"
        class="option {{selectedStoreId === item.id ? 'option--active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onSelectStore"
      >
        <view class="option-title">{{item.store_name}}</view>
        <view class="option-sub">{{item.company_name}} · {{item.district}} · {{item.business_circle}}</view>
        <view class="option-sub">{{item.address}}</view>
      </view>
    </scroll-view>
    <input
      wx:if="{{storeAction === 'change'}}"
      class="input"
      placeholder="换绑原因（必填）"
      value="{{changeReason}}"
      bindinput="onChangeReasonInput"
    />
    <view class="modal-actions">
      <view class="mini-btn" bindtap="onCloseStorePanel">取消</view>
      <view class="mini-btn mini-btn--primary" bindtap="onSubmitStore">
        {{storeAction === 'bind' ? '确认绑定' : '提交申请'}}
      </view>
    </view>
  </view>
</view>

<!-- 解绑 -->
<view class="modal-mask" wx:if="{{unbindOpen}}">
  <view class="modal">
    <view class="modal-title">申请解绑门店</view>
    <view class="hint">解绑需运营审核，审核通过前当前绑定持续有效。</view>
    <input class="input" placeholder="解绑原因（必填）" value="{{unbindReason}}" bindinput="onUnbindReasonInput" />
    <view class="modal-actions">
      <view class="mini-btn" bindtap="onCloseUnbind">取消</view>
      <view class="mini-btn mini-btn--primary" bindtap="onSubmitUnbind">提交申请</view>
    </view>
  </view>
</view>

<!-- 编辑资料 -->
<view class="modal-mask" wx:if="{{editOpen}}">
  <view class="modal">
    <view class="modal-title">编辑经纪人资料</view>
    <view class="field-label">姓名</view>
    <input class="input" value="{{editName}}" bindinput="onEditNameInput" maxlength="50" />
    <view class="field-label">备注</view>
    <input class="input" value="{{editRemark}}" bindinput="onEditRemarkInput" maxlength="500" />
    <view class="hint">手机号需在「我的」页通过现有流程修改后自动同步。</view>
    <view class="modal-actions">
      <view class="mini-btn" bindtap="onCloseEdit">取消</view>
      <view class="mini-btn mini-btn--primary" bindtap="onSaveProfile">保存</view>
    </view>
  </view>
</view>
