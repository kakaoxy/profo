@import "../../../../styles/merchant-theme.wxss";

/* 经纪人建店页独有布局。标题/卡片/表单/按钮/弹层/状态/底栏全部来自 shared 层
 * styles/merchant-theme.wxss；本文件只写本页独有的排布（公司结果列表、已选提示、
 * 查重行）。 */

/* 公司搜索结果：与搜索行留一档间距（shared 层只给了单个选项本身） */
.company-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: var(--mp-gap);
}
/* REQ-IT7-07：搜索状态行（加载中 / 错误 / 无结果），文字随表单次要信息层级 */
.company-status {
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--graphite);
}
.company-status--error {
  color: var(--rust);
}
/* 选项文字块可收缩，避免长公司名把图标挤出卡片 */
.company-opt {
  flex: 1;
  min-width: 0;
}

/* 「已选择」提示与上方公司结果列表留一档间距（shared 层只在 .mbtn 后给 8rpx） */
.picked-hint {
  margin-top: 16rpx;
}

/* 查重弹层：候选行纵向排列，行间 16rpx（配合 scroll-view enable-flex） */
.dup-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.dup-info {
  flex: 1;
  min-width: 0;
}
