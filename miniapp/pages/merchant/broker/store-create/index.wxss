.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 80rpx;
  box-sizing: border-box;
}
.hero {
  background: var(--ink);
  color: #fff;
  border-radius: 40rpx;
  padding: 40rpx;
  margin-bottom: 28rpx;
}
.hero__title {
  font-size: 40rpx;
  font-weight: 600;
}
.hero__sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.72);
}
.card {
  background: var(--pure-white);
  border-radius: 40rpx;
  box-shadow: var(--shadow-sm);
  padding: 32rpx;
}
.field-label {
  margin: 24rpx 0 12rpx;
  font-size: 26rpx;
  color: var(--graphite);
}
.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--fog);
  border-radius: 24rpx;
  font-size: 28rpx;
  background: var(--fog);
  box-sizing: border-box;
}
.input--flex {
  flex: 1;
}
.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.search-row {
  display: flex;
  gap: 16rpx;
}
.option-list {
  margin-top: 16rpx;
}
.option {
  padding: 20rpx;
  border: 2rpx solid var(--fog);
  border-radius: 20rpx;
  margin-bottom: 12rpx;
  font-size: 27rpx;
}
.mini-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 32rpx;
  border-radius: 9999rpx;
  background: var(--ink);
  color: #fff;
  font-size: 27rpx;
}
.link-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  height: 72rpx;
  padding: 0 36rpx;
  border-radius: 9999rpx;
  background: var(--fog);
  color: var(--ink);
  font-size: 26rpx;
}
.hint {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--graphite);
}
.submit-btn {
  margin-top: 36rpx;
}

/* 查重弹层（与门店建档页保持一致） */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(23, 25, 28, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  z-index: 20;
}
.modal {
  width: 100%;
  max-height: 80vh;
  background: #fff;
  border-radius: 40rpx;
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 500;
}
.modal-sub {
  font-size: 26rpx;
  color: var(--graphite);
}
.modal-list {
  max-height: 40vh;
}
.dup-item {
  padding: 20rpx;
  border-radius: 24rpx;
  background: var(--fog);
  margin-bottom: 12rpx;
}
.dup-name {
  font-size: 28rpx;
  font-weight: 500;
}
.dup-address {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--graphite);
}
.dup-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--rust);
}
.modal-actions {
  display: flex;
  gap: 16rpx;
}
.modal-actions .mini-btn {
  flex: 1;
}
