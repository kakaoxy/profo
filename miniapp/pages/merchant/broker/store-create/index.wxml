<view class="page">
  <view class="hero">
    <view class="hero__title">创建门店</view>
    <view class="hero__sub">创建后进入后台审核，并自动绑定为你的门店</view>
  </view>

  <view class="card">
    <view class="field-label">所属公司</view>
    <view wx:if="{{companyName}}" class="hint">已选择：{{companyName}}</view>
    <view wx:else>
      <view class="search-row">
        <input class="input input--flex" placeholder="输入公司名称搜索" value="{{companyKeyword}}" bindinput="onCompanyKeywordInput" bindconfirm="searchCompanies" />
        <view class="mini-btn" bindtap="searchCompanies">搜索</view>
      </view>
      <view wx:if="{{companies.length}}" class="option-list">
        <view
          wx:for="{{companies}}"
          wx:key="id"
          class="option"
          data-id="{{item.id}}"
          bindtap="onPickCompany"
        >{{item.company_name}}</view>
      </view>
    </view>

    <view class="field-label">门店名称</view>
    <input class="input" placeholder="门店名称" value="{{storeName}}" data-field="storeName" bindinput="onFieldInput" maxlength="200" />

    <view class="link-btn" bindtap="onChooseLocation">选择门店位置（自动带出区域）</view>
    <view class="hint" wx:if="{{lng && lat}}">坐标：{{lng}}, {{lat}}</view>

    <view class="grid">
      <picker mode="selector" range="{{districts}}" value="{{districtIndex}}" bindchange="onSelectDistrict" disabled="{{!districts.length}}">
        <view class="input input--picker">{{district || (districts.length ? '选择区域' : '区域加载失败')}}</view>
      </picker>
      <picker wx:if="{{businessCircles.length}}" mode="selector" range="{{businessCircles}}" value="{{businessCircleIndex}}" bindchange="onSelectBusinessCircle">
        <view class="input input--picker">{{businessCircle || '选择商圈'}}</view>
      </picker>
      <input wx:else class="input" placeholder="{{district ? '该区域暂无商圈候选，可手填' : '请先选择区域'}}" value="{{businessCircle}}" data-field="businessCircle" bindinput="onFieldInput" />
    </view>

    <view class="field-label">详细地址</view>
    <input class="input" placeholder="详细地址" value="{{address}}" data-field="address" bindinput="onFieldInput" maxlength="500" />

    <view class="field-label">联系人</view>
    <input class="input" placeholder="联系人" value="{{contactName}}" data-field="contactName" bindinput="onFieldInput" maxlength="50" />
    <view class="field-label">联系电话</view>
    <input class="input" type="number" placeholder="联系电话" value="{{contactPhone}}" data-field="contactPhone" bindinput="onFieldInput" maxlength="20" />
    <view class="field-label">备注</view>
    <input class="input" placeholder="备注（可选）" value="{{remark}}" data-field="remark" bindinput="onFieldInput" maxlength="500" />

    <button class="btn-primary submit-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">提交审核</button>
  </view>

  <!-- 查重提示（REQ-M01B-002：只提示不阻断，确认新建须填理由） -->
  <view class="modal-mask" wx:if="{{duplicateOpen}}">
    <view class="modal">
      <view class="modal-title">发现疑似重复门店</view>
      <view class="modal-sub">请确认是否就是以下门店；若不是，请填写强制新建理由</view>
      <scroll-view scroll-y class="modal-list">
        <view class="dup-item" wx:for="{{duplicates}}" wx:key="id" bindtap="onOpenDuplicate">
          <view class="dup-name">{{item.store_name}}</view>
          <view class="dup-address">{{item.address}}</view>
          <view class="dup-meta">匹配：{{item.matchedText}}{{item.distance_m ? ' · 距离 ' + item.distance_m + 'm' : ''}}</view>
        </view>
      </scroll-view>
      <input class="input" placeholder="强制新建理由（选择已有门店则无需填写）" value="{{forceReason}}" bindinput="onForceReason" />
      <view class="modal-actions">
        <view class="mini-btn" bindtap="onCloseDuplicate">返回修改</view>
        <view class="mini-btn mini-btn--primary" bindtap="onForceCreate">确认新建</view>
      </view>
    </view>
  </view>
</view>
