/* 我的房源单页（Steep 设计体系：统计卡同构 projects/mine，留资列 Rust 强调） */

.page {
  --line: #f2f3f5;
  min-height: 100vh;
  background: var(--fog);
}

/* ===== 加载态 ===== */
.state-box {
  padding: 120rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.state-text {
  font-size: 28rpx;
  color: var(--graphite);
}

/* ===== 统计卡（昨日/累计两行漏斗） ===== */
.stats {
  margin: 24rpx 32rpx 0;
  background: #ffffff;
  border-radius: 28rpx;
}
.stats-row {
  display: grid;
  grid-template-columns: 84rpx repeat(4, 1fr);
  align-items: center;
  padding: 24rpx 0;
}
.stats-row + .stats-row {
  border-top: 2rpx solid var(--line);
}
/* 行标签（昨日/累计）：紧凑置灰 */
.stats-tag {
  text-align: center;
  font-size: 20rpx;
  color: var(--dove);
}
.stat {
  text-align: center;
}
.stat + .stat {
  border-left: 2rpx solid var(--line);
}
.stat-num {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}
.stat-label {
  display: block;
  font-size: 20rpx;
  color: var(--graphite);
  margin-top: 8rpx;
  line-height: 1.4;
  padding: 0 4rpx;
}
/* 留资列：Rust 暖色强调（Steep 唯一彩色强调） */
.stat--hl .stat-num {
  color: var(--rust);
}

/* ===== 房源单列表 ===== */
.list {
  padding: 20rpx 32rpx 0;
}
.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}
.s-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.s-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}
/* 分享短码：等宽字体小胶囊 */
.s-code {
  flex-shrink: 0;
  font-family: "SF Mono", Menlo, Consolas, "Courier New", monospace;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--graphite);
  background: var(--fog);
  border: 2rpx solid var(--line);
  border-radius: 10rpx;
  padding: 6rpx 16rpx;
  font-variant-numeric: tabular-nums;
}
.s-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid var(--line);
}
.s-count {
  font-size: 24rpx;
  color: var(--graphite);
  font-variant-numeric: tabular-nums;
}
.s-time {
  font-size: 22rpx;
  color: var(--dove);
}
.s-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
/* 删除入口：小号灰字，Steep 体系内不做红色强调 */
.s-del {
  font-size: 22rpx;
  color: var(--graphite);
  padding: 4rpx 8rpx;
}
.list-empty {
  text-align: center;
  font-size: 26rpx;
  color: var(--graphite);
  padding: 80rpx 0;
}

/* ===== 游客 / 空态 ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 80rpx 0;
  text-align: center;
}
.e-ill {
  position: relative;
  width: 380rpx;
  height: 304rpx;
}
/* 杏色暖光晕（Apricot Wash，替代 projects/mine 的品牌蓝光晕） */
.e-glow {
  position: absolute;
  left: 50%;
  top: 46%;
  transform: translate(-50%, -50%);
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(251, 225, 209, 0.9) 0%, rgba(251, 225, 209, 0) 68%);
}
.e-card {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 296rpx;
  height: 192rpx;
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 20rpx 52rpx rgba(23, 25, 28, 0.08);
  padding: 36rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.e-pic {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: var(--apricot-wash);
  flex-shrink: 0;
}
.e-lines {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.e-bar {
  height: 16rpx;
  border-radius: 8rpx;
  background: #eef0f4;
}
.e-bar--2 {
  background: #f1f2f6;
}
.e-badge {
  position: absolute;
  right: 16rpx;
  bottom: 8rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--rust);
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(93, 42, 26, 0.32);
}
.e-t {
  margin-top: 48rpx;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
}
.e-s {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--graphite);
  line-height: 1.7;
}
.e-btn {
  margin-top: 52rpx;
  width: 400rpx;
  height: 88rpx;
  border: none;
  border-radius: 9999rpx;
  background: var(--ink);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
  box-shadow: 0 16rpx 36rpx rgba(23, 25, 28, 0.24);
}
.e-btn::after {
  border: none;
}

/* ===== 底部固定主按钮（Ink 墨色胶囊） ===== */
.fab-bar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 24rpx;
  z-index: 90;
}
.fab-btn {
  width: 100%;
  height: 92rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 9999rpx;
  background: var(--ink);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-shadow: 0 16rpx 36rpx rgba(23, 25, 28, 0.24);
}
.fab-btn::after {
  border: none;
}

/* ===== 底部安全区（避让固定按钮） ===== */
.safe-bottom {
  height: 180rpx;
}
