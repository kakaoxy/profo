/* 房源单分享 · 客户扫码落地聚合页（视觉遵循 DESIGN.md Steep，对齐高保真屏 E） */
.page {
  min-height: 100vh;
  background: var(--fog);
}

/* ===== 状态盒（loading / 占位错误 / 网络错误 互斥渲染） ===== */
.state-box {
  padding: 360rpx 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.state-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 32rpx;
  border-radius: 50%;
  background: var(--apricot-wash);
  color: var(--rust);
  font-size: 44rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.state-text {
  font-size: 30rpx;
  color: var(--ink);
}

.state-sub {
  font-size: 24rpx;
  color: var(--graphite);
  margin-top: 12rpx;
  text-align: center;
}

.state-btn {
  margin-top: 40rpx;
}

/* ===== Hero：杏色径向光晕暖卡 ===== */
.hero {
  margin: 24rpx 32rpx 0;
  padding: 44rpx 40rpx;
  border-radius: 48rpx;
  background:
    radial-gradient(140% 160% at 10% 0%, rgba(251, 225, 209, 0.9) 0%, rgba(251, 225, 209, 0.35) 48%, rgba(255, 255, 255, 0) 82%),
    var(--pure-white);
  box-shadow: var(--shadow-sm);
}

.hero-title {
  font-family: "Songti SC", "Noto Serif SC", Georgia, serif;
  font-size: 48rpx;
  line-height: 1.25;
  color: var(--ink);
}

.hero-sub {
  font-size: 26rpx;
  color: var(--graphite);
  margin-top: 10rpx;
}

/* ===== 分享人联系卡 ===== */
.contact-card {
  margin: 24rpx 32rpx 0;
  padding: 32rpx 36rpx;
  background: var(--pure-white);
  border-radius: 48rpx;
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.contact-avatar {
  width: 88rpx;
  height: 88rpx;
  flex: none;
  border-radius: 50%;
  background: var(--apricot-wash);
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.contact-main {
  flex: 1;
  min-width: 0;
}

.contact-name {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.contact-name-text {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 「分享人」角标：Rust 底白字 pill（仅 is_referrer 时渲染） */
.contact-pill {
  flex: none;
  padding: 4rpx 18rpx;
  border-radius: 9999rpx;
  background: var(--rust);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 400;
}

.contact-sub {
  font-size: 23rpx;
  color: var(--graphite);
  margin-top: 6rpx;
}

.contact-btns {
  flex: none;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 联系卡按钮：墨色主按钮 + 杏色次按钮（flex 居中，避免 button 文字顶格） */
.btn-pri,
.btn-txt {
  margin: 0;
  padding: 0 28rpx;
  border: none;
  border-radius: 9999rpx;
  font-size: 25rpx;
  line-height: 1;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-pri {
  height: 68rpx;
  background: var(--ink);
  color: #ffffff;
}

/* 杏色填充：白卡/白底栏上轮廓可见（对齐 chip-apricot 配色） */
.btn-txt {
  height: 60rpx;
  background: var(--apricot-wash);
  color: var(--rust);
}

.btn-pri::after,
.btn-txt::after {
  border: none;
}

/* ===== 房源卡片列表 ===== */
.sheet-list {
  padding: 24rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.sheet-card {
  background: var(--pure-white);
  border-radius: 48rpx;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.sheet-cover {
  position: relative;
  width: 100%;
  height: 340rpx;
  background: var(--fog);
}

.sheet-cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 封面缺失占位底色 */
.sheet-cover-img--empty {
  background: var(--fog);
}

/* 状态角标：在售杏色 / 已售深灰 */
.sheet-flag {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 9999rpx;
  background: rgba(251, 225, 209, 0.94);
  color: var(--rust);
  font-size: 22rpx;
}

.sheet-flag--sold {
  background: rgba(23, 25, 28, 0.62);
  color: #ffffff;
}

.sheet-info {
  padding: 24rpx 28rpx 28rpx;
}

.sheet-title {
  font-size: 29rpx;
  font-weight: 500;
  line-height: 1.45;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sheet-meta {
  font-size: 25rpx;
  color: var(--graphite);
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sheet-price {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--ink);
  margin-top: 6rpx;
}

.sheet-price-unit {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--graphite);
  margin-left: 4rpx;
}

.list-empty {
  padding: 120rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--graphite);
}

/* ===== 底部固定操作栏 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 90;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--pure-white);
  border-top: 2rpx solid rgba(163, 166, 175, 0.3);
}

.bar-btn {
  flex: 1;
  height: 88rpx;
  font-size: 29rpx;
  padding: 0;
}

.list-footer-space {
  height: 200rpx;
}
