<view class="page">
  <!-- 加载态 -->
  <view wx:if="{{loading}}" class="state-box">
    <view class="state-text">加载中…</view>
  </view>

  <!-- 游客 / 空态 -->
  <view wx:elif="{{empty}}" class="empty">
    <view class="e-ill">
      <view class="e-glow"></view>
      <view class="e-card">
        <view class="e-pic"></view>
        <view class="e-lines">
          <view class="e-bar" style="width: 200rpx"></view>
          <view class="e-bar e-bar--2" style="width: 132rpx"></view>
        </view>
      </view>
      <view class="e-badge">+</view>
    </view>
    <view class="e-t">想看的房源后展示在这里</view>
    <view class="e-s">
      <view>找到心仪房源，点击「想看房」预约</view>
      <view>工作人员将会电话联系您</view>
    </view>
    <button class="e-btn" bindtap="onGoProjects">去逛房源</button>
  </view>

  <!-- 有数据：预约卡片列表 -->
  <view wx:else class="list">
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="card"
      data-id="{{item.projectId}}"
      bindtap="onCardTap"
    >
      <image wx:if="{{item.coverUrl}}" class="card-cover" src="{{item.coverUrl}}" mode="aspectFill" />
      <view wx:else class="card-cover card-cover--fallback">房</view>
      <view class="card-main">
        <view class="card-title-row">
          <text class="card-title">{{item.projectTitle}}</text>
          <text class="card-tag">待联系</text>
        </view>
        <view wx:if="{{item.communityName}}" class="card-community">{{item.communityName}}</view>
        <view wx:if="{{item.layout || item.priceText}}" class="card-desc">
          <text wx:if="{{item.layout}}">{{item.layout}} · </text><text class="card-price">{{item.priceText}}</text>
        </view>
        <view class="card-time">于 {{item.timeText}}想看</view>
      </view>
    </view>

    <view wx:if="{{loadingMore}}" class="more">加载中…</view>
    <view wx:elif="{{!noMore && items.length > 0}}" class="more">上拉加载更多</view>
    <view wx:elif="{{items.length > 0}}" class="more">没有更多了</view>
  </view>

  <view class="safe-bottom"></view>
</view>
