<view class="page">
  <!-- 未登录 / 令牌失效 -->
  <view class="state" wx:if="{{state === 'needLogin'}}">
    <view class="state__title">登录已失效</view>
    <view class="state__text">请重新登录后查看带看记录</view>
    <view class="state__btn" bindtap="onGoLogin">返回重新登录</view>
  </view>

  <!-- 无权限查看 -->
  <view class="state" wx:elif="{{state === 'noPermission'}}">
    <view class="state__title">无权限查看</view>
    <view class="state__text">当前账号无权查看项目销售记录</view>
  </view>

  <!-- 加载失败 -->
  <view class="state" wx:elif="{{state === 'error'}}">
    <view class="state__title">加载失败</view>
    <view class="state__text">网络异常，请重试</view>
    <view class="state__btn" bindtap="onRetry">重试</view>
  </view>

  <!-- 加载中 -->
  <view class="state" wx:elif="{{state === 'loading'}}">
    <view class="state__text">加载中...</view>
  </view>

  <!-- 空态 -->
  <view class="state" wx:elif="{{state === 'empty'}}">
    <view class="state__text">暂未负责在售项目</view>
  </view>

  <!-- 项目列表 -->
  <block wx:elif="{{state === 'items'}}">
    <!-- 指标 Hero 区（设计稿 docs/2026-10-10：三指标 + 周期新增 +N · +0 同橙；summary 失败整卡隐藏） -->
    <view class="kpi-hero" wx:if="{{summary}}">
      <view class="kpi-mask" wx:if="{{summaryPopOpen}}" catchtap="onToggleSummaryPop"></view>
      <view class="kpi-info {{summaryPopOpen ? 'kpi-info--open' : ''}}" catchtap="onToggleSummaryPop">i</view>
      <view class="kpi-pop {{summaryPopOpen ? 'kpi-pop--show' : ''}}" wx:if="{{summaryPopOpen}}">
        <view class="kpi-pop__title">指标与统计周期说明</view>
        <view class="kpi-pop__desc">
          <text class="kpi-pop__em">带看</text>＝带看记录数 · <text class="kpi-pop__em">出价</text>＝出价记录数 ·
          <text class="kpi-pop__em">面谈</text>＝面谈记录数。增量 +N 为本周期内新增量，每周二 00:00 重置。
        </view>
        <view class="kpi-pop__range">当前周期 {{summary.periodText}}</view>
      </view>
      <view class="kpi-row">
        <view class="kpi-cell">
          <view class="kpi-label-line">
            <text class="kpi-label">带看</text>
            <text class="kpi-delta">{{summary.viewingDeltaText}}</text>
          </view>
          <view class="kpi-num">{{summary.viewingCount}}</view>
        </view>
        <view class="kpi-cell">
          <view class="kpi-label-line">
            <text class="kpi-label">出价</text>
            <text class="kpi-delta">{{summary.offerDeltaText}}</text>
          </view>
          <view class="kpi-num">{{summary.offerCount}}</view>
        </view>
        <view class="kpi-cell">
          <view class="kpi-label-line">
            <text class="kpi-label">面谈</text>
            <text class="kpi-delta">{{summary.negotiationDeltaText}}</text>
          </view>
          <view class="kpi-num">{{summary.negotiationCount}}</view>
        </view>
      </view>
      <view class="kpi-foot">
        <text class="kpi-foot__note">统计范围与下方列表一致</text>
        <text class="kpi-foot__link" catchtap="onSalesRecords">带看记录</text>
      </view>
    </view>
    <view class="list-title">带看记录 · 我负责的项目</view>
    <view
      class="project-card"
      wx:for="{{items}}"
      wx:key="id"
      bindtap="onItemTap"
      data-id="{{item.id}}"
      data-name="{{item.name}}"
    >
      <view class="card-header">
        <view class="card-name">{{item.name}}</view>
        <view class="offer-info">
          <view
            class="offer-info__max {{item.hasOffer ? 'offer-info__max--on' : ''}}"
          >最高出价：{{item.maxOfferText}}</view>
          <view class="offer-info__time" wx:if="{{item.offerTimeText}}">出价时间：{{item.offerTimeText}}</view>
        </view>
      </view>
      <view class="card-counts">
        <view class="count-item">
          <view class="count-num">{{item.viewingCount}}</view>
          <view class="count-label">带看</view>
          <text class="count-delta">+{{item.viewingDelta}}</text>
        </view>
        <view class="count-item">
          <view class="count-num">{{item.offerCount}}</view>
          <view class="count-label">出价</view>
          <text class="count-delta">+{{item.offerDelta}}</text>
        </view>
        <view class="count-item">
          <view class="count-num">{{item.negotiationCount}}</view>
          <view class="count-label">面谈</view>
          <text class="count-delta">+{{item.negotiationDelta}}</text>
        </view>
        <view class="chevron">›</view>
      </view>
    </view>
    <!-- 触底加载 / 没有更多 -->
    <view class="list-footer" wx:if="{{loadingMore}}">加载中...</view>
    <view class="list-footer" wx:elif="{{!hasMore && items.length > 0}}">没有更多了</view>
  </block>

  <!-- 底部留白 -->
  <view style="height: 120rpx;"></view>
</view>