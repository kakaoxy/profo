/* 带看记录明细页（设计稿 ARTBOARD 03）· warm 风格，行卡/chip 类为本页定义 */
.page {
  min-height: 100vh;
  background: var(--fog);
  padding-bottom: 40rpx;
}

/* ===== 类型筛选 chips（兼图例，对齐设计稿 m-filter-row） ===== */
.filter-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 24rpx 40rpx 20rpx;
  flex-wrap: wrap;
}
.fchip {
  padding: 12rpx 24rpx;
  border-radius: 9999rpx;
  font-size: 22rpx;
  font-weight: 500;
  background: var(--pure-white);
  border: 2rpx solid #e6e8ec;
  color: var(--graphite);
  line-height: 1;
}
.fchip--on {
  background: var(--ink);
  border-color: var(--ink);
  color: var(--pure-white);
}

/* ===== 记录行卡片（radius 32rpx · padding 26/30rpx，设计稿 ROW ANATOMY） ===== */
.rec-card {
  margin: 0 40rpx 20rpx;
  background: var(--pure-white);
  border: 2rpx solid #ece7de;
  border-radius: 32rpx;
  padding: 26rpx 30rpx 24rpx;
  box-shadow: var(--shadow-sm);
}
.rec-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
/* 类型 chip：带看 Sky 蓝 / 出价 Apricot 橙 / 面谈 Gray（复用既有色板，无新色） */
.rec-chip {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
  padding: 8rpx 16rpx;
  border-radius: 9999rpx;
}
.rec-chip--viewing {
  background: var(--sky-wash);
  color: #2c4d7f;
}
.rec-chip--offer {
  background: var(--apricot-wash);
  color: var(--rust);
}
.rec-chip--nego {
  background: #eef0f3;
  color: #6b6e76;
}
/* 日期：右上角 mono 20rpx Dove（与卡片「出价时间」同为 YYYY-MM-DD） */
.rec-date {
  font-size: 20rpx;
  color: var(--dove);
  letter-spacing: 0.02em;
  font-feature-settings: "tnum";
}
.rec-text {
  font-size: 26rpx;
  color: var(--ash);
  line-height: 1.6;
  margin-top: 14rpx;
  overflow-wrap: break-word;
}
/* 出价记录追加金额行：Rust 600；带看/面谈无金额行 */
.rec-price {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--rust);
  margin-top: 8rpx;
  font-feature-settings: "tnum";
}

/* ===== 触底加载提示 ===== */
.list-footer {
  padding: 24rpx 0 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--graphite);
}

/* ===== 状态分支（对齐列表页） ===== */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 120rpx 40rpx;
}
.state__title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--ink);
}
.state__text {
  font-size: 26rpx;
  color: var(--graphite);
  text-align: center;
}
.state__btn {
  margin-top: 20rpx;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: var(--ink);
  color: var(--pure-white);
  font-size: 28rpx;
  font-weight: 500;
}
