/* 绑定已有账号页 · 对齐 login 体系风格（Steep 设计系统） */
page {
  height: 100%;
}
.page {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 48rpx 80rpx;
}

/* ===== 标题区 ===== */
.header {
  width: 100%;
  max-width: 640rpx;
  margin-bottom: 40rpx;
}
.header-title {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--ink);
}
.header-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--graphite);
  line-height: 1.5;
}

/* ===== Tab 切换 ===== */
.tabs {
  display: flex;
  width: 100%;
  max-width: 640rpx;
  background: var(--pure-white);
  border: 2rpx solid #ece7de;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 32rpx;
  box-sizing: border-box;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--graphite);
  border-radius: 999rpx;
  transition: background 0.2s, color 0.2s;
}
.tab--active {
  background: var(--ink);
  color: var(--pure-white);
  font-weight: 500;
}

/* ===== 表单卡片 ===== */
.form-card {
  width: 100%;
  max-width: 640rpx;
  background: var(--pure-white);
  border: 2rpx solid #ece7de;
  border-radius: 40rpx;
  padding: 48rpx 40rpx;
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
}
.field {
  margin-bottom: 24rpx;
}
.form-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ash);
  margin-bottom: 16rpx;
}
.input {
  width: 100%;
  height: 104rpx;
  padding: 0 32rpx;
  border: 2rpx solid var(--dove);
  border-radius: 32rpx;
  font-size: 30rpx;
  background: var(--pure-white);
  color: var(--ink);
  box-sizing: border-box;
}

/* ===== 短信验证码行 ===== */
.sms-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.sms-input {
  flex: 1;
  min-width: 0;
}
.sms-btn {
  flex-shrink: 0;
  margin: 0;
  padding: 0 28rpx;
  height: 104rpx;
  line-height: 1;
  background: var(--fog);
  color: var(--graphite);
  font-size: 26rpx;
  border: 2rpx solid #ece7de;
  border-radius: 32rpx;
}
.sms-btn::after {
  border: none;
}

/* ===== 提交按钮 ===== */
.submit-btn {
  display: flex;
  width: 400rpx;
  margin: 12rpx auto 0;
}
.submit-btn--disabled {
  opacity: 0.5;
}

/* ===== 提示文案 ===== */
.hint {
  margin-top: 28rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--graphite);
  line-height: 1.5;
}

/* ===== 即将上线提示（外部用户 Tab） ===== */
.coming-soon {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 28rpx;
  background: var(--apricot-wash);
  border-radius: 24rpx;
}
.coming-soon-tag {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  background: var(--rust);
  color: var(--pure-white);
  font-size: 22rpx;
  font-weight: 500;
  border-radius: 999rpx;
}
.coming-soon-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--rust);
  line-height: 1.5;
}
