# ==========================================
# Profo Docker 部署环境变量模板
# ==========================================
# 复制为 .env 并填入真实值：cp .env.docker.example .env
# 注意：.env 严禁提交到 Git
# ==========================================

# ==================== PostgreSQL 数据库 ====================
# 数据库用户名（建议改为非默认值，增加安全性）
POSTGRES_USER=profo

# 数据库密码（生产环境务必使用强密码，仅含字母数字，避免 # @ : / 等 URL 保留字符）
# 生成强密码：openssl rand -base64 24 | tr -d '/+=' | head -c 24
POSTGRES_PASSWORD=请替换为强密码

# 数据库名
POSTGRES_DB=profo

# DATABASE_URL 由 docker-compose.yml 自动拼接为 postgresql+psycopg://USER:PASS@db:5432/DB
# 此处保留占位，会被 compose 的 environment 覆盖
DATABASE_URL=postgresql+psycopg://profo:CHANGE_ME@db:5432/profo

# ===== Redis 配置 =====
# Redis 密码（生产环境务必使用强密码，仅含字母数字，避免 URL 保留字符）
# 生成强密码：openssl rand -base64 24 | tr -d '/+=' | head -c 24
# docker-compose.yml 会自动将此值注入 redis-server --requirepass 与 backend 的 REDIS_URL
REDIS_PASSWORD=请替换为强密码
# REDIS_URL 由 docker-compose.yml 自动拼接为 redis://:PASSWORD@redis:6379/0
# 此处保留占位，会被 compose 的 environment 覆盖
REDIS_URL=redis://redis:6379/0

# ===== 存储后端配置 =====
# 存储后端：local=本地文件系统，oss=阿里云OSS
STORAGE_BACKEND=local
# 当 STORAGE_BACKEND=oss 时以下配置必填
# OSS AccessKey ID（建议使用 RAM 子账号，仅授予 OSS 读写权限）
OSS_ACCESS_KEY_ID=
# OSS AccessKey Secret
OSS_ACCESS_KEY_SECRET=
# OSS Bucket 名称
OSS_BUCKET_NAME=
# OSS Endpoint（ECS 同地域用内网 endpoint，如 oss-cn-shanghai-internal.aliyuncs.com，免流量费）
OSS_ENDPOINT=
# OSS 公网/CDN 访问基址（无尾斜杠，如 https://cdn.example.com 或 https://bucket.oss-cn-shanghai.aliyuncs.com）
OSS_PUBLIC_BASE_URL=

# ==================== JWT 配置 ====================
# JWT 签名密钥（必填，强随机）生成命令：openssl rand -hex 32
JWT_SECRET_KEY=请替换为openssl生成的64位hex密钥

# 访问令牌过期时间（分钟），默认 30
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# 刷新令牌过期时间（天），默认 7
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# JWT 密钥轮换（默认关闭，需要时再启用）
JWT_KEY_ROTATION_ENABLED=false
# JWT_SECRET_KEY_OLD=旧密钥（轮换过渡期使用）

# ==================== 敏感字段加密密钥 ====================
# Fernet 对称加密密钥（用于加密身份证/手机号/会话密钥等敏感字段）
# 必填，生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 注意：此密钥一旦生成不可更改，否则已加密数据将无法解密
ENCRYPTION_KEY=请替换为Fernet生成的密钥

# ==================== 微信配置 ====================
# 即使不使用微信登录，也必须填占位符（settings 强制要求）
WECHAT_APPID=YOUR_WECHAT_APPID_OR_PLACEHOLDER
WECHAT_SECRET=YOUR_WECHAT_SECRET_OR_PLACEHOLDER

# 微信回调地址（生产环境改为实际域名）
# WECHAT_REDIRECT_URI=https://fangmengchina.com/api/auth/wechat/callback

# 估价授权价变更订阅消息模板 ID（模板编号 10833 · 评估结果通知；授权评估价/调整评估价时推送客户；留空 = 功能关闭）
WECHAT_VALUATION_PRICE_TEMPLATE_ID=YOUR_VALUATION_PRICE_TEMPLATE_ID_OR_PLACEHOLDER

# ==================== 前端 URL ====================
# 用于微信回调重定向等场景
FRONTEND_URL=https://fangmengchina.com

# ==================== CORS 跨域 ====================
# 同域部署（前后端共用域名）留空即可，由 nginx 处理
# 跨域部署填：https://example.com,https://www.example.com
CORS_ORIGINS=[]

# ==================== 可信代理（限流 IP 解析）====================
# 仅这些来源的 X-Forwarded-For 头会被采信，防止伪造 XFF 绕过限流
# docker-compose 部署下，宿主机 nginx → 127.0.0.1:8000 → docker-proxy → 容器
# 容器内 request.client.host 看到 Docker 网关 IP（如 172.18.0.1），不在默认 127.0.0.1 中
# 需补充网段，否则所有请求共享网关 IP 对应的限流桶
# 服务器 nginx 还需配置：proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for
# list 类型环境变量需用 JSON 数组格式（与 CORS_ORIGINS 一致）
TRUSTED_PROXIES=["127.0.0.1","::1","172.16.0.0/12"]

# ==================== 上传配置 ====================
# 上传目录（容器内路径，勿改）
UPLOAD_DIR=/app/static/uploads
# 上传大小上限（字节），默认 500MB 支持视频上传
MAX_UPLOAD_SIZE=524288000

# ==================== API 配置 ====================
API_PREFIX=/api
# 调试模式，生产环境必须为 false
DEBUG=false
